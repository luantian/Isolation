<UserControl x:Class="IsolationLeakage.App.Views.BatchUploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <UserControl.Resources>
        <!-- 自定义转换器：布尔值取反 -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ReadyRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#F0FFF0" />
        </Style>
        <Style x:Key="NeedAttentionRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="#FFF8DC" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8" LastChildFill="True">
        <!-- 顶部：操作栏 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <controls:SectionPanel Title="批量上传试验数据" StatusText="{Binding SelectedFolder, TargetNullValue='请选择文件夹', FallbackValue='请选择文件夹'}" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel Orientation="Horizontal">
                        <Button Height="36" Padding="16,0"
                                Command="{Binding SelectFolderCommand}"
                                Content="📂 选择文件夹" />

                        <Button Height="36" Padding="16,0" Margin="10,0,0,0"
                                Command="{Binding ReparseAllCommand}"
                                Content="🔄 重新解析" />

                        <Border Width="1" Background="#DDD" Margin="16,6" />

                        <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">
                            <Run Text="总计: " />
                            <Run Text="{Binding TotalCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" />
                            <Run Text=" 个" />
                            <Run Text=" | 就绪: " />
                            <Run Text="{Binding ReadyCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="Green" />
                            <Run Text=" 个" />
                            <Run Text=" | 待补充: " />
                            <Run Text="{Binding NeedAttentionCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#D2691E" />
                            <Run Text=" 个" />
                        </TextBlock>

                        <Button Height="36" Padding="24,0" Margin="20,0,0,0"
                                Command="{Binding StartUploadCommand}"
                                Content="🚀 开始上传"
                                Style="{StaticResource SuccessButton}" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </DockPanel>

        <!-- 中部：进度条 -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:SectionPanel Title="上传进度" StatusText="{Binding UploadProgress, StringFormat={}{0}%}" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <ProgressBar Height="20" Value="{Binding UploadProgress, Mode=OneWay}" Minimum="0" Maximum="100" />
                        <TextBlock Margin="0,8,0,0" Text="{Binding UploadStatus}" Foreground="{StaticResource BrushMutedText}" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </DockPanel>

        <!-- 主体：文件列表 -->
        <controls:SectionPanel Title="文件列表" StatusText="{Binding UploadStatus, TargetNullValue='等待选择文件夹'}" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <DataGrid ItemsSource="{Binding ParsedItems}"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AutoGenerateColumns="False"
                          RowHeaderWidth="30"
                          AlternatingRowBackground="#F9F9F9">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReady}" Value="True">
                                    <Setter Property="Background" Value="#F0FFF0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsReady}" Value="False">
                                    <Setter Property="Background" Value="#FFF8DC" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="状态" Width="60">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsReady}" Value="True">
                                            <Setter Property="Content">
                                                <Setter.Value>✅ 就绪</Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="Green" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsReady}" Value="False">
                                            <Setter Property="Content">
                                                <Setter.Value>⚠️ 待补充</Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="#D2691E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" MinWidth="200" />

                        <DataGridTextColumn Header="项目" Width="100">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Content" Value="{Binding MatchedProject.Name, TargetNullValue='—'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MatchedProject}" Value="{x:Null}">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="Content" Value="❓ 未匹配" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="机组" Width="100">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Content" Value="{Binding MatchedUnit.Name, TargetNullValue='—'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MatchedUnit}" Value="{x:Null}">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="Content" Value="❓ 未匹配" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="试验对象" Width="120">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Content" Value="{Binding MatchedObjectNode.Name, TargetNullValue='—'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MatchedObjectNode}" Value="{x:Null}">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="Content" Value="❓ 未匹配" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="试验时间" Width="140">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Content" Value="{Binding ParsedPackage.TestTime, StringFormat=yyyy-MM-dd HH:mm:ss, TargetNullValue='—'}" />
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="匹配方式" Width="100">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsObjectMatchedExactly}" Value="True">
                                            <Setter Property="Content" Value="🎯 精确匹配" />
                                            <Setter Property="Foreground" Value="Green" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsObjectMatchedExactly}" Value="False">
                                            <Setter Property="Content" Value="📍 路径匹配" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="备注" Width="*" MinWidth="150" Binding="{Binding ErrorMessage, TargetNullValue=''}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </DockPanel>
</UserControl>
