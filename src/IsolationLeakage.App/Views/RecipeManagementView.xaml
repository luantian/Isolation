<UserControl x:Class="IsolationLeakage.App.Views.RecipeManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：查询条件栏 -->
        <Border Grid.Row="0"
                Padding="12"
                Background="{StaticResource BrushHover}"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource BrushMutedText}"
                           Text="搜索"
                           VerticalAlignment="Center" />
                <TextBox Grid.Column="1"
                         Height="32"
                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                         VerticalContentAlignment="Center">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="2"
                        Margin="8,0,0,0"
                        Command="{Binding SearchCommand}"
                        Style="{StaticResource IndustrialButton}"
                        Height="32" Width="60"
                        Content="搜索" />

                <CheckBox Grid.Column="3"
                          Margin="18,0,0,0"
                          Content="只显示启用试验路径"
                          IsChecked="{Binding ShowOnlyEnabled}"
                          VerticalAlignment="Center"
                          Command="{Binding SearchCommand}" />

                <!-- 右侧：操作按钮 -->
                <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="导入CSV"
                            Command="{Binding ImportCsvCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Height="32" />
                    <Button Content="导出CSV"
                            Command="{Binding ExportCsvCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Height="32" />
                    <Border Width="1"
                            Height="18"
                            Background="{StaticResource BrushPanelBorder}"
                            Margin="4,0"
                            VerticalAlignment="Center" />
                    <Button Command="{Binding AddRecipeCommand}"
                            Style="{StaticResource IndustrialButton}"
                            Margin="8,0,8,0"
                            Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="White"
                                       Text="&#xE710;"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0"
                                       Foreground="White"
                                       Text="新增" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding EditRecipeCommand}"
                            Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0"
                            Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Text="&#xE70F;"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0" Text="编辑" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteRecipeCommand}"
                            Style="{StaticResource DangerButton}"
                            Height="32">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="White"
                                       Text="&#xE74D;"
                                       VerticalAlignment="Center" />
                            <TextBlock Margin="6,0,0,0"
                                       Foreground="White"
                                       Text="删除" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 试验路径列表 -->
        <controls:SectionPanel Grid.Row="2"
                               Title="试验路径管理列表"
                               StatusText="{Binding Recipes.Count, StringFormat=共 {0} 个试验路径}"
                               StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <DataGrid ItemsSource="{Binding Recipes}"
                          SelectedItem="{Binding SelectedRecipe}"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          RowHeight="40"
                          ColumnHeaderHeight="40"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          MouseDoubleClick="DataGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <!-- 序号 -->
                        <DataGridTextColumn Header="序号"
                                            Binding="{Binding SequenceNo}"
                                            Width="60"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <!-- 试验路径名称 -->
                        <DataGridTextColumn Header="试验路径名称"
                                            Binding="{Binding RecipeName}"
                                            Width="120"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <!-- 系统 -->
                        <DataGridTextColumn Header="系统"
                                            Binding="{Binding System}"
                                            Width="80"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <!-- 贯穿件直径 -->
                        <DataGridTextColumn Header="贯穿件直径(mm)"
                                            Binding="{Binding PenetrationDiameter, StringFormat={}{0:0.##}}"
                                            Width="130"
                                            ElementStyle="{StaticResource DataGridCenteredTextStyle}" />
                        <!-- 阀门编号 -->
                        <DataGridTextColumn Header="试验阀门编号"
                                            Binding="{Binding ValveNo}"
                                            Width="120"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <!-- 泄漏率设计最大值 -->
                        <DataGridTextColumn Header="泄漏率限值"
                                            Binding="{Binding LeakageLimit}"
                                            Width="100"
                                            ElementStyle="{StaticResource DataGridCenteredTextStyle}" />
                        <!-- 预充压压力P2 -->
                        <DataGridTextColumn Header="预充压P2(MPa)"
                                            Binding="{Binding PrechargePressureP2, StringFormat={}{0:0.####}}"
                                            Width="130"
                                            ElementStyle="{StaticResource DataGridCenteredTextStyle}" />
                        <!-- 创建时间 -->
                        <DataGridTextColumn Header="创建时间"
                                            Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            Width="160"
                                            ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <!-- 状态 -->
                        <DataGridTemplateColumn Header="状态" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock HorizontalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="禁用" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushMutedText}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                        <Setter Property="Text" Value="启用" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
