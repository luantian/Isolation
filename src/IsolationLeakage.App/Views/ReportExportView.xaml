<UserControl x:Class="IsolationLeakage.App.Views.ReportExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <DockPanel Margin="12" LastChildFill="True">
        <!-- 左侧：导出配置 -->
        <controls:SectionPanel Width="380" Margin="0,0,12,0" Title="导出配置" StatusText="选择范围与格式" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left">
            <controls:SectionPanel.PanelContent>
                <StackPanel>
                    <Border Width="34" Height="32" Margin="0,0,0,12" Background="{StaticResource BrushPrimary}"
                            BorderBrush="{StaticResource BrushPrimaryDark}" BorderThickness="1">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE9A4;" />
                    </Border>

                    <TextBlock FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource BrushText}"
                               Text="试验报告导出" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushMutedText}"
                               Text="导出试验记录数据，支持 Excel 和 PDF 格式，用于质量追溯、报告提交和存档备查。"
                               TextWrapping="Wrap" />

                    <Separator Margin="0,18,0,18" />

                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="导出范围" />
                    <ComboBox Margin="0,8,0,0"
                              ItemsSource="{Binding ExportScopeOptions}"
                              SelectedItem="{Binding SelectedExportScope, Mode=TwoWay}" />

                    <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="导出格式" />
                    <ComboBox Margin="0,8,0,0"
                              ItemsSource="{Binding ExportFormatOptions}"
                              SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}" />

                    <TextBlock Margin="0,14,0,0" FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="文件名" />
                    <TextBox Margin="0,8,0,0" Text="{Binding ExportFileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="自定义文件名，留空则自动生成" />

                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushMutedText}" Text="{Binding ExportPreviewText}" />

                    <Button Margin="0,18,0,0" Height="36"
                            Command="{Binding ExportReportCommand}"
                            Content="导出报告"
                            Background="{StaticResource BrushPrimary}"
                            Foreground="White"
                            BorderThickness="0" />

                    <Border Margin="0,12,0,0" Padding="10,8" Background="#F7F9FC">
                        <TextBlock Foreground="{StaticResource BrushMutedText}"
                                   Text="{Binding ExportStatusMessage}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 右侧：导出说明 + 快速导出 -->
        <StackPanel>
            <controls:SectionPanel Title="导出说明" StatusText="报告内容" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <controls:DetailRow Label="Excel 报告" Value="试验记录汇总表、统计汇总" />
                        <controls:DetailRow Label="PDF 报告" Value="单条试验记录详细信息" />
                        <controls:DetailRow Label="包含字段" Value="项目、机组、对象、时间、结果等" />
                        <controls:DetailRow Label="适用场景" Value="质量追溯、报告提交、存档备查" />
                        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource BrushMutedText}"
                                   Text="导出报告包含当前查询筛选后的试验记录，以及对应的统计分析结果。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <controls:SectionPanel Margin="0,10,0,0" Title="快速导出" StatusText="一键操作" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" Foreground="{StaticResource BrushMutedText}"
                                   Text="按预设格式快速导出当前查询结果" TextWrapping="Wrap" />
                        <UniformGrid Columns="2">
                            <Button Margin="0,0,4,0" Height="36"
                                    Command="{Binding QuickExportExcelCommand}"
                                    Content="导出 Excel"
                                    Background="#12A366"
                                    Foreground="White"
                                    BorderThickness="0" />
                            <Button Margin="4,0,0,0" Height="36"
                                    Command="{Binding QuickExportPdfCommand}"
                                    Content="导出 PDF"
                                    Background="#F97316"
                                    Foreground="White"
                                    BorderThickness="0" />
                        </UniformGrid>
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <controls:SectionPanel Margin="0,10,0,0" Title="导出说明" StatusText="提示" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource BrushMutedText}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="• Excel 导出：所有记录合并到一个工作簿" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource BrushMutedText}" TextWrapping="Wrap" Margin="0,0,0,6">
                            <Run Text="• PDF 导出：每条记录一个页面，支持批量" />
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource BrushMutedText}" TextWrapping="Wrap">
                            <Run Text="• 导出文件保存到用户指定位置" />
                        </TextBlock>
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
