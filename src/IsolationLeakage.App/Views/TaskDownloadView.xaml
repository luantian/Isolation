<UserControl x:Class="IsolationLeakage.App.Views.TaskDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:models="clr-namespace:IsolationLeakage.App.Models.Database"
             xmlns:local="clr-namespace:IsolationLeakage.App.Views">
    <UserControl.Resources>
        <local:NodeTypeToGlyphConverter x:Key="NodeTypeToGlyphConverter" />
        <local:NodeTypeToIconBrushConverter x:Key="NodeTypeToIconBrushConverter" />
    </UserControl.Resources>

    <DockPanel Margin="16" LastChildFill="True">

        <!-- ===== 顶部操作栏 ===== -->
        <Border DockPanel.Dock="Top"
                Padding="14,10"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="1">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Style="{StaticResource MutedTextBlock}" Text="项目" />
                    <ComboBox MinWidth="200"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="16,0,0,0"
                               Style="{StaticResource MutedTextBlock}"
                               Text="机组" />
                    <ComboBox MinWidth="200"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Units}"
                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                              Style="{StaticResource ScopeComboBox}" />
                    <Border Margin="16,0,0,0"
                            Padding="10,5"
                            Background="#FFF8E1"
                            BorderBrush="#FFD54F"
                            BorderThickness="1">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E65100"
                                   Text="📥 选择试验对象后添加到下载列表" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 左侧：试验对象路径选择 ===== -->
        <controls:SectionPanel Width="360"
                               Margin="0,0,14,0"
                               Title="路径对象选择"
                               StatusText="{Binding SelectedObjects.Count, StringFormat='已选 {0} 个'}"
                               StatusBrush="{StaticResource BrushPrimary}"
                               DockPanel.Dock="Left">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 路径树（带类型图标） -->
                    <TreeView Grid.Row="0"
                              ItemsSource="{Binding PathTree}"
                              SelectedItemChanged="PathTree_SelectedItemChanged"
                              Style="{StaticResource IndustrialTreeView}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type models:TestObjectPathNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Height="30" Orientation="Horizontal">
                                    <!-- 类型图标 -->
                                    <Border Width="22"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding NodeType, Converter={StaticResource NodeTypeToIconBrushConverter}}"
                                            BorderBrush="{Binding NodeType, Converter={StaticResource NodeTypeToIconBrushConverter}}"
                                            BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="White"
                                                   Text="{Binding NodeType, Converter={StaticResource NodeTypeToGlyphConverter}}" />
                                    </Border>
                                    <!-- 名称 -->
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis" />
                                    <!-- 叶子节点标记 -->
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{StaticResource BrushOk}"
                                               Text="✓"
                                               Visibility="{Binding IsLeafNode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- 添加按钮 -->
                    <Button Grid.Row="1"
                            Margin="0,10,0,0"
                            Height="36"
                            Padding="12,0"
                            Command="{Binding AddSelectedObjectCommand}"
                            Content="➕ 添加选中对象到下载列表"
                            FontSize="13" />
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- ===== 右侧：待下载列表 + 装置选择 + 历史 ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 上：待下载对象列表 -->
            <controls:SectionPanel Grid.Row="0"
                                   Title="待下载对象列表"
                                   StatusText="{Binding SelectedObjects.Count, StringFormat='已选择 {0} 个对象'}"
                                   StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <DockPanel LastChildFill="True">
                        <DataGrid ItemsSource="{Binding SelectedObjects}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  MaxHeight="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="110" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding NodeTypeText}" Width="80" />
                                <DataGridTextColumn Header="泄漏限值(L/min)" Binding="{Binding LeakageLimit, StringFormat={}{0:0.###}}" Width="100" />
                                <DataGridTextColumn Header="试验压力(MPa)" Binding="{Binding TestPressure, StringFormat={}{0:0.###}}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Width="100"
                                Height="28"
                                Margin="12,0,0,0"
                                Command="{Binding RemoveSelectedObjectCommand}"
                                Content="移除选中"
                                DockPanel.Dock="Right"
                                VerticalAlignment="Top" />
                    </DockPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- 下：装置选择和下载操作 + 历史 -->
            <DockPanel Grid.Row="2" LastChildFill="True">
                <!-- 左侧：目标装置 + 下发操作 -->
                <Border Width="380"
                        Margin="0,0,12,0"
                        DockPanel.Dock="Left">
                    <StackPanel>
                        <controls:SectionPanel Title="目标测量装置"
                                               StatusText="{Binding SelectedDeviceText}"
                                               StatusBrush="{StaticResource BrushPrimary}">
                            <controls:SectionPanel.PanelContent>
                                <StackPanel>
                                    <ComboBox ItemsSource="{Binding Devices}"
                                              DisplayMemberPath="DeviceName"
                                              SelectedItem="{Binding SelectedDevice}" />

                                    <!-- 装置信息 -->
                                    <Border Margin="0,8,0,0"
                                            Padding="10,8"
                                            Background="#F7F9FC"
                                            BorderBrush="{StaticResource BrushPanelBorder}"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <controls:DetailRow Label="编号"
                                                                LabelWidth="50"
                                                                Value="{Binding SelectedDeviceCode}" />
                                            <controls:DetailRow Label="状态"
                                                                LabelWidth="50"
                                                                Value="{Binding SelectedDeviceStatusText}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- 下发按钮 -->
                                    <Button Margin="0,12,0,0"
                                            Height="40"
                                            Command="{Binding CreateTaskCommand}"
                                            Content="📤 创建任务并下发到装置"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Background="{StaticResource BrushPrimary}"
                                            BorderThickness="0" />

                                    <!-- 任务消息 -->
                                    <Border Margin="0,10,0,0"
                                            Padding="10,8"
                                            Background="#F7F9FC"
                                            BorderBrush="{StaticResource BrushPanelBorder}"
                                            BorderThickness="1">
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="{Binding TaskMessage}"
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </controls:SectionPanel.PanelContent>
                        </controls:SectionPanel>
                    </StackPanel>
                </Border>

                <!-- 右侧：任务下载历史 -->
                <controls:SectionPanel Title="任务下载历史"
                                       StatusText="{Binding TaskHistory.Count, StringFormat='共 {0} 条'}"
                                       StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <DataGrid ItemsSource="{Binding TaskHistory}"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务ID" Binding="{Binding TaskId}" Width="180" />
                                <DataGridTextColumn Header="装置" Binding="{Binding DeviceCode}" Width="90" />
                                <DataGridTextColumn Header="对象数" Binding="{Binding ObjectCount}" Width="65" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
