<UserControl x:Class="IsolationLeakage.App.Views.TaskDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <DockPanel Margin="12" LastChildFill="True">

        <!-- ===== 顶部提示 + 添加按钮 ===== -->
        <Border DockPanel.Dock="Top" Margin="0,0,0,8"
                Padding="10,8" Background="#FFF8E1" BorderBrush="#FFD54F" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <TextBlock FontSize="12" Foreground="#E65100" VerticalAlignment="Center"
                           Text="💡 从左侧路径树中选择阀门或部件节点，然后点击下方按钮添加到下载列表"
                           DockPanel.Dock="Left" />
                <Button Margin="12,0,0,0" Height="30" Padding="14,0"
                        Command="{Binding AddSelectedObjectCommand}"
                        Content="➕ 添加选中节点"
                        Background="{StaticResource BrushPrimary}" Foreground="White"
                        BorderThickness="0" DockPanel.Dock="Right" />
            </DockPanel>
        </Border>

        <!-- ===== 主内容区 ===== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 上：待下载对象列表 -->
            <controls:SectionPanel Grid.Row="0"
                                   Title="待下载对象列表"
                                   StatusText="{Binding SelectedObjects.Count, StringFormat='已选择 {0} 个对象'}"
                                   StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <DockPanel LastChildFill="True">
                        <Button Width="80" Height="28" Margin="8,0,0,0"
                                Command="{Binding RemoveSelectedObjectCommand}"
                                Content="移除选中" DockPanel.Dock="Right"
                                VerticalAlignment="Top"
                                Background="{StaticResource BrushSecondary}" Foreground="White"
                                BorderThickness="0" />
                        <DataGrid ItemsSource="{Binding SelectedObjects}"
                                  SelectedItem="{Binding SelectedObjectForRemove, Mode=TwoWay}"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="None" HeadersVisibility="Column"
                                  MaxHeight="140">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="编码" Binding="{Binding Code}" Width="110" />
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="类型" Binding="{Binding NodeTypeText}" Width="80" />
                                <DataGridTextColumn Header="泄漏限值" Binding="{Binding LeakageLimit, StringFormat=N3, TargetNullValue='—'}" Width="90" />
                                <DataGridTextColumn Header="试验压力" Binding="{Binding TestPressure, StringFormat=N3, TargetNullValue='—'}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- 下：装置选择 + 历史 -->
            <DockPanel Grid.Row="2" LastChildFill="True">
                <!-- 左：目标装置 + 下发 -->
                <Border Width="340" Margin="0,0,12,0" DockPanel.Dock="Left">
                    <controls:SectionPanel Title="目标测量装置"
                                           StatusText="{Binding SelectedDeviceText}"
                                           StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel>
                                <ComboBox ItemsSource="{Binding Devices}"
                                          DisplayMemberPath="DeviceName"
                                          SelectedItem="{Binding SelectedDevice}"
                                          Style="{StaticResource ScopeComboBox}" />
                                <Border Margin="0,8,0,0" Padding="10,8"
                                        Background="#F7F9FC" BorderBrush="{StaticResource BrushPanelBorder}"
                                        BorderThickness="1">
                                    <StackPanel>
                                        <controls:DetailRow Label="编号" LabelWidth="50"
                                                            Value="{Binding SelectedDeviceCode}" />
                                        <controls:DetailRow Label="状态" LabelWidth="50"
                                                            Value="{Binding SelectedDeviceStatusText}" />
                                    </StackPanel>
                                </Border>
                                <Button Margin="0,12,0,0" Height="38"
                                        Command="{Binding CreateTaskCommand}"
                                        Content="📤 创建任务并下发到装置"
                                        FontSize="13" FontWeight="SemiBold"
                                        Background="{StaticResource BrushPrimary}" Foreground="White"
                                        BorderThickness="0" />
                                <Border Margin="0,8,0,0" Padding="8,6"
                                        Background="#F7F9FC" BorderBrush="{StaticResource BrushPanelBorder}"
                                        BorderThickness="1">
                                    <TextBlock FontSize="11" Foreground="{StaticResource BrushMutedText}"
                                               Text="{Binding TaskMessage}" TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Border>

                <!-- 右：任务下载历史 -->
                <controls:SectionPanel Title="任务下载历史"
                                       StatusText="{Binding TaskHistory.Count, StringFormat='共 {0} 条'}"
                                       StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <DataGrid ItemsSource="{Binding TaskHistory}"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  GridLinesVisibility="None" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务ID" Binding="{Binding TaskId}" Width="*" />
                                <DataGridTextColumn Header="装置" Binding="{Binding DeviceCode}" Width="80" />
                                <DataGridTextColumn Header="对象数" Binding="{Binding ObjectCount}" Width="55" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="60" />
                                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
