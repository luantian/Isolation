<UserControl x:Class="IsolationLeakage.App.Views.RealtimeMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="6" />
            <RowDefinition Height="1.3*" />
            <RowDefinition Height="6" />
            <RowDefinition Height="1.4*" />
        </Grid.RowDefinitions>

        <!-- 顶部：试验对象选择 + PLC 控制 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="6" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 第一行：项目/机组/对象选择 -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="180" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}" Text="项目：" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableProjects}"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                          DisplayMemberPath="Name" />

                <TextBlock Grid.Column="3" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}" Text="机组：" />
                <ComboBox Grid.Column="4"
                          ItemsSource="{Binding AvailableUnits}"
                          SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                          DisplayMemberPath="Name" />

                <TextBlock Grid.Column="6" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}" Text="试验对象：" />
                <ComboBox Grid.Column="7"
                          ItemsSource="{Binding AvailableObjects}"
                          SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName" />

                <TextBlock Grid.Column="9" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}" Text="测量装置：" />
                <ComboBox Grid.Column="10"
                          ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                          DisplayMemberPath="DeviceName" />
            </Grid>

            <!-- 第二行：PLC 连接控制 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- PLC 连接组 -->
                <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushMutedText}"
                       Text="PLC 地址：" Margin="0,0,4,0" />
            <TextBox Grid.Column="1"
                     Width="140"
                     VerticalAlignment="Center"
                     Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,8,0" />
            <Button Grid.Column="2"
                    Command="{Binding SavePlcIpCommand}"
                    Content="保存地址"
                    Style="{StaticResource SuccessButton}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="3"
                    Command="{Binding ConnectPlcCommand}"
                    Content="连接 PLC"
                    Margin="0,0,8,0" />
            <Button Grid.Column="4"
                    Command="{Binding DisconnectPlcCommand}"
                    Content="断开 PLC"
                    Style="{StaticResource DangerButton}"
                    Margin="0,0,8,0" />
            <TextBlock Grid.Column="5"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Text="{Binding ConnectionState}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <!-- 未连接：红色；已连接：绿色 -->
                        <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- 分隔线 -->
            <Border Grid.Column="6" Width="1" Background="{StaticResource BrushPanelBorder}" Margin="0,4" />

            <!-- 监视控制组 -->
            <Button Grid.Column="7"
                    Command="{Binding StartMonitoringCommand}"
                    Content="开始监视"
                    Margin="16,0,8,0" />
            <Button Grid.Column="8"
                    Command="{Binding StopMonitoringCommand}"
                    Content="停止监视"
                    Style="{StaticResource WarningButton}"
                    Margin="0,0,8,0" />
            <Button Grid.Column="9"
                    Command="{Binding ExportToCsvCommand}"
                    Content="导出CSV"
                    Style="{StaticResource SuccessButton}"
                    Margin="0,0,8,0" />
            <TextBlock Grid.Column="10"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource BrushPrimary}"
                       Text="{Binding SessionInfo}" />
            </Grid>
        </Grid>

        <!-- 实时变量列表 -->
        <controls:SectionPanel Grid.Row="2" Title="实时变量" StatusText="当前值" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                        <Button Content="添加变量" Command="{Binding AddVariableCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding RemoveVariableCommand}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,8,0" />
                        <Button Content="保存配置" Command="{Binding SaveConfigCommand}"
                                Style="{StaticResource SuccessButton}" />
                    </StackPanel>

                    <!-- 可编辑的寄存器配置表格（由 IndustrialDataGrid 自身滚动，勿再外套 ScrollViewer） -->
                    <controls:IndustrialDataGrid Grid.Row="1"
                                ItemsSource="{Binding MonitorVariables}"
                                SelectedItem="{Binding SelectedMonitorVariable}"
                                ShowPagination="False"
                                VerticalScrollBarVisibility="Auto"
                                IsReadOnly="False">
                            <controls:IndustrialDataGrid.Columns>
                                <!-- 显示/隐藏：勾选控制下方对应曲线显隐 -->
                                <DataGridCheckBoxColumn Header="显示" Binding="{Binding Channel.IsVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50" />
                                <!-- 颜色：与下方图表折线同色 -->
                                <DataGridTemplateColumn Header="颜色" Width="50" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="20" Height="6" CornerRadius="3"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding Channel.Brush}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="变量名称" Binding="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                <DataGridTextColumn Header="西门子地址" Binding="{Binding SiemensAddress, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                                <DataGridTextColumn Header="寄存器地址" Binding="{Binding RegisterAddress, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                                <DataGridTextColumn Header="数据类型" Binding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                <DataGridTextColumn Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                <DataGridTextColumn Header="最小值" Binding="{Binding MinDisplay, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="最大值" Binding="{Binding MaxDisplay, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="90" IsReadOnly="True" />
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="100" IsReadOnly="True" />
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70" IsReadOnly="True" />
                            </controls:IndustrialDataGrid.Columns>
                        </controls:IndustrialDataGrid>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 趋势曲线 -->
        <controls:SectionPanel Grid.Row="4" Title="趋势曲线" StatusText="{Binding CurveInfoText}" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.HeaderExtraContent>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="显示时长：" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource BrushMutedText}" />
                    <TextBox Width="60" Height="26" FontSize="13" VerticalAlignment="Center"
                             Text="{Binding DisplayDurationSeconds, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" />
                    <TextBlock Text=" s" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource BrushMutedText}" />
                    <Button Content="确认" Height="26" FontSize="12" Margin="10,0,0,0" Padding="12,0"
                            Command="{Binding ApplyDisplayDurationCommand}"
                            Background="{StaticResource BrushPrimary}" Foreground="White"
                            BorderThickness="0" />
                </StackPanel>
            </controls:SectionPanel.HeaderExtraContent>
            <controls:SectionPanel.PanelContent>
                <!-- 三个独立图表：压力 / 温度 / 流量，横向排列，共享同一时间轴 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 压力 -->
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="压力 (MPa)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}" Margin="2,0,0,4" />
                        <controls:TrendChart Grid.Row="1"
                                TimePoints="{Binding TimeAxisPoints}"
                                Channels="{Binding PressureChannels}"
                                YAxisTitle="压力 (MPa)" />
                    </Grid>

                    <!-- 温度 -->
                    <Grid Grid.Column="1" Margin="6,0,6,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="温度 (℃)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}" Margin="2,0,0,4" />
                        <controls:TrendChart Grid.Row="1"
                                TimePoints="{Binding TimeAxisPoints}"
                                Channels="{Binding TempChannels}"
                                YAxisTitle="温度 (℃)" />
                    </Grid>

                    <!-- 流量 -->
                    <Grid Grid.Column="2" Margin="6,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="流量 (L/min)" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}" Margin="2,0,0,4" />
                        <controls:TrendChart Grid.Row="1"
                                TimePoints="{Binding TimeAxisPoints}"
                                Channels="{Binding FlowChannels}"
                                YAxisTitle="流量 (L/min)" />
                    </Grid>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
