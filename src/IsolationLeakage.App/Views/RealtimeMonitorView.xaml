<UserControl x:Class="IsolationLeakage.App.Views.RealtimeMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- 顶部：PLC 连接控制 + 监视控制 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：PLC 连接控制 -->
            <controls:SectionPanel Title="PLC 连接"
                                   StatusText="{Binding ConnectionState}"
                                   StatusBrush="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue={StaticResource BrushDanger}}">
                <controls:SectionPanel.PanelContent>
                    <DockPanel LastChildFill="False" Margin="8">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="PLC 地址：" Margin="0,0,4,0" />
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Text="{Binding PlcIpAddress}" Margin="0,0,16,0" />
                        <Button DockPanel.Dock="Left"
                                Command="{Binding ConnectPlcCommand}"
                                Content="连接 PLC"
                                Padding="16,6"
                                Margin="0,0,8,0"
                                Background="{StaticResource BrushPrimary}"
                                Foreground="White"
                                BorderThickness="0" />
                        <Button DockPanel.Dock="Left"
                                Command="{Binding DisconnectPlcCommand}"
                                Content="断开 PLC"
                                Padding="16,6"
                                Background="{StaticResource BrushDanger}"
                                Foreground="White"
                                BorderThickness="0" />
                    </DockPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- 右侧：监视控制 -->
            <controls:SectionPanel Grid.Column="2" Width="320"
                                   Title="监视控制"
                                   StatusText="{Binding SessionInfo}"
                                   StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel Margin="8">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding StartMonitoringCommand}"
                                    Content="▶ 开始监视"
                                    Padding="16,6"
                                    Margin="0,0,8,0"
                                    Background="{StaticResource BrushOk}"
                                    Foreground="White"
                                    BorderThickness="0" />
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding StopMonitoringCommand}"
                                    Content="■ 停止监视"
                                    Padding="16,6"
                                    Background="{StaticResource BrushDanger}"
                                    Foreground="White"
                                    BorderThickness="0" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="{Binding BoundaryNote}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </Grid>

        <!-- 实时变量列表 -->
        <controls:SectionPanel Grid.Row="2" Title="实时变量" StatusText="当前值" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <DataGrid ItemsSource="{Binding Variables}" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="变量编码" Binding="{Binding VariableCode}" Width="180" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="变量名称" Binding="{Binding VariableName}" Width="140" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="通道/地址" Binding="{Binding Channel}" Width="220" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="160" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 趋势曲线 -->
        <controls:SectionPanel Grid.Row="4" Title="趋势曲线" StatusText="实时刷新" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <controls:MultiChannelLineChart Grid.Column="0"
                            Margin="0,0,12,0"
                            Background="#FAFBFD"
                            ClipToBounds="True"
                            PressurePoints="{Binding PressurePoints}"
                            FlowPoints="{Binding FlowPoints}"
                            TempPoints="{Binding TempPoints}"
                            PressureMin="{Binding PressureMin}"
                            PressureMax="{Binding PressureMax}"
                            FlowMin="{Binding FlowMin}"
                            FlowMax="{Binding FlowMax}"
                            TempMin="{Binding TempMin}"
                            TempMax="{Binding TempMax}" />

                    <!-- 图例 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                   Text="通道图例" Margin="0,0,0,10" />

                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#0758D8" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="压力 {0:F1}–{1:F1} MPa">
                                            <Binding Path="PressureMin" />
                                            <Binding Path="PressureMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#12A366" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="泄漏率 {0:F3}–{1:F3} L/min">
                                            <Binding Path="FlowMin" />
                                            <Binding Path="FlowMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#F97316" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="温度 {0:F1}–{1:F1} ℃">
                                            <Binding Path="TempMin" />
                                            <Binding Path="TempMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <Border Padding="8,6" Background="#F7F9FC" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="10">
                                    <TextBlock.Text>
                                        <Binding Path="SampleIntervalMs" StringFormat="采样周期: {0}ms" />
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="10" Margin="0,2,0,0" Text="窗口: 300 点" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="10" Margin="0,2,0,0" Text="自动刷新" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
