<UserControl x:Class="IsolationLeakage.App.Views.RealtimeMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <!-- 顶部：PLC 连接控制 + 监视控制 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左侧：PLC 连接控制 -->
            <controls:SectionPanel Title="PLC 连接"
                                   StatusText="{Binding ConnectionState}"
                                   StatusBrush="{Binding IsConnected, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue={StaticResource BrushDanger}}">
                <controls:SectionPanel.PanelContent>
                    <DockPanel LastChildFill="False" Margin="8">
                        <TextBlock DockPanel.Dock="Left"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="PLC 地址：" Margin="0,0,4,0" />
                        <TextBox DockPanel.Dock="Left"
                                 Width="160"
                                 VerticalAlignment="Center"
                                 Text="{Binding PlcIpAddress, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Left"
                                Command="{Binding SavePlcIpCommand}"
                                Content="保存地址"
                                Style="{StaticResource SuccessButton}"
                                Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Left"
                                Command="{Binding ConnectPlcCommand}"
                                Content="连接 PLC"
                                Margin="0,0,8,0" />
                        <Button DockPanel.Dock="Left"
                                Command="{Binding DisconnectPlcCommand}"
                                Content="断开 PLC"
                                Style="{StaticResource DangerButton}" />
                    </DockPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- 右侧：监视控制 -->
            <controls:SectionPanel Grid.Column="2" Width="360"
                                   Title="监视控制"
                                   StatusText="{Binding SessionInfo}"
                                   StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel Margin="8">
                        <DockPanel LastChildFill="False">
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding StartMonitoringCommand}"
                                    Content="开始监视"
                                    Margin="0,0,8,0" />
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding StopMonitoringCommand}"
                                    Content="停止监视"
                                    Style="{StaticResource WarningButton}"
                                    Margin="0,0,8,0" />
                            <Button DockPanel.Dock="Left"
                                    Command="{Binding ExportToCsvCommand}"
                                    Content="导出CSV"
                                    Style="{StaticResource SuccessButton}" />
                        </DockPanel>
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="{Binding BoundaryNote}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </Grid>

        <!-- 实时变量列表 -->
        <controls:SectionPanel Grid.Row="2" Title="实时变量" StatusText="当前值" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
                        <Button Content="添加变量" Command="{Binding AddVariableCommand}"
                                Margin="0,0,8,0" />
                        <Button Content="删除" Command="{Binding RemoveVariableCommand}"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,8,0" />
                        <Button Content="保存配置" Command="{Binding SaveConfigCommand}"
                                Style="{StaticResource SuccessButton}" />
                    </StackPanel>

                    <!-- 可编辑的寄存器配置表格 -->
                    <controls:IndustrialDataGrid Grid.Row="1"
                            ItemsSource="{Binding MonitorVariables}"
                            SelectedItem="{Binding SelectedMonitorVariable}"
                            ShowPagination="False"
                            IsReadOnly="False">
                        <controls:IndustrialDataGrid.Columns>
                            <DataGridTextColumn Header="变量名称" Binding="{Binding VariableName, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                            <DataGridTextColumn Header="寄存器地址" Binding="{Binding RegisterAddress, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                            <DataGridTextColumn Header="数据类型" Binding="{Binding DataType, UpdateSourceTrigger=PropertyChanged}" Width="90" />
                            <DataGridTextColumn Header="单位" Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                            <DataGridTextColumn Header="最小值" Binding="{Binding MinDisplay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="最大值" Binding="{Binding MaxDisplay, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="100" IsReadOnly="True" />
                            <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="120" IsReadOnly="True" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" IsReadOnly="True" />
                        </controls:IndustrialDataGrid.Columns>
                    </controls:IndustrialDataGrid>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 趋势曲线 -->
        <controls:SectionPanel Grid.Row="4" Title="趋势曲线" StatusText="{Binding CurveInfoText}" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <controls:TrendChart Grid.Column="0"
                            Mode="ThreeChannel"
                            Margin="0,0,12,0"
                            PressurePoints="{Binding PressurePoints}"
                            FlowPoints="{Binding FlowPoints}"
                            TempPoints="{Binding TempPoints}" />

                    <!-- 图例 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,10,0,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                   Text="通道图例" Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Width="18" Height="4" Fill="#0758D8" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="13" Margin="10,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="压力 {0:F1}–{1:F1} MPa">
                                            <Binding Path="PressureMin" />
                                            <Binding Path="PressureMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Width="18" Height="4" Fill="#12A366" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="13" Margin="10,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="泄漏率 {0:F3}–{1:F3} L/min">
                                            <Binding Path="FlowMin" />
                                            <Binding Path="FlowMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Rectangle Width="18" Height="4" Fill="#F97316" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}"
                                           FontSize="13" Margin="10,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="温度 {0:F1}–{1:F1} ℃">
                                            <Binding Path="TempMin" />
                                            <Binding Path="TempMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
