<UserControl x:Class="IsolationLeakage.App.Views.RealtimeMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="126" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="1.2*" />
            </Grid.ColumnDefinitions>

            <controls:SectionPanel Title="通讯状态" StatusText="PLC DLL" StatusBrush="{StaticResource BrushWarn}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <TextBlock Style="{StaticResource ValueTextBlock}" Text="{Binding ConnectionState}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="后续接入客户确认的通讯 DLL 后，由适配层读取变量表并刷新界面。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <controls:SectionPanel Grid.Column="2" Title="读取模式" StatusText="只读" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <TextBlock Style="{StaticResource ValueTextBlock}" Text="{Binding ReadMode}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="用于运行状态观察、试验过程辅助核对和异常定位。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <controls:SectionPanel Grid.Column="4" Title="业务边界" StatusText="已收口" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}"
                               Text="{Binding BoundaryNote}"
                               TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </Grid>

        <controls:SectionPanel Grid.Row="2" Title="实时变量" StatusText="当前值" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <DataGrid ItemsSource="{Binding Variables}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="变量编码" Binding="{Binding VariableCode}" Width="180" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="变量名称" Binding="{Binding VariableName}" Width="140" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="当前值" Binding="{Binding CurrentValue}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="80" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="通道/地址" Binding="{Binding Channel}" Width="220" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="160" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    </DataGrid.Columns>
                </DataGrid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
