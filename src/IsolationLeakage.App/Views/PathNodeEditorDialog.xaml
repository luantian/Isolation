<Window x:Class="IsolationLeakage.App.Views.PathNodeEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="700"
        Height="620"
        MinWidth="700"
        MinHeight="620"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushWorkspace}">
    <Border Padding="24" Background="{StaticResource BrushWorkspace}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Padding="14,12"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushPrimary}"
                               Text="{Binding DialogTitle}" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource BrushMutedText}"
                               Text="{Binding ParentHint}" />
                </StackPanel>
            </Border>

            <!-- 表单区域 -->
            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Padding="18,14"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 编号 -->
                    <TextBlock Style="{StaticResource MutedTextBlock}" Text="{Binding CodeLabel}" />
                    <TextBox Grid.Column="1"
                             FontFamily="{StaticResource FontMono}"
                             Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 名称 -->
                    <TextBlock Grid.Row="1"
                               Style="{StaticResource MutedTextBlock}"
                               Text="{Binding NameLabel}" />
                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- 类型 -->
                    <TextBlock Grid.Row="2"
                               Style="{StaticResource MutedTextBlock}"
                               Text="{Binding TypeLabel}"
                               Visibility="{Binding TypeVisibility}" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Height="30"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding SelectedType}"
                              Visibility="{Binding TypeVisibility}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0"
                                           FontFamily="{StaticResource FontMain}"
                                           FontSize="13"
                                           Text="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- 泄漏率限值 -->
                    <TextBlock Grid.Row="3"
                               Style="{StaticResource MutedTextBlock}"
                               Text="{Binding LimitLabel}"
                               Visibility="{Binding LimitVisibility}" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             FontFamily="{StaticResource FontMono}"
                             Text="{Binding LeakageLimitText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding LimitVisibility}" />

                    <!-- 试验压力 -->
                    <TextBlock Grid.Row="4"
                               Style="{StaticResource MutedTextBlock}"
                               Text="{Binding PressureLabel}"
                               Visibility="{Binding PressureVisibility}" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             FontFamily="{StaticResource FontMono}"
                             Text="{Binding TestPressureText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding PressureVisibility}" />

                    <!-- 关联试验路径（仅叶子节点显示） -->
                    <TextBlock Grid.Row="5"
                               Style="{StaticResource MutedTextBlock}"
                               Text="默认关联试验路径"
                               Visibility="{Binding RecipeVisibility}" />
                    <ComboBox Grid.Row="5"
                              Grid.Column="1"
                              Height="30"
                              FontFamily="{StaticResource FontMain}"
                              FontSize="13"
                              ItemsSource="{Binding RecipeOptions}"
                              DisplayMemberPath="RecipeName"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedRecipeId}"
                              Visibility="{Binding RecipeVisibility}">
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <MultiBinding StringFormat="编码:{0}, 气密压:{1}MPa, 精吹压:{2}MPa, 预期泄漏:{3}L/h">
                                            <Binding Path="Code" />
                                            <Binding Path="AirtightTargetPressureP1" />
                                            <Binding Path="FineBlowTargetPressureP1" />
                                            <Binding Path="NormalExpectedLeakFlow" />
                                        </MultiBinding>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                    </ComboBox>

                    <!-- 备注 -->
                    <TextBlock Grid.Row="6"
                               Margin="0,8,0,0"
                               VerticalAlignment="Top"
                               Style="{StaticResource MutedTextBlock}"
                               Text="备注" />
                    <TextBox Grid.Row="6"
                             Grid.Column="1"
                             MinHeight="80"
                             Margin="0,8,0,0"
                             Padding="8,6"
                             AcceptsReturn="True"
                             Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />

                    <!-- 错误提示 -->
                    <Border Grid.Row="7"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="#FFF5F5"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource BrushDanger}"
                                       Text="&#xE7BA;" />
                            <TextBlock Margin="8,0,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushDanger}"
                                       Text="{Binding ErrorMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="2"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="88"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"
                        Content="取消"
                        Background="{StaticResource BrushSecondary}"
                        Foreground="White"
                        BorderThickness="0" />
                <Button Width="88"
                        Click="Confirm_Click"
                        Content="确定"
                        Style="{StaticResource IndustrialButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
