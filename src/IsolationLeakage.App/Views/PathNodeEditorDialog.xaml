<Window x:Class="IsolationLeakage.App.Views.PathNodeEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="520"
        Height="430"
        MinWidth="520"
        MinHeight="430"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Border Padding="14" Background="{StaticResource BrushWorkspace}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="10,8"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" Text="{Binding DialogTitle}" />
                    <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushMutedText}" Text="{Binding ParentHint}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,10,0,0"
                    Padding="14,12"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource MutedTextBlock}" Text="{Binding CodeLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlock}" Text="{Binding NameLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NodeName, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="2" Style="{StaticResource MutedTextBlock}" Text="{Binding TypeLabel}" Visibility="{Binding TypeVisibility}" />
                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              ItemsSource="{Binding TypeOptions}"
                              SelectedItem="{Binding SelectedType}"
                              Visibility="{Binding TypeVisibility}" />

                    <TextBlock Grid.Row="3" Style="{StaticResource MutedTextBlock}" Text="{Binding LimitLabel}" Visibility="{Binding LimitVisibility}" />
                    <TextBox Grid.Row="3"
                             Grid.Column="1"
                             Text="{Binding LeakageLimitText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding LimitVisibility}" />

                    <TextBlock Grid.Row="4" Style="{StaticResource MutedTextBlock}" Text="{Binding PressureLabel}" Visibility="{Binding PressureVisibility}" />
                    <TextBox Grid.Row="4"
                             Grid.Column="1"
                             Text="{Binding TestPressureText, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding PressureVisibility}" />

                    <TextBlock Grid.Row="5" Margin="0,7,0,0" VerticalAlignment="Top" Style="{StaticResource MutedTextBlock}" Text="备注" />
                    <TextBox Grid.Row="5"
                             Grid.Column="1"
                             MinHeight="86"
                             AcceptsReturn="True"
                             Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top" />

                    <TextBlock Grid.Row="6"
                               Grid.ColumnSpan="2"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource BrushDanger}"
                               Text="{Binding ErrorMessage}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="82" Margin="0,0,8,0" Click="Cancel_Click" Content="取消" />
                <Button Width="82" Click="Confirm_Click" Content="确定" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
