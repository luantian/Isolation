<UserControl x:Class="IsolationLeakage.App.Views.SystemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:auth="clr-namespace:IsolationLeakage.App.ViewModels.Auth"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SystemManagementViewModel}">
    <UserControl.Resources>
        <!-- Tab 标题样式（图标+文字） -->
        <Style x:Key="TabHeaderStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderIconStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 加载进度条（备份/还原/导入/导出时显示） -->
        <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="True" Margin="0,0,0,4"
                     Foreground="{StaticResource BrushPrimary}" Background="Transparent">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackupRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRestoreRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExportRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsImportRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <TabControl SelectedIndex="0" Style="{StaticResource IndustrialTabControl}">
            <!-- Tab 1: 用户权限 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE7EE;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="用户权限" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:SectionPanel Grid.Row="0" Margin="0,0,0,8" Title="用户权限管理" StatusText="权限" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Foreground="{StaticResource BrushMutedText}"
                                       Text="维护用户、角色、权限控制和登录认证。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <ContentControl Grid.Row="1" Content="{Binding UserManagementPage}" />
                </Grid>
            </TabItem>

            <!-- Tab 2: 角色管理 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8D7;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="角色管理" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding RoleManagementPage}" />
            </TabItem>

            <!-- Tab 3: 菜单管理 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE712;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="菜单管理" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding MenuManagementPage}" />
            </TabItem>

            <!-- Tab 4: 操作日志 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE81C;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="操作日志" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel LastChildFill="True">

                    <!-- 顶部说明（固定） -->
                    <controls:SectionPanel DockPanel.Dock="Top"
                                           Margin="0,0,0,8"
                                           Title="操作日志查询"
                                           StatusText="审计"
                                           StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Margin="12,12,12,12"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="查询所有操作记录，支持按类型、用户、日期过滤。日志过多时可使用下方清理功能自动导出并删除旧日志。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 日志清理（固定底部） -->
                    <Border DockPanel.Dock="Bottom"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保留天数:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <TextBox Width="60" Height="30" Margin="0,0,16,0"
                                     Text="{Binding OperationLogPage.RetentionDays}" />

                            <Button Content="预览清理" Height="30"
                                    Command="{Binding OperationLogPage.PreviewCleanupCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />

                            <Button Content="执行清理" Height="30"
                                    Command="{Binding OperationLogPage.CleanupCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,0" />

                            <Button Height="30"
                                    Command="{Binding OperationLogPage.ExportCommand}"
                                    Style="{StaticResource IndustrialButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="White"
                                               Text="&#xE753;"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               Foreground="White"
                                               Text="导出当前范围" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding OperationLogPage.CleanupPreviewCount, StringFormat='可清理: {0} 条'}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushWarn}" />
                        </StackPanel>
                    </Border>

                    <!-- 分页控制（固定底部，紧贴清理区上方） -->
                    <Border DockPanel.Dock="Bottom"
                            Background="#E0F2FE"
                            BorderBrush="#0284C7"
                            BorderThickness="2"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#0369A1"
                                       Text="{Binding OperationLogPage.StatusMessage}" />

                            <controls:PaginationControl Grid.Column="1"
                                                        Height="34"
                                                        MinWidth="260"
                                                        CurrentPage="{Binding OperationLogPage.CurrentPage, Mode=TwoWay}"
                                                        TotalCount="{Binding OperationLogPage.TotalCount}"
                                                        PageSize="{Binding OperationLogPage.PageSize}"
                                                        GotoPageCommand="{Binding OperationLogPage.GotoPageCommand}" />
                        </Grid>
                    </Border>

                    <!-- 过滤条件（固定顶部，列表上方） -->
                    <Border DockPanel.Dock="Top"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="操作类型:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <ComboBox Width="120" Height="30" Margin="0,0,16,0"
                                      ItemsSource="{Binding OperationLogPage.OperationTypes}"
                                      SelectedItem="{Binding OperationLogPage.OperationTypeFilter}" />

                            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <TextBox Width="200" Height="30" Margin="0,0,16,0"
                                     Text="{Binding OperationLogPage.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="日期从:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <DatePicker Width="140" Height="30" Margin="0,0,8,0"
                                        SelectedDate="{Binding OperationLogPage.DateFrom}" />
                            <TextBlock Text="到:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <DatePicker Width="140" Height="30" Margin="0,0,16,0"
                                        SelectedDate="{Binding OperationLogPage.DateTo}" />

                            <Button Content="查询" Height="30"
                                    Command="{Binding OperationLogPage.QueryCommand}"
                                    Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />
                            <Button Content="重置" Height="30"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Border>

                    <!-- 日志列表（填充剩余空间） -->
                    <DataGrid ItemsSource="{Binding OperationLogPage.FilteredRecords}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderBrush="{StaticResource BrushPanelBorder}"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32"
                              SelectedItem="{Binding OperationLogPage.SelectedLog, Mode=TwoWay}"
                              MouseDoubleClick="OperationLogGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="操作类型" Binding="{Binding OperationType}" Width="130" />
                            <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="100" />
                            <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="操作时间" Binding="{Binding OperationTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                            <DataGridTemplateColumn Header="结果" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#991B1B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="成功">
                                                            <Setter Property="Foreground" Value="#065F46" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="操作详情" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- Tab 5: 数据备份 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE74E;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="数据备份" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部说明 -->
                    <controls:SectionPanel Grid.Row="0"
                                           Margin="0,0,0,8"
                                           Title="数据库备份与还原"
                                           StatusText="数据库"
                                           StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Margin="12,12,12,12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       FontSize="13"
                                       Text="维护定期备份、手动备份、数据库恢复。建议开启自动备份，确保数据安全。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 备份操作区 -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 操作按钮栏 -->
                            <Border Grid.Row="0"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource BrushPanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="12,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Height="32"
                                                Command="{Binding BackupCommand}"
                                                Style="{StaticResource IndustrialButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           Text="&#xE74E;"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="White"
                                                           Text="立即备份" />
                                            </StackPanel>
                                        </Button>
                                        <Button Height="32"
                                                Margin="8,0,0,0"
                                                Command="{Binding RestoreCommand}"
                                                Style="{StaticResource WarningButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           Text="&#xE777;"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="White"
                                                           Text="还原数据库" />
                                            </StackPanel>
                                        </Button>
                                        <Border Width="1"
                                                Height="18"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BrushPanelBorder}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="{Binding StatusMessage}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 状态信息卡片 -->
                            <Grid Grid.Row="1" Margin="12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 最后备份时间 -->
                                <Border Grid.Column="0"
                                        Padding="14,12"
                                        Background="{StaticResource BrushPrimaryLighter}"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                Margin="0,0,12,0"
                                                Background="{StaticResource BrushPrimaryLight}"
                                                CornerRadius="18"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       Text="&#xE823;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource BrushMutedText}"
                                                       Text="最后备份时间" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="{Binding LastBackupDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 数据库大小 -->
                                <Border Grid.Column="2"
                                        Padding="14,12"
                                        Background="{StaticResource BrushOkLight}"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                Margin="0,0,12,0"
                                                Background="#D1FAE5"
                                                CornerRadius="18"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="#065F46"
                                                       Text="&#xEE94;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource BrushMutedText}"
                                                       Text="数据库大小" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="{Binding DatabaseSizeDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 备份路径配置 -->
                    <controls:SectionPanel Grid.Row="2"
                                           Margin="0,0,0,8"
                                           Title="备份配置"
                                           StatusText="配置"
                                           StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <Grid Margin="12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 默认备份路径 -->
                                <controls:DetailRow Grid.Row="0"
                                                    Label="默认备份路径:"
                                                    LabelWidth="120"
                                                    Value="{Binding BackupDirectory}"
                                                    ValueFontFamily="{StaticResource FontMono}" />

                                <!-- 备份保留策略 -->
                                <controls:DetailRow Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Label="备份保留策略:"
                                                    LabelWidth="120"
                                                    Value="{Binding BackupRetentionPolicyDays, StringFormat='{}{0} 天'}" />

                                <!-- 自动备份状态 -->
                                <controls:DetailRow Grid.Row="2"
                                                    Margin="0,8,0,0"
                                                    Label="自动备份:"
                                                    LabelWidth="120"
                                                    Value="{Binding AutoBackupStatusText}" />

                                <!-- 分隔线 -->
                                <Separator Grid.Row="3" Margin="0,12,0,8" />

                                <!-- 自动备份配置 -->
                                <Border Grid.Row="3"
                                        Margin="0,20,0,0"
                                        Padding="12"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource BrushPanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource BrushPrimaryLighter}"
                                                CornerRadius="14"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       Text="&#xE823;" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushText}"
                                                   Text="启用自动备份" />
                                        <CheckBox Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoBackupEnabled}" />
                                        <Border Width="1"
                                                Height="16"
                                                Margin="16,0"
                                                Background="{StaticResource BrushPanelBorder}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="间隔：" />
                                        <TextBox Width="64"
                                                 Height="28"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontFamily="{StaticResource FontMono}"
                                                 Text="{Binding AutoBackupIntervalHours, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="小时" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 备份历史列表 -->
                    <controls:SectionPanel Grid.Row="3"
                                           Title="备份历史记录"
                                           StatusText="{Binding BackupHistoryList.Count, StringFormat='共 {0} 条'}"
                                           StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <Grid>
                                <DataGrid Margin="8,8,8,0"
                                          MaxHeight="200"
                                          AutoGenerateColumns="False"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding BackupHistoryList}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="3*"
                                                            Binding="{Binding FileName}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="文件名" />
                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding SizeDisplay}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="大小" />
                                        <DataGridTextColumn Width="1.5*"
                                                            Binding="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="创建时间" />
                                        <DataGridTextColumn Width="1.5*"
                                                            Binding="{Binding LastModifiedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="最后修改" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- 空数据提示 -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,20">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackupHistoryList.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="56"
                                            Height="56"
                                            Margin="0,0,0,12"
                                            Background="{StaticResource BrushPrimaryLighter}"
                                            CornerRadius="28">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="24"
                                                   Foreground="{StaticResource BrushPrimary}"
                                                   Text="&#xE74E;" />
                                    </Border>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushText}"
                                               Text="暂无备份记录" />
                                    <TextBlock Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushMutedText}"
                                               Text="点击「立即备份」或开启自动备份" />
                                </StackPanel>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 6: 同步迁移 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8BD;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="同步迁移" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 顶部说明 -->
                    <controls:SectionPanel Grid.Row="0"
                                           Margin="0,0,0,8"
                                           Title="数据导出与导入"
                                           StatusText="迁移"
                                           StatusBrush="{StaticResource BrushWarn}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Margin="12,12,12,12"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="将当前数据库导出为 SQL 脚本，用于备份或迁移到其他服务器；也可从脚本文件导入数据。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 导出导入操作区 -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,8">
                        <Border Background="#F8FAFC"
                                BorderBrush="{StaticResource BrushPanelBorder}"
                                BorderThickness="0,0,0,1"
                                CornerRadius="6,6,0,0"
                                Padding="12,10">
                            <StackPanel Orientation="Horizontal">
                                <Button Height="32"
                                        Command="{Binding ExportCommand}"
                                        Style="{StaticResource IndustrialButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   Text="&#xE753;"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Foreground="White"
                                                   Text="导出数据" />
                                    </StackPanel>
                                </Button>
                                <Button Height="32"
                                        Margin="8,0,0,0"
                                        Command="{Binding ImportCommand}"
                                        Style="{StaticResource SuccessButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Foreground="White"
                                                   Text="&#xE8B5;"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Foreground="White"
                                                   Text="导入数据" />
                                    </StackPanel>
                                </Button>
                                <Border Width="1"
                                        Height="18"
                                        Margin="12,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource BrushPanelBorder}" />
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text="{Binding StatusMessage}" />
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- 迁移说明 -->
                    <controls:SectionPanel Grid.Row="2"
                                           Margin="0,0,0,8"
                                           Title="迁移说明"
                                           StatusText="帮助"
                                           StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel Margin="12,12">

                                <!-- 数据导出说明 -->
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource BrushPrimaryLighter}"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                Margin="0,0,12,0"
                                                Background="{StaticResource BrushPrimaryLight}"
                                                CornerRadius="16"
                                                VerticalAlignment="Top">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       Text="&#xE753;" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="数据导出" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushMutedText}"
                                                       Text="将当前数据库中的数据导出为 SQL 脚本文件，可用于数据备份或迁移到其他服务器。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 数据导入说明 -->
                                <Border Margin="0,0,0,8"
                                        Padding="12"
                                        Background="{StaticResource BrushOkLight}"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                Margin="0,0,12,0"
                                                Background="#D1FAE5"
                                                CornerRadius="16"
                                                VerticalAlignment="Top">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#065F46"
                                                       Text="&#xE8B5;" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="数据导入" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource BrushMutedText}"
                                                       Text="从 SQL 脚本文件中导入数据到当前数据库，可用于恢复备份或从其他服务器迁移数据。"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 注意事项 -->
                                <Border Padding="12"
                                        Background="{StaticResource BrushWarnLight}"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="32" Height="32"
                                                Margin="0,0,12,0"
                                                Background="#FEF3C7"
                                                CornerRadius="16"
                                                VerticalAlignment="Top">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#92400E"
                                                       Text="&#xE7BA;" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#92400E"
                                                       Text="注意事项" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="12"
                                                       Foreground="#78350F"
                                                       TextWrapping="Wrap">
                                                <Run Text="•" />
                                                <Run Text=" 导入操作会覆盖现有数据，请谨慎操作" />
                                                <LineBreak />
                                                <Run Text="•" />
                                                <Run Text=" 建议在导入前先进行数据库备份" />
                                                <LineBreak />
                                                <Run Text="•" />
                                                <Run Text=" 确保导入的 SQL 脚本文件与当前数据库版本兼容" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 统计信息 -->
                    <controls:SectionPanel Grid.Row="3"
                                           Title="系统统计"
                                           StatusText="统计"
                                           StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <Grid Margin="12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 用户总数 -->
                                <Border Grid.Column="0"
                                        Padding="12"
                                        Background="{StaticResource BrushPrimaryLighter}"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <Border Width="30" Height="30"
                                                Margin="0,0,0,8"
                                                Background="{StaticResource BrushPrimaryLight}"
                                                CornerRadius="15"
                                                HorizontalAlignment="Left">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       Text="&#xE7EE;" />
                                        </Border>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="{StaticResource BrushPrimary}"
                                                   Text="{Binding TotalUsers}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="用户总数" />
                                    </StackPanel>
                                </Border>

                                <!-- 角色总数 -->
                                <Border Grid.Column="2"
                                        Padding="12"
                                        Background="#F0FDF4"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <Border Width="30" Height="30"
                                                Margin="0,0,0,8"
                                                Background="#D1FAE5"
                                                CornerRadius="15"
                                                HorizontalAlignment="Left">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#065F46"
                                                       Text="&#xE8D7;" />
                                        </Border>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="#065F46"
                                                   Text="{Binding TotalRoles}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="角色总数" />
                                    </StackPanel>
                                </Border>

                                <!-- 菜单总数 -->
                                <Border Grid.Column="4"
                                        Padding="12"
                                        Background="{StaticResource BrushWarnLight}"
                                        BorderBrush="#FDE68A"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <Border Width="30" Height="30"
                                                Margin="0,0,0,8"
                                                Background="#FEF3C7"
                                                CornerRadius="15"
                                                HorizontalAlignment="Left">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#92400E"
                                                       Text="&#xE712;" />
                                        </Border>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="#92400E"
                                                   Text="{Binding TotalMenus}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="菜单总数" />
                                    </StackPanel>
                                </Border>

                                <!-- 日志总数 -->
                                <Border Grid.Column="6"
                                        Padding="12"
                                        Background="{StaticResource BrushDangerLight}"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <Border Width="30" Height="30"
                                                Margin="0,0,0,8"
                                                Background="#FEE2E2"
                                                CornerRadius="15"
                                                HorizontalAlignment="Left">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#991B1B"
                                                       Text="&#xE81C;" />
                                        </Border>
                                        <TextBlock FontSize="20"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="#991B1B"
                                                   Text="{Binding TotalLogEntries}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="日志总数" />
                                    </StackPanel>
                                </Border>

                                <!-- 数据库大小 -->
                                <Border Grid.Column="8"
                                        Padding="12"
                                        Background="#F5F3FF"
                                        BorderBrush="#DDD6FE"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <Border Width="30" Height="30"
                                                Margin="0,0,0,8"
                                                Background="#EDE9FE"
                                                CornerRadius="15"
                                                HorizontalAlignment="Left">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="#5B21B6"
                                                       Text="&#xEE94;" />
                                        </Border>
                                        <TextBlock FontSize="16"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="#5B21B6"
                                                   Text="{Binding DatabaseSizeDisplay}" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="数据库大小" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>