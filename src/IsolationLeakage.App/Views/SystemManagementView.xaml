<UserControl x:Class="IsolationLeakage.App.Views.SystemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:auth="clr-namespace:IsolationLeakage.App.ViewModels.Auth"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SystemManagementViewModel}">
    <UserControl.Resources>
        <!-- Tab 标题样式（图标+文字） -->
        <Style x:Key="TabHeaderStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderIconStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 加载进度条（备份/还原/导入/导出时显示） -->
        <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="True" Margin="0,0,0,4"
                     Foreground="{StaticResource BrushPrimary}" Background="Transparent">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackupRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRestoreRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <TabControl SelectedIndex="0" Style="{StaticResource IndustrialTabControl}">
            <!-- Tab 1: 用户权限 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE7EE;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="用户权限" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding UserManagementPage}" />
            </TabItem>

            <!-- Tab 2: 角色管理 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8D7;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="角色管理" />
                    </StackPanel>
                </TabItem.Header>
                <ContentControl Content="{Binding RoleManagementPage}" />
            </TabItem>

            <!-- Tab 3: 操作日志 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE81C;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="操作日志" />
                    </StackPanel>
                </TabItem.Header>
                <DockPanel LastChildFill="True">

                    <!-- 日志清理（固定底部） -->
                    <Border DockPanel.Dock="Bottom"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保留天数:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <TextBox Width="60" Height="30" Margin="0,0,16,0"
                                     Text="{Binding OperationLogPage.RetentionDays, UpdateSourceTrigger=PropertyChanged}" />

                            <Button Content="预览清理" Height="30"
                                    Command="{Binding OperationLogPage.PreviewCleanupCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />

                            <Button Content="执行清理" Height="30"
                                    Command="{Binding OperationLogPage.CleanupCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,0" />

                            <Button Height="30"
                                    Command="{Binding OperationLogPage.ExportCommand}"
                                    Style="{StaticResource IndustrialButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="White"
                                               Text="&#xE753;"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               Foreground="White"
                                               Text="导出当前范围" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding OperationLogPage.CleanupPreviewCount, StringFormat='可清理: {0} 条'}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushWarn}" />

                            <TextBlock Text="{Binding OperationLogPage.StatusMessage}"
                                       VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushMutedText}" />
                        </StackPanel>
                    </Border>

                    <!-- 分页控制（固定底部，紧贴清理区上方） -->
                    <Border DockPanel.Dock="Bottom"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,8"
                            Margin="0,8,0,0">
                        <controls:PaginationControl HorizontalAlignment="Right"
                                                    Height="34"
                                                    MinWidth="260"
                                                    CurrentPage="{Binding OperationLogPage.CurrentPage, Mode=TwoWay}"
                                                    TotalCount="{Binding OperationLogPage.TotalCount}"
                                                    PageSize="{Binding OperationLogPage.PageSize}"
                                                    GotoPageCommand="{Binding OperationLogPage.GotoPageCommand}" />
                    </Border>

                    <!-- 过滤条件（固定顶部，列表上方） -->
                    <Border DockPanel.Dock="Top"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="操作类型:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <ComboBox Width="120" Height="30" Margin="0,0,16,0"
                                      ItemsSource="{Binding OperationLogPage.OperationTypes}"
                                      SelectedItem="{Binding OperationLogPage.OperationTypeFilter}" />

                            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <TextBox Width="200" Height="30" Margin="0,0,16,0"
                                     Text="{Binding OperationLogPage.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="日期从:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <DatePicker Width="140" Height="30" Margin="0,0,8,0"
                                        SelectedDate="{Binding OperationLogPage.DateFrom}" />
                            <TextBlock Text="到:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <DatePicker Width="140" Height="30" Margin="0,0,16,0"
                                        SelectedDate="{Binding OperationLogPage.DateTo}" />

                            <Button Content="查询" Height="30"
                                    Command="{Binding OperationLogPage.QueryCommand}"
                                    Style="{StaticResource IndustrialButton}" Margin="0,0,8,0" />
                            <Button Content="重置" Height="30"
                                    Command="{Binding OperationLogPage.ResetCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Border>

                    <!-- 日志列表（填充剩余空间） -->
                    <DataGrid ItemsSource="{Binding OperationLogPage.FilteredRecords}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderBrush="{StaticResource BrushPanelBorder}"
                              GridLinesVisibility="Horizontal"
                              RowHeight="32"
                              SelectedItem="{Binding OperationLogPage.SelectedLog, Mode=TwoWay}"
                              MouseDoubleClick="OperationLogGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="操作类型" Binding="{Binding OperationType}" Width="130" />
                            <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="100" />
                            <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="操作时间" Binding="{Binding OperationTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                            <DataGridTemplateColumn Header="结果" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ResultText}" Value="失败">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="操作详情" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 按钮功能说明 -->
                    <Border DockPanel.Dock="Bottom"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,10"
                            Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="功能说明" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}" Text="• " />
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}"
                                           Text="预览清理：查看将删除多少条日志（仅计数，不删除）" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}" Text="• " />
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}"
                                           Text="执行清理：先导出旧日志到 CSV，再删除指定天数之前的日志" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}" Text="• " />
                                <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}"
                                           Text="导出当前范围：将当前筛选条件的日志导出为 CSV 文件" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </TabItem>

            <!-- Tab 4: 数据备份 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE74E;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="数据备份" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 备份操作区 -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 操作按钮栏 -->
                            <Border Grid.Row="0"
                                    Background="#F8FAFC"
                                    BorderBrush="{StaticResource BrushPanelBorder}"
                                    BorderThickness="0,0,0,1"
                                    CornerRadius="6,6,0,0"
                                    Padding="12,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Height="32"
                                                Command="{Binding BackupCommand}"
                                                Style="{StaticResource IndustrialButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           Text="&#xE74E;"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="White"
                                                           Text="立即备份" />
                                            </StackPanel>
                                        </Button>
                                        <Button Height="32"
                                                Margin="8,0,0,0"
                                                Command="{Binding RestoreCommand}"
                                                Style="{StaticResource WarningButton}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           Foreground="White"
                                                           Text="&#xE777;"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0"
                                                           Foreground="White"
                                                           Text="还原数据库" />
                                            </StackPanel>
                                        </Button>
                                        <Border Width="1"
                                                Height="18"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                Background="{StaticResource BrushPanelBorder}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="{Binding StatusMessage}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <!-- 状态信息卡片 -->
                            <Grid Grid.Row="1" Margin="12,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 最后备份时间 -->
                                <Border Grid.Column="0"
                                        Padding="14,12"
                                        Background="{StaticResource BrushPrimaryLighter}"
                                        BorderBrush="#BFDBFE"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                Margin="0,0,12,0"
                                                Background="{StaticResource BrushPrimaryLight}"
                                                CornerRadius="18"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       Text="&#xE823;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource BrushMutedText}"
                                                       Text="最后备份时间" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="{Binding LastBackupDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- 数据库大小 -->
                                <Border Grid.Column="2"
                                        Padding="14,12"
                                        Background="{StaticResource BrushOkLight}"
                                        BorderBrush="#A7F3D0"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="36" Height="36"
                                                Margin="0,0,12,0"
                                                Background="#D1FAE5"
                                                CornerRadius="18"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="#065F46"
                                                       Text="&#xEE94;" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource BrushMutedText}"
                                                       Text="数据库大小" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{StaticResource BrushText}"
                                                       Text="{Binding DatabaseSizeDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- 备份路径配置 -->
                    <controls:SectionPanel Grid.Row="1"
                                           Margin="0,0,0,8"
                                           Title="备份配置"
                                           StatusText="配置"
                                           StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <Grid Margin="12,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- 默认备份路径 -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushText}"
                                               Text="默认备份路径:" />
                                    <TextBox Grid.Column="1"
                                             Margin="8,0,0,0"
                                             Height="32"
                                             VerticalContentAlignment="Center"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="13"
                                             Text="{Binding BackupDirectory, UpdateSourceTrigger=LostFocus}" />
                                    <Button Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Width="80"
                                            Height="32"
                                            Content="浏览"
                                            Command="{Binding BrowseBackupDirectoryCommand}"
                                            Style="{StaticResource SecondaryButton}" />
                                </Grid>

                                <!-- 备份保留策略 -->
                                <controls:DetailRow Grid.Row="1"
                                                    Margin="0,8,0,0"
                                                    Label="备份保留策略:"
                                                    LabelWidth="120"
                                                    Value="{Binding BackupRetentionPolicyDays, StringFormat='{}{0} 天'}" />

                                <!-- 自动备份状态 -->
                                <controls:DetailRow Grid.Row="2"
                                                    Margin="0,8,0,0"
                                                    Label="自动备份:"
                                                    LabelWidth="120"
                                                    Value="{Binding AutoBackupStatusText}" />

                                <!-- 分隔线 -->
                                <Separator Grid.Row="3" Margin="0,12,0,8" />

                                <!-- 自动备份配置 -->
                                <Border Grid.Row="3"
                                        Margin="0,20,0,0"
                                        Padding="12"
                                        Background="#F8FAFC"
                                        BorderBrush="{StaticResource BrushPanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource BrushPrimaryLighter}"
                                                CornerRadius="14"
                                                VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontFamily="Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{StaticResource BrushPrimary}"
                                                       Text="&#xE823;" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushText}"
                                                   Text="启用自动备份" />
                                        <CheckBox Margin="10,0,0,0"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding AutoBackupEnabled}" />
                                        <Border Width="1"
                                                Height="16"
                                                Margin="16,0"
                                                Background="{StaticResource BrushPanelBorder}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="间隔：" />
                                        <TextBox Width="64"
                                                 Height="28"
                                                 VerticalContentAlignment="Center"
                                                 HorizontalContentAlignment="Center"
                                                 FontFamily="{StaticResource FontMono}"
                                                 Text="{Binding AutoBackupIntervalHours, UpdateSourceTrigger=LostFocus}" />
                                        <TextBlock Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="小时" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 备份历史列表 -->
                    <controls:SectionPanel Grid.Row="2"
                                           Title="备份历史记录"
                                           StatusText="{Binding BackupHistoryList.Count, StringFormat='共 {0} 条'}"
                                           StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <Grid>
                                <DataGrid Margin="8,8,8,0"
                                          MaxHeight="200"
                                          AutoGenerateColumns="False"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding BackupHistoryList}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="3*"
                                                            Binding="{Binding FileName}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="文件名" />
                                        <DataGridTextColumn Width="*"
                                                            Binding="{Binding SizeDisplay}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="大小" />
                                        <DataGridTextColumn Width="1.5*"
                                                            Binding="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="创建时间" />
                                        <DataGridTextColumn Width="1.5*"
                                                            Binding="{Binding LastModifiedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                                                            ElementStyle="{StaticResource DataGridTextElementStyle}"
                                                            Header="最后修改" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <!-- 空数据提示 -->
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Margin="0,20">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackupHistoryList.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Border Width="56"
                                            Height="56"
                                            Margin="0,0,0,12"
                                            Background="{StaticResource BrushPrimaryLighter}"
                                            CornerRadius="28">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="24"
                                                   Foreground="{StaticResource BrushPrimary}"
                                                   Text="&#xE74E;" />
                                    </Border>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushText}"
                                               Text="暂无备份记录" />
                                    <TextBlock Margin="0,4,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushMutedText}"
                                               Text="点击「立即备份」或开启自动备份" />
                                </StackPanel>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 5: 数据库高可用 -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xEE94;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="数据库高可用" />
                    </StackPanel>
                </TabItem.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 当前状态概览 -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="🔒 数据库主从状态" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- 当前角色 -->
                                <Border Grid.Column="0"
                                        Margin="0,0,8,0"
                                        Padding="12,10"
                                        Background="{StaticResource BrushPrimaryLighter}"
                                        BorderBrush="{StaticResource BrushPrimaryLight}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="当前连接" />
                                        <TextBlock x:Name="FailoverRoleText"
                                                   Margin="0,4,0,0" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="{StaticResource BrushPrimary}"
                                                   Text="主库" />
                                    </StackPanel>
                                </Border>

                                <!-- 连接状态 -->
                                <Border Grid.Column="1"
                                        Margin="4,0,4,0"
                                        Padding="12,10"
                                        Background="{StaticResource BrushOkLight}"
                                        BorderBrush="{StaticResource BrushOk}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="连接状态" />
                                        <TextBlock x:Name="FailoverStatusText"
                                                   Margin="0,4,0,0" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="{StaticResource BrushOk}"
                                                   Text="正常" />
                                    </StackPanel>
                                </Border>

                                <!-- 故障切换 -->
                                <Border Grid.Column="2"
                                        Margin="8,0,0,0"
                                        Padding="12,10"
                                        Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushPanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <StackPanel>
                                        <TextBlock FontSize="11"
                                                   Foreground="{StaticResource BrushMutedText}"
                                                   Text="故障切换" />
                                        <TextBlock x:Name="FailoverEnabledText"
                                                   Margin="0,4,0,0" FontSize="16"
                                                   FontWeight="SemiBold"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="{StaticResource BrushText}"
                                                   Text="未启用" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="FailoverServerText"
                                       Margin="0,8,0,0"
                                       FontSize="12"
                                       FontFamily="{StaticResource FontMono}"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="服务器：.\SQLEXPRESS" />
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮 -->
                    <Border Grid.Row="1"
                            Margin="0,8,0,0"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="操作" />
                            <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                <Button Content="配置主从切换"
                                        Height="36"
                                        Click="FailoverConfig_Click"
                                        Style="{StaticResource IndustrialButton}" />
                                <Button Content="配置数据库连接"
                                        Height="36"
                                        Margin="10,0,0,0"
                                        Click="DatabaseConfig_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 说明 -->
                    <Border Grid.Row="2"
                            Margin="0,8,0,0"
                            Background="White"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="📖 功能说明" />
                            <TextBlock Margin="0,10,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       TextWrapping="Wrap"
                                       Text="数据库高可用功能提供主从自动切换能力：&#10;&#10;• 主库（Primary）：正常读写数据的数据库&#10;• 从库（Secondary）：主库故障时自动切换到的备用数据库&#10;&#10;启用后，系统每隔一段时间自动检测主库健康状态。如果主库连续多次检测失败，会自动切换到从库继续工作。主库恢复后，系统会自动切回主库。&#10;&#10;注意：从库的数据需要定期与主库同步，建议使用 SQL Server 的备份/还原功能或日志传送（需 SQL Server 标准版以上）来保持数据同步。" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>