<UserControl x:Class="IsolationLeakage.App.Views.SystemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:SystemManagementViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 加载进度条（备份/还原/导入/导出时显示） -->
        <ProgressBar Grid.Row="0" Height="3" IsIndeterminate="True" Margin="0,0,0,4"
                     Foreground="{StaticResource BrushPrimary}" Background="Transparent">
            <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackupRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsRestoreRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsExportRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsImportRunning}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ProgressBar.Style>
        </ProgressBar>
        <TabControl SelectedIndex="0">
            <!-- Tab 1: 用户权限 -->
            <TabItem Header="用户权限">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:SectionPanel Grid.Row="0" Margin="0,0,0,8" Title="用户权限管理" StatusText="权限" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Foreground="{StaticResource BrushMutedText}"
                                       Text="维护用户、角色、权限控制和登录认证。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <ContentControl Grid.Row="1" Content="{Binding UserManagementPage}" />
                </Grid>
            </TabItem>

            <!-- Tab 2: 角色管理 -->
            <TabItem Header="角色管理">
                <ContentControl Content="{Binding RoleManagementPage}" />
            </TabItem>

            <!-- Tab 3: 菜单管理 -->
            <TabItem Header="菜单管理">
                <ContentControl Content="{Binding MenuManagementPage}" />
            </TabItem>

            <!-- Tab 4: 操作日志 -->
            <TabItem Header="操作日志">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:SectionPanel Grid.Row="0" Margin="0,0,0,8" Title="操作日志查询" StatusText="审计" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Foreground="{StaticResource BrushMutedText}"
                                       Text="查询所有操作记录，支持按类型、用户、日期过滤。日志过多时可使用下方清理功能自动导出并删除旧日志。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 过滤条件 -->
                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="操作类型:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <ComboBox Width="120" Height="30" Margin="0,0,16,0"
                                      ItemsSource="{Binding OperationLogPage.OperationTypes}"
                                      SelectedItem="{Binding OperationLogPage.OperationTypeFilter}" />

                            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <TextBox Width="200" Height="30" Margin="0,0,16,0"
                                     Text="{Binding OperationLogPage.SearchText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="日期从:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <DatePicker Width="140" Height="30" Margin="0,0,8,0"
                                        SelectedDate="{Binding OperationLogPage.DateFrom}" />
                            <TextBlock Text="到:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <DatePicker Width="140" Height="30" Margin="0,0,16,0"
                                        SelectedDate="{Binding OperationLogPage.DateTo}" />

                            <Button Content="查询" Height="30"
                                    Command="{Binding OperationLogPage.QueryCommand}"
                                    Background="{StaticResource BrushPrimary}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,8,0" />
                            <Button Content="重置" Height="30"
                                    Background="{StaticResource BrushSecondary}" Foreground="White"
                                    BorderThickness="0" />
                        </StackPanel>
                    </Border>

                    <!-- 日志列表 -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding OperationLogPage.FilteredRecords}"
                              AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" IsReadOnly="True"
                              SelectionMode="Single" BorderBrush="{StaticResource BrushPanelBorder}"
                              GridLinesVisibility="Horizontal" RowHeight="32"
                              Margin="0,0,0,8"
                              SelectedItem="{Binding OperationLogPage.SelectedLog, Mode=TwoWay}"
                              MouseDoubleClick="OperationLogGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="操作类型" Binding="{Binding OperationType}" Width="130" />
                            <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="100" />
                            <DataGridTextColumn Header="IP地址" Binding="{Binding IpAddress}" Width="120" />
                            <DataGridTextColumn Header="操作时间" Binding="{Binding OperationTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="90" />
                            <DataGridTextColumn Header="操作详情" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 分页控制 -->
                    <Border Grid.Row="3" Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="上一页" Height="30"
                                    Command="{Binding OperationLogPage.PreviousPageCommand}"
                                    Background="{StaticResource BrushSecondary}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,8,0" />
                            <Button Content="下一页" Height="30"
                                    Command="{Binding OperationLogPage.NextPageCommand}"
                                    Background="{StaticResource BrushSecondary}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding OperationLogPage.StatusMessage}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                        </StackPanel>
                    </Border>

                    <!-- 日志清理 -->
                    <Border Grid.Row="4" Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1"
                            Padding="12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="保留天数:" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{StaticResource BrushMutedText}" />
                            <TextBox Width="60" Height="30" Margin="0,0,16,0"
                                     Text="{Binding OperationLogPage.RetentionDays}" />

                            <Button Content="预览清理" Height="30"
                                    Command="{Binding OperationLogPage.PreviewCleanupCommand}"
                                    Background="{StaticResource BrushSecondary}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,8,0" />

                            <Button Content="执行清理" Height="30"
                                    Command="{Binding OperationLogPage.CleanupCommand}"
                                    Background="{StaticResource BrushDanger}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,8,0" />

                            <Button Content="导出当前范围" Height="30"
                                    Command="{Binding OperationLogPage.ExportCommand}"
                                    Background="{StaticResource BrushPrimary}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,8,0" />

                            <TextBlock Text="{Binding OperationLogPage.CleanupPreviewCount, StringFormat='可清理: {0} 条'}"
                                       VerticalAlignment="Center" Margin="16,0,0,0"
                                       Foreground="{StaticResource BrushWarn}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 3: 数据备份 -->
            <TabItem Header="数据备份">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <controls:SectionPanel Grid.Row="0" Margin="0,0,0,8" Title="数据库备份与还原" StatusText="数据库" StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Foreground="{StaticResource BrushMutedText}"
                                       Text="维护定期备份、手动备份、恢复和备份恢复操作记录。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 备份操作区 -->
                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="立即备份" Height="32"
                                        Command="{Binding BackupCommand}"
                                        Background="{StaticResource BrushPrimary}" Foreground="White"
                                        BorderThickness="0" Margin="0,0,16,0" />
                                <Button Content="还原数据库" Height="32"
                                        Command="{Binding RestoreCommand}"
                                        Background="{StaticResource BrushWarn}" Foreground="White"
                                        BorderThickness="0" />
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                           Margin="16,0,0,0" Foreground="{StaticResource BrushMutedText}" />
                            </StackPanel>

                            <controls:DetailRow Label="最后备份时间:" Value="{Binding LastBackupDisplay}"
                                                LabelWidth="120" />
                            <controls:DetailRow Label="数据库大小:" Value="{Binding DatabaseSizeDisplay}"
                                                LabelWidth="120" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 备份路径配置 -->
                    <controls:SectionPanel Grid.Row="2" Margin="0,0,0,8" Title="备份配置" StatusText="配置" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel>
                                <controls:DetailRow Label="默认备份路径:" Value="{Binding BackupDirectory}"
                                                    LabelWidth="120" />
                                <controls:DetailRow Label="备份保留策略:" Value="{Binding BackupRetentionPolicyDays, StringFormat='{}{0} 天'}"
                                                    LabelWidth="120" Margin="0,8,0,0" />
                                <controls:DetailRow Label="自动备份:" Value="{Binding AutoBackupStatusText}"
                                                    LabelWidth="120" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="启用自动备份" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <CheckBox IsChecked="{Binding AutoBackupEnabled}" VerticalAlignment="Center" />
                                    <TextBlock Text="间隔(小时):" VerticalAlignment="Center" Margin="20,0,8,0" />
                                    <TextBox Width="60" Height="26" Text="{Binding AutoBackupIntervalHours, UpdateSourceTrigger=LostFocus}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 备份历史列表 -->
                    <controls:SectionPanel Grid.Row="3" Title="备份历史记录" StatusText="{Binding BackupHistoryList.Count, StringFormat='共 {0} 条'}" StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <Grid>
                                <DataGrid ItemsSource="{Binding BackupHistoryList}" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserSortColumns="True" MaxHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="3*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                        <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="最后修改" Binding="{Binding LastModifiedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                                <!-- 空数据提示 -->
                                <TextBlock Text="暂无备份记录，执行手动备份或启用自动备份后将在此显示"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{StaticResource BrushMutedText}" FontSize="13"
                                           Padding="0,30">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BackupHistoryList.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 4: 同步迁移 -->
            <TabItem Header="同步迁移">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:SectionPanel Grid.Row="0" Margin="0,0,0,8" Title="数据导出与导入" StatusText="迁移" StatusBrush="{StaticResource BrushWarn}">
                        <controls:SectionPanel.PanelContent>
                            <TextBlock Foreground="{StaticResource BrushMutedText}"
                                       Text="维护数据库同步、迁移至其他服务器和从其他服务器迁移数据。"
                                       TextWrapping="Wrap" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 导出导入操作区 -->
                    <Border Grid.Row="1" Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1"
                            Padding="12" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="导出数据" Height="32"
                                    Command="{Binding ExportCommand}"
                                    Background="{StaticResource BrushPrimary}" Foreground="White"
                                    BorderThickness="0" Margin="0,0,16,0" />
                            <Button Content="导入数据" Height="32"
                                    Command="{Binding ImportCommand}"
                                    Background="{StaticResource BrushOk}" Foreground="White"
                                    BorderThickness="0" />
                            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                                       Margin="16,0,0,0" Foreground="{StaticResource BrushMutedText}" />
                        </StackPanel>
                    </Border>

                    <!-- 迁移说明 -->
                    <controls:SectionPanel Grid.Row="2" Margin="0,0,0,8" Title="迁移说明" StatusText="帮助" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel>
                                <TextBlock Foreground="{StaticResource BrushText}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run FontWeight="Bold">数据导出：</Run>
                                    <Run>将当前数据库中的数据导出为SQL脚本文件，可用于数据备份或迁移到其他服务器。</Run>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource BrushText}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run FontWeight="Bold">数据导入：</Run>
                                    <Run>从SQL脚本文件中导入数据到当前数据库，可用于恢复备份或从其他服务器迁移数据。</Run>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource BrushText}" TextWrapping="Wrap" Margin="0,0,0,8">
                                    <Run FontWeight="Bold">注意事项：</Run>
                                    <LineBreak />
                                    <Run>- 导入操作会覆盖现有数据，请谨慎操作</Run>
                                    <LineBreak />
                                    <Run>- 建议在导入前先进行数据库备份</Run>
                                    <LineBreak />
                                    <Run>- 确保导入的SQL脚本文件与当前数据库版本兼容</Run>
                                </TextBlock>
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 统计信息 -->
                    <controls:SectionPanel Grid.Row="3" Title="系统统计" StatusText="统计" StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel>
                                <controls:DetailRow Label="用户总数:" Value="{Binding TotalUsers}"
                                                    LabelWidth="120" />
                                <controls:DetailRow Label="角色总数:" Value="{Binding TotalRoles}"
                                                    LabelWidth="120" Margin="0,8,0,0" />
                                <controls:DetailRow Label="菜单总数:" Value="{Binding TotalMenus}"
                                                    LabelWidth="120" Margin="0,8,0,0" />
                                <controls:DetailRow Label="日志总数:" Value="{Binding TotalLogEntries}"
                                                    LabelWidth="120" Margin="0,8,0,0" />
                                <controls:DetailRow Label="数据库大小:" Value="{Binding DatabaseSizeDisplay}"
                                                    LabelWidth="120" Margin="0,8,0,0" />
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
