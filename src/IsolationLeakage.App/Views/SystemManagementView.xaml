<UserControl x:Class="IsolationLeakage.App.Views.SystemManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <TabControl Margin="12">
        <TabItem Header="用户权限">
            <controls:SectionPanel Margin="12" Title="用户权限" StatusText="权限" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}"
                               Text="维护用户、角色、权限控制和登录认证。"
                               TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
        <TabItem Header="数据备份">
            <controls:SectionPanel Margin="12" Title="数据备份" StatusText="数据库" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}"
                               Text="维护定期备份、手动备份、恢复和备份恢复操作记录。"
                               TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
        <TabItem Header="同步迁移">
            <controls:SectionPanel Margin="12" Title="同步迁移" StatusText="数据库" StatusBrush="{StaticResource BrushWarn}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}"
                               Text="维护数据库同步、迁移至其他服务器和从其他服务器迁移数据。"
                               TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
        <TabItem Header="操作日志">
            <controls:SectionPanel Margin="12" Title="操作日志" StatusText="审计" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}"
                               Text="查询登录、基础数据变更、数据包导入、试验记录查看、导出、备份恢复和迁移日志。"
                               TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
    </TabControl>
</UserControl>
