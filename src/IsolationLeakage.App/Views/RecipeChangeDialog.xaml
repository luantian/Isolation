<Window x:Class="IsolationLeakage.App.Views.RecipeChangeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        Title="修改配方"
        Width="500"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushWorkspace}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 配方选择 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="当前配方："
                       Style="{StaticResource MutedTextBlock}"
                       Margin="0,0,0,8" />
            <TextBlock Text="{Binding CurrentRecipeName}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20" />

            <TextBlock Text="新配方："
                       Style="{StaticResource MutedTextBlock}"
                       Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding AvailableRecipes}"
                      SelectedItem="{Binding SelectedRecipe}"
                      DisplayMemberPath="RecipeName"
                      Height="32"
                      FontSize="14" />

            <TextBlock Text="{Binding RecordCount, StringFormat='将修改 {0} 条记录的配方'}"
                       Style="{StaticResource MutedTextBlock}"
                       Margin="0,12,0,0"
                       FontSize="12" />
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="取消"
                    Width="80"
                    Height="32"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" />
            <Button Content="确定"
                    Width="80"
                    Height="32"
                    Click="Confirm_Click"
                    Style="{StaticResource IndustrialButton}" />
        </StackPanel>
    </Grid>
</Window>
