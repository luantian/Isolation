<UserControl x:Class="IsolationLeakage.App.Views.StatisticsAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <TabControl Margin="12">
        <TabItem Header="合格率统计">
            <controls:SectionPanel Margin="12" Title="合格率统计" StatusText="统计" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}" Text="统计试验对象单次合格率和整台机组阀门合格情况。" TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
        <TabItem Header="趋势分析">
            <controls:SectionPanel Margin="12" Title="趋势分析" StatusText="曲线" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}" Text="展示单个阀门泄漏率历史趋势和不同类型阀门泄漏率曲线。" TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
        <TabItem Header="不合格追溯">
            <controls:SectionPanel Margin="12" Title="不合格追溯" StatusText="异常" StatusBrush="{StaticResource BrushWarn}">
                <controls:SectionPanel.PanelContent>
                    <TextBlock Foreground="{StaticResource BrushMutedText}" Text="汇总不合格记录，并按阀门类型形成故障类型趋势。" TextWrapping="Wrap" />
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </TabItem>
    </TabControl>
</UserControl>
