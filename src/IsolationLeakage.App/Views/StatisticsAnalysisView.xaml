<UserControl x:Class="IsolationLeakage.App.Views.StatisticsAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <UserControl.Resources>
        <!-- Bar Chart Item Style -->
        <Style x:Key="BarChartItemStyle" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <controls:SectionPanel Grid.Row="0" Title="筛选条件" StatusText="查询" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Project Filter -->
                    <TextBlock Text="项目:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <ComboBox Width="150" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableProjects}"
                              SelectedItem="{Binding ProjectCode, Mode=TwoWay}" />

                    <!-- Unit Filter -->
                    <TextBlock Text="机组:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <ComboBox Width="150" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableUnits}"
                              SelectedItem="{Binding UnitCode, Mode=TwoWay}" />

                    <!-- System Filter -->
                    <TextBlock Text="系统:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <ComboBox Width="150" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableSystems}"
                              SelectedItem="{Binding SystemCode, Mode=TwoWay}" />

                    <!-- Date From -->
                    <TextBlock Text="从:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <DatePicker Width="150" Margin="0,0,16,0" SelectedDate="{Binding DateFrom}" />

                    <!-- Date To -->
                    <TextBlock Text="至:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <DatePicker Width="150" Margin="0,0,16,0" SelectedDate="{Binding DateTo}" />

                    <!-- Query Button -->
                    <Button Content="查询" Margin="0,0,8,0"
                            Command="{Binding ApplyFiltersCommand}" />

                    <!-- Export Button -->
                    <Button Content="导出"  
                            Command="{Binding ExportDataCommand}" />
                </StackPanel>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="2">
            <!-- Tab 1: 故障趋势 -->
            <TabItem Header="故障趋势">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid showing fault type statistics -->
                    <controls:SectionPanel Grid.Column="0" Title="故障类型统计" StatusText="汇总" StatusBrush="{StaticResource BrushDanger}">
                        <controls:SectionPanel.PanelContent>
                            <DataGrid ItemsSource="{Binding FaultTypeData}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="阀门类型" Binding="{Binding TypeName}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格数" Binding="{Binding PassCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="不合格数" Binding="{Binding FailCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="总计" Binding="{Binding TotalCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- Bar chart area -->
                    <controls:SectionPanel Grid.Column="2" Title="故障分布" StatusText="柱状图" StatusBrush="{StaticResource BrushWarn}">
                        <controls:SectionPanel.PanelContent>
                            <ItemsControl ItemsSource="{Binding FaultTypeData}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding TypeName}" Foreground="{StaticResource BrushMutedText}" FontSize="11" />
                                            <Grid Height="20" Margin="0,2,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Pass bar -->
                                                <Rectangle Grid.Column="0" Fill="{StaticResource BrushOk}"
                                                           Width="{Binding PassWidth}"
                                                           HorizontalAlignment="Left"
                                                           Style="{StaticResource BarChartItemStyle}" />
                                                <!-- Fail bar -->
                                                <Rectangle Grid.Column="1" Fill="{StaticResource BrushDanger}"
                                                           Width="{Binding FailWidth}"
                                                           HorizontalAlignment="Left"
                                                           Style="{StaticResource BarChartItemStyle}" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: 合格率统计 -->
            <TabItem Header="合格率统计">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary Stats Tiles -->
                    <UniformGrid Grid.Row="0" Columns="3" Rows="1">
                        <controls:StatTile Margin="0,0,10,0" Title="总试验数" Value="{Binding TotalTestCount}" Unit="次" Description="选定范围内的试验总数" StatusText="统计" StatusBrush="{StaticResource BrushPrimary}" />
                        <controls:StatTile Margin="0,0,10,0" Title="总体合格率" Value="{Binding OverallPassRate}" Unit="%" Description="合格试验占比" StatusText="指标" StatusBrush="{StaticResource BrushOk}" />
                        <controls:StatTile Title="不合格数" Value="{Binding TotalFailCount}" Unit="次" Description="需要关注的试验" StatusText="异常" StatusBrush="{StaticResource BrushDanger}" />
                    </UniformGrid>

                    <!-- DataGrid with pass rates -->
                    <controls:SectionPanel Grid.Row="2" Title="各阀门合格率" StatusText="明细" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <DataGrid ItemsSource="{Binding PassRateData}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="阀门编号" Binding="{Binding ObjectCode}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="试验次数" Binding="{Binding TestCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格次数" Binding="{Binding PassCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格率(%)" Binding="{Binding PassRate}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTemplateColumn Header="状态" Width="*" SortMemberPath="IsQualified">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="60" Height="22"
                                                        Background="{Binding StatusBrush}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: 泄漏率趋势 -->
            <TabItem Header="泄漏率趋势">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Legend / Info Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="120" Height="28" Margin="0,0,8,0" Background="#F7FAFF" BorderBrush="#BCD0F4" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource BrushPrimary}" Margin="0,0,6,0" />
                                <TextBlock Text="压力通道" FontSize="11" Foreground="{StaticResource BrushText}" />
                            </StackPanel>
                        </Border>
                        <Border Width="120" Height="28" Margin="0,0,8,0" Background="#F7FFFB" BorderBrush="#BCE6D4" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource BrushOk}" Margin="0,0,6,0" />
                                <TextBlock Text="流量通道" FontSize="11" Foreground="{StaticResource BrushText}" />
                            </StackPanel>
                        </Border>
                        <Border Width="120" Height="28" Background="#FFF5F0" BorderBrush="#FADCD0" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource BrushWarn}" Margin="0,0,6,0" />
                                <TextBlock Text="温度通道" FontSize="11" Foreground="{StaticResource BrushText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource BrushMutedText}" FontSize="11" />
                    </StackPanel>

                    <!-- MultiChannelLineChart -->
                    <controls:SectionPanel Grid.Row="2" Title="泄漏率趋势曲线" StatusText="L/min" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <controls:MultiChannelLineChart
                                PressurePoints="{Binding PressureLeakagePoints}"
                                PressureMin="{Binding PressureMin}"
                                PressureMax="{Binding PressureMax}"
                                FlowPoints="{Binding FlowLeakagePoints}"
                                FlowMin="{Binding FlowMin}"
                                FlowMax="{Binding FlowMax}"
                                TempPoints="{Binding TempLeakagePoints}"
                                TempMin="{Binding TempMin}"
                                TempMax="{Binding TempMax}" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
