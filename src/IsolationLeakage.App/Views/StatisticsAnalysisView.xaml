<UserControl x:Class="IsolationLeakage.App.Views.StatisticsAnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf">
    <UserControl.Resources>
        <!-- Bar Chart Item Style -->
        <Style x:Key="BarChartItemStyle" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="2" />
            <Setter Property="RadiusY" Value="2" />
        </Style>

        <!-- Tab 标题样式（图标+文字） - 与系统设置页面统一 -->
        <Style x:Key="TabHeaderStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderIconStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <controls:SectionPanel Grid.Row="0" Title="筛选条件" StatusText="查询" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Project Filter -->
                    <TextBlock Text="项目:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <ComboBox Width="150" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableProjects}"
                              SelectedItem="{Binding ProjectCode, Mode=TwoWay}" />

                    <!-- Unit Filter -->
                    <TextBlock Text="机组:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <ComboBox Width="150" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableUnits}"
                              SelectedItem="{Binding UnitCode, Mode=TwoWay}" />

                    <!-- System Filter -->
                    <TextBlock Text="系统:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <ComboBox Width="150" Margin="0,0,16,0"
                              ItemsSource="{Binding AvailableSystems}"
                              SelectedItem="{Binding SystemCode, Mode=TwoWay}" />

                    <!-- Date From -->
                    <TextBlock Text="从:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <DatePicker Width="150" Margin="0,0,16,0" SelectedDate="{Binding DateFrom}" />

                    <!-- Date To -->
                    <TextBlock Text="至:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource BrushMutedText}" />
                    <DatePicker Width="150" Margin="0,0,16,0" SelectedDate="{Binding DateTo}" />

                    <!-- Query Button -->
                    <Button Content="查询" Margin="0,0,8,0"
                            Command="{Binding ApplyFiltersCommand}" />

                    <!-- Export Button -->
                    <Button Content="导出"  
                            Command="{Binding ExportDataCommand}" />
                </StackPanel>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="2" Style="{StaticResource IndustrialTabControl}">
            <!-- Tab 1: 故障趋势 -->
            <TabItem Style="{StaticResource IndustrialTabItem}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE825;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="故障趋势" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid showing fault type statistics -->
                    <controls:SectionPanel Grid.Column="0" Title="故障类型统计" StatusText="汇总" StatusBrush="{StaticResource BrushDanger}">
                        <controls:SectionPanel.PanelContent>
                            <DataGrid ItemsSource="{Binding FaultTypeData}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="阀门类型" Binding="{Binding TypeName}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格数" Binding="{Binding PassCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="不合格数" Binding="{Binding FailCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="总计" Binding="{Binding TotalCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <!-- 故障分布 OxyPlot 堆叠柱状图 -->
                    <controls:SectionPanel Grid.Column="2" Title="故障分布" StatusText="合格/不合格" StatusBrush="{StaticResource BrushWarn}">
                        <controls:SectionPanel.PanelContent>
                            <oxy:PlotView Model="{Binding FaultDistributionPlotModel}" MinHeight="300" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: 合格率统计 -->
            <TabItem Style="{StaticResource IndustrialTabItem}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8CE;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="合格率统计" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Summary Stats Tiles -->
                    <UniformGrid Grid.Row="0" Columns="3" Rows="1">
                        <controls:StatTile Margin="0,0,10,0" Title="总试验数" Value="{Binding TotalTestCount}" Unit="次" Description="选定范围内的试验总数" StatusText="统计" StatusBrush="{StaticResource BrushPrimary}" />
                        <controls:StatTile Margin="0,0,10,0" Title="总体合格率" Value="{Binding OverallPassRate}" Unit="%" Description="合格试验占比" StatusText="指标" StatusBrush="{StaticResource BrushOk}" />
                        <controls:StatTile Title="不合格数" Value="{Binding TotalFailCount}" Unit="次" Description="需要关注的试验" StatusText="异常" StatusBrush="{StaticResource BrushDanger}" />
                    </UniformGrid>

                    <!-- DataGrid with pass rates -->
                    <controls:SectionPanel Grid.Row="2" Title="各阀门合格率" StatusText="明细" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <DataGrid ItemsSource="{Binding PassRateData}" IsReadOnly="True" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="阀门编号" Binding="{Binding ObjectCode}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="试验次数" Binding="{Binding TestCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格次数" Binding="{Binding PassCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格率(%)" Binding="{Binding PassRate}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTemplateColumn Header="状态" Width="*" SortMemberPath="PassRate">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="60" Height="22"
                                                        Background="{Binding StatusBrush}"
                                                        HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 3: 泄漏率趋势 -->
            <TabItem Style="{StaticResource IndustrialTabItem}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE9E9;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="泄漏率趋势" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Legend / Info Bar -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="120" Height="28" Margin="0,0,8,0" Background="#F7FAFF" BorderBrush="#BCD0F4" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource BrushPrimary}" Margin="0,0,6,0" />
                                <TextBlock Text="泄漏率 L/min" FontSize="11" Foreground="{StaticResource BrushText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StatusMessage}" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource BrushMutedText}" FontSize="11" />
                    </StackPanel>

                    <!-- 动态多系列趋势图：按阀门类型分组 -->
                    <controls:SectionPanel Grid.Row="2" Title="不同阀门类型泄漏率趋势曲线" StatusText="L/min" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="200" />
                                </Grid.ColumnDefinitions>

                                <!-- TrendChart 动态通道模式 -->
                                <controls:TrendChart
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    YAxisTitle="泄漏率 L/min"
                                    Channels="{Binding LeakageTrendChannels}" />

                                <!-- 图例（动态，每种阀门类型一项） -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,10,0,0">
                                    <TextBlock FontSize="14" FontWeight="SemiBold"
                                               Text="阀门类型" Margin="0,0,0,12" />

                                    <ItemsControl ItemsSource="{Binding LeakageTrendChannels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Rectangle Width="18" Height="4" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="13" Margin="10,0,0,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0}：{1}">
                                                                <Binding Path="Name" />
                                                                <Binding Path="Points.Count" />
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="0,8,0,0"
                                               TextWrapping="Wrap"
                                               Text="提示：每种阀门类型一条曲线，显示泄漏率历史趋势对比。" />
                                </StackPanel>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

            <!-- Tab 4: 阀门试验次数 -->
            <TabItem Style="{StaticResource IndustrialTabItem}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8FD;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="阀门试验次数" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <controls:SectionPanel Grid.Row="0" Title="汇总" StatusText="Top 50" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="共统计" VerticalAlignment="Center" Foreground="{StaticResource BrushMutedText}" FontSize="12" />
                                <TextBlock Text="{Binding ValveTestCounts.Count}" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushPrimary}" Margin="6,0,12,0" />
                                <TextBlock Text="个阀门有试验记录" VerticalAlignment="Center" Foreground="{StaticResource BrushMutedText}" FontSize="12" />
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <controls:SectionPanel Grid.Column="0" Title="阀门试验次数排名" StatusText="次数" StatusBrush="{StaticResource BrushPrimary}">
                            <controls:SectionPanel.PanelContent>
                                <DataGrid ItemsSource="{Binding ValveTestCounts}" IsReadOnly="True" AutoGenerateColumns="False"
                                          CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="试验对象编号" Binding="{Binding ObjectCode}" Width="2*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                        <DataGridTextColumn Header="试验次数" Binding="{Binding Count}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </controls:SectionPanel.PanelContent>
                        </controls:SectionPanel>

                        <controls:SectionPanel Grid.Column="2" Title="试验次数分布（Top 20）" StatusText="柱状图" StatusBrush="{StaticResource BrushOk}">
                            <controls:SectionPanel.PanelContent>
                                <oxy:PlotView Model="{Binding ValveTestCountPlotModel}" MinHeight="250" />
                            </controls:SectionPanel.PanelContent>
                        </controls:SectionPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Tab 5: 机组合格情况 -->
            <TabItem Style="{StaticResource IndustrialTabItem}">
                <TabItem.Header>
                    <StackPanel Style="{StaticResource TabHeaderStyle}">
                        <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE81D;" />
                        <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="机组合格情况" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <controls:SectionPanel Grid.Column="0" Title="机组阀门合格情况" StatusText="汇总" StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <DataGrid ItemsSource="{Binding UnitPassData}" IsReadOnly="True" AutoGenerateColumns="False"
                                      CanUserSortColumns="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="机组名称" Binding="{Binding UnitName}" Width="2*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="总试验数" Binding="{Binding TotalCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格数" Binding="{Binding PassCount}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                    <DataGridTextColumn Header="合格率" Width="*">
                                        <DataGridTextColumn.Binding>
                                            <Binding Path="PassRate" StringFormat="{}{0:F1}%" />
                                        </DataGridTextColumn.Binding>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <controls:SectionPanel Grid.Column="2" Title="机组合格率对比" StatusText="柱状图" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <oxy:PlotView Model="{Binding UnitPassPlotModel}" MinHeight="250" />
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
