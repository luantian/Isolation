<UserControl x:Class="IsolationLeakage.App.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IsolationLeakage.App.Views">
    <TabControl Margin="12" Style="{StaticResource IndustrialTabControl}">
        <TabItem Header="项目/机组">
            <views:ProjectUnitManagementView DataContext="{Binding ProjectUnitPage}" />
        </TabItem>
        <TabItem Header="试验对象管理">
            <views:TestObjectPathManagementView DataContext="{Binding TestObjectPathPage}" />
        </TabItem>
        <TabItem Header="测量装置">
            <views:MeasurementDeviceLedgerView DataContext="{Binding MeasurementDevicePage}" />
        </TabItem>
        <TabItem Header="报告导出">
            <views:ReportExportView DataContext="{Binding ReportExportPage}" />
        </TabItem>
    </TabControl>
</UserControl>
