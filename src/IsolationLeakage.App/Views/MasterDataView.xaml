<UserControl x:Class="IsolationLeakage.App.Views.MasterDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IsolationLeakage.App.Views">
    <UserControl.Resources>
        <!-- Tab 标题样式（图标+文字） - 与系统设置页面统一 -->
        <Style x:Key="TabHeaderStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderIconStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>
    <TabControl Margin="8" Style="{StaticResource IndustrialTabControl}"
                SelectionChanged="OnTabSelectionChanged">
        <TabItem Style="{StaticResource IndustrialTabItem}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource TabHeaderStyle}">
                    <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8BC;" />
                    <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="项目/机组" />
                </StackPanel>
            </TabItem.Header>
            <views:ProjectUnitManagementView DataContext="{Binding ProjectUnitPage}" />
        </TabItem>
        <TabItem Style="{StaticResource IndustrialTabItem}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource TabHeaderStyle}">
                    <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE90A;" />
                    <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="试验对象管理" />
                </StackPanel>
            </TabItem.Header>
            <views:TestObjectPathManagementView DataContext="{Binding TestObjectPathPage}" />
        </TabItem>
        <TabItem Style="{StaticResource IndustrialTabItem}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource TabHeaderStyle}">
                    <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE950;" />
                    <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="测量装置" />
                </StackPanel>
            </TabItem.Header>
            <views:MeasurementDeviceLedgerView DataContext="{Binding MeasurementDevicePage}" />
        </TabItem>
        <TabItem Style="{StaticResource IndustrialTabItem}">
            <TabItem.Header>
                <StackPanel Style="{StaticResource TabHeaderStyle}">
                    <TextBlock Style="{StaticResource TabHeaderIconStyle}" Text="&#xE8A5;" />
                    <TextBlock Style="{StaticResource TabHeaderTextStyle}" Text="报告导出" />
                </StackPanel>
            </TabItem.Header>
            <views:ReportExportView DataContext="{Binding ReportExportPage}" />
        </TabItem>
    </TabControl>
</UserControl>