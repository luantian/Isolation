<UserControl x:Class="IsolationLeakage.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="1.3*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 核心指标 -->
            <UniformGrid Grid.Row="0" Columns="6" Rows="1">
                <controls:StatTile Margin="0,0,10,0" Title="{Binding TestObjectTitle}" Value="{Binding TestObjectValue}" Unit="{Binding TestObjectUnit}" Description="{Binding TestObjectDesc}" StatusText="{Binding TestObjectStatus}" StatusBrush="{StaticResource BrushPrimary}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding DeviceTitle}" Value="{Binding DeviceValue}" Unit="{Binding DeviceUnit}" Description="{Binding DeviceDesc}" StatusText="{Binding DeviceStatus}" StatusBrush="{StaticResource BrushWarn}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding RecordTitle}" Value="{Binding RecordValue}" Unit="{Binding RecordUnit}" Description="{Binding RecordDesc}" StatusText="{Binding RecordStatus}" StatusBrush="{StaticResource BrushPrimary}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding PassRateTitle}" Value="{Binding PassRateValue}" Unit="{Binding PassRateUnit}" Description="{Binding PassRateDesc}" StatusText="{Binding PassRateStatus}" StatusBrush="{StaticResource BrushOk}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding AnomalyTitle}" Value="{Binding AnomalyValue}" Unit="{Binding AnomalyUnit}" Description="{Binding AnomalyDesc}" StatusText="{Binding AnomalyStatus}" StatusBrush="{StaticResource BrushWarn}" />
                <controls:StatTile Title="{Binding BackupTitle}" Value="{Binding BackupValue}" Unit="{Binding BackupUnit}" Description="{Binding BackupDesc}" StatusText="{Binding BackupStatus}" StatusBrush="{StaticResource BrushOk}" />
            </UniformGrid>

            <!-- 中排：试验记录 + 导入详情 + 快捷操作 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:SectionPanel Grid.Column="0" Title="试验记录" StatusText="最近导入" StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <DataGrid ItemsSource="{Binding PreviewRecords}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="试验对象" Binding="{Binding ObjectCode}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="机组" Binding="{Binding Unit}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="最终泄漏率" Binding="{Binding LeakageRate}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="导入时间" Binding="{Binding UploadedAt}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Grid.Column="2" Title="最近导入详情" StatusText="{Binding LatestImportResult}" StatusBrush="{Binding LatestImportResultBrush}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource MutedTextBlock}">
                                <Run Text="{Binding LatestImportObjectCode, Mode=OneWay}" />
                                <Run Text=" / 最终泄漏率" />
                            </TextBlock>
                            <TextBlock Grid.Row="1" Margin="0,6,0,12" Style="{StaticResource ValueTextBlock}" Text="{Binding LatestImportLeakageRate}" />
                            <StackPanel Grid.Row="2">
                                <controls:DetailRow Label="判定结果" Value="{Binding LatestImportResult}" ValueBrush="{Binding LatestImportResultBrush}" />
                                <controls:DetailRow Label="导入时间" Value="{Binding LatestImportTime}" />
                                <controls:DetailRow Label="测量装置" Value="{Binding LatestImportDevice}" />
                                <controls:DetailRow Label="数据状态" Value="{Binding LatestImportDataStatus}" ValueBrush="{StaticResource BrushOk}" />
                                <controls:DetailRow Label="操作人员" Value="{Binding LatestImportOperator}" />
                            </StackPanel>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </Grid>

            <!-- 下排：台账概况 + 装置状态 + 系统维护 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:SectionPanel Grid.Column="0" Title="台账概况" StatusText="正常" StatusBrush="{StaticResource BrushOk}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 第一行：项目/机组 -->
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                                <controls:MetricCard Margin="0,0,6,0" Title="项目" Value="{Binding ProjectCount}" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                <controls:MetricCard Margin="3,0,3,0" Title="机组" Value="{Binding UnitCount}" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                <controls:MetricCard Margin="6,0,0,0" Title="系统" Value="{Binding SystemCount}" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                            </UniformGrid>

                            <!-- 第二行：贯穿件/阀门/部件 -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,8">
                                <controls:MetricCard Margin="0,0,6,0" Title="贯穿件" Value="{Binding PenetrationCount}" Unit="个" AccentBrush="{StaticResource BrushSecondary}" CardBackground="#F7F9FC" />
                                <controls:MetricCard Margin="3,0,3,0" Title="阀门" Value="{Binding ValveCount}" Unit="个" AccentBrush="{StaticResource BrushWarn}" CardBackground="#FFF8E1" />
                                <controls:MetricCard Margin="6,0,0,0" Title="部件" Value="{Binding ComponentCount}" Unit="个" AccentBrush="{StaticResource BrushMutedText}" CardBackground="#F5F5F5" />
                            </UniformGrid>

                            <!-- 第三行：试验统计 -->
                            <UniformGrid Grid.Row="2" Columns="3">
                                <controls:MetricCard Margin="0,0,6,0" Title="试验记录" Value="{Binding RecordCount}" Unit="条" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                <controls:MetricCard Margin="3,0,3,0" Title="合格" Value="{Binding PassCount}" Unit="条" AccentBrush="{StaticResource BrushOk}" CardBackground="#F0FFFB" />
                                <controls:MetricCard Margin="6,0,0,0" Title="不合格" Value="{Binding FailCount}" Unit="条" AccentBrush="{StaticResource BrushDanger}" CardBackground="#FFF5F5" />
                            </UniformGrid>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Grid.Column="2" Title="装置状态" StatusText="最近连接" StatusBrush="{StaticResource BrushWarn}">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding DeviceStatusItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DetailRow Label="{Binding DeviceCode}" Value="{Binding StatusText}" ValueBrush="{Binding StatusBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Margin="0,8,0,8" />
                            <controls:DetailRow Label="通信方式" Value="{Binding CommunicationSummaryText}" />
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Grid.Column="4" Title="系统维护" StatusText="完整" StatusBrush="{StaticResource BrushOk}">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <controls:DetailRow Label="数据库" Value="{Binding DbConnectionText}" />
                            <controls:DetailRow Label="最近备份" Value="{Binding BackupValue}" />
                            <controls:DetailRow Label="备份状态" Value="完整" ValueBrush="{StaticResource BrushOk}" />
                            <controls:DetailRow Label="同步状态" Value="待配置" ValueBrush="{StaticResource BrushWarn}" />
                            <Border Margin="0,12,0,0" Padding="10,7" Background="#F7F9FC">
                                <controls:StatusDot Text="备份、迁移和日志在系统管理中维护" DotBrush="{StaticResource BrushPrimary}" />
                            </Border>
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
