<UserControl x:Class="IsolationLeakage.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  Padding="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="1.1*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="1.2*" />
            </Grid.RowDefinitions>

            <!-- 核心指标 -->
            <UniformGrid Grid.Row="0" Columns="6" Rows="1">
                <controls:StatTile Margin="0,0,10,0" Title="{Binding TestObjectTitle}" Value="{Binding TestObjectValue}" Unit="{Binding TestObjectUnit}" Description="{Binding TestObjectDesc}" StatusText="{Binding TestObjectStatus}" StatusBrush="{StaticResource BrushPrimary}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding DeviceTitle}" Value="{Binding DeviceValue}" Unit="{Binding DeviceUnit}" Description="{Binding DeviceDesc}" StatusText="{Binding DeviceStatus}" StatusBrush="{StaticResource BrushWarn}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding RecordTitle}" Value="{Binding RecordValue}" Unit="{Binding RecordUnit}" Description="{Binding RecordDesc}" StatusText="{Binding RecordStatus}" StatusBrush="{StaticResource BrushPrimary}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding PassRateTitle}" Value="{Binding PassRateValue}" Unit="{Binding PassRateUnit}" Description="{Binding PassRateDesc}" StatusText="{Binding PassRateStatus}" StatusBrush="{StaticResource BrushOk}" />
                <controls:StatTile Margin="0,0,10,0" Title="{Binding AnomalyTitle}" Value="{Binding AnomalyValue}" Unit="{Binding AnomalyUnit}" Description="{Binding AnomalyDesc}" StatusText="{Binding AnomalyStatus}" StatusBrush="{StaticResource BrushWarn}" />
                <controls:StatTile Title="{Binding BackupTitle}" Value="{Binding BackupValue}" Unit="{Binding BackupUnit}" Description="{Binding BackupDesc}" StatusText="{Binding BackupStatus}" StatusBrush="{StaticResource BrushOk}" />
            </UniformGrid>

            <!-- 中排：试验记录 + 导入详情 + 快捷操作 -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:SectionPanel Grid.Column="0" Title="试验记录" StatusText="最近导入" StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <DataGrid ItemsSource="{Binding PreviewRecords}" IsReadOnly="True" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="试验对象" Binding="{Binding ObjectCode}" Width="160" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="机组" Binding="{Binding Unit}" Width="120" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="最终泄漏率(Nml/min)" Binding="{Binding LeakageRate}" Width="170" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTemplateColumn Header="结果" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Result}"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Result}" Value="不合格">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="导入时间" Binding="{Binding UploadedAt}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Grid.Column="2" Title="最近导入详情" StatusText="{Binding LatestImportResult}" StatusBrush="{Binding LatestImportResultBrush}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource MutedTextBlock}" VerticalAlignment="Bottom">
                                    <Run Text="{Binding LatestImportObjectCode, Mode=OneWay}" />
                                    <Run Text=" / 最终泄漏率" />
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource ValueTextBlock}" Text="{Binding LatestImportLeakageRate}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            </DockPanel>
                            <StackPanel Grid.Row="1">
                                <controls:DetailRow Label="判定结果" Value="{Binding LatestImportResult}" ValueBrush="{Binding LatestImportResultBrush}" />
                                <controls:DetailRow Label="导入时间" Value="{Binding LatestImportTime}" />
                                <controls:DetailRow Label="测量装置" Value="{Binding LatestImportDevice}" />
                                <controls:DetailRow Label="数据状态" Value="{Binding LatestImportDataStatus}" ValueBrush="{StaticResource BrushOk}" />
                                <controls:DetailRow Label="操作人员" Value="{Binding LatestImportOperator}" />
                            </StackPanel>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </Grid>

            <!-- 下排：台账概况 + 系统维护 -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.7*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <controls:SectionPanel Grid.Column="0" Title="台账概况" StatusText="{Binding LedgerStatusText}" StatusBrush="{Binding LedgerStatusBrush}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 第一行：项目/机组 -->
                            <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,6">
                                <controls:MetricCard Margin="0,0,4,0" Title="项目" Value="{Binding ProjectCount}" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                <controls:MetricCard Margin="2,0,2,0" Title="机组" Value="{Binding UnitCount}" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                <controls:MetricCard Margin="4,0,0,0" Title="系统" Value="{Binding SystemCount}" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                            </UniformGrid>

                            <!-- 第二行：贯穿件/阀门/部件 -->
                            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,6">
                                <controls:MetricCard Margin="0,0,4,0" Title="贯穿件" Value="{Binding PenetrationCount}" Unit="个" AccentBrush="#0891B2" CardBackground="#F7F9FC" />
                                <controls:MetricCard Margin="2,0,2,0" Title="阀门" Value="{Binding ValveCount}" Unit="个" AccentBrush="{StaticResource BrushWarn}" CardBackground="#FFF8E1" />
                                <controls:MetricCard Margin="4,0,0,0" Title="部件" Value="{Binding ComponentCount}" Unit="个" AccentBrush="{StaticResource BrushMutedText}" CardBackground="#F5F5F5" />
                            </UniformGrid>

                            <!-- 第三行：试验统计 -->
                            <UniformGrid Grid.Row="2" Columns="3">
                                <controls:MetricCard Margin="0,0,4,0" Title="试验记录" Value="{Binding RecordCount}" Unit="条" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                <controls:MetricCard Margin="2,0,2,0" Title="合格" Value="{Binding PassCount}" Unit="条" AccentBrush="{StaticResource BrushOk}" CardBackground="#F0FFFB" />
                                <controls:MetricCard Margin="4,0,0,0" Title="不合格" Value="{Binding FailCount}" Unit="条" AccentBrush="{StaticResource BrushDanger}" CardBackground="#FFF5F5" />
                            </UniformGrid>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Grid.Column="2" Title="系统维护" StatusText="{Binding MaintenanceStatusText}" StatusBrush="{Binding MaintenanceStatusBrush}">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <controls:DetailRow Label="数据库" Value="{Binding DbConnectionText}" />
                            <controls:DetailRow Label="最近备份" Value="{Binding BackupValue}" />
                            <controls:DetailRow Label="备份状态" Value="{Binding BackupStatus}" ValueBrush="{Binding BackupStatusBrush}" />
                            <controls:DetailRow Label="同步状态" Value="{Binding SyncStatus}" ValueBrush="{Binding SyncStatusBrush}" />
                            <Border Margin="0,12,0,0" Padding="10,7" Background="#F7F9FC">
                                <controls:StatusDot Text="备份、迁移和日志在系统管理中维护" DotBrush="{StaticResource BrushPrimary}" />
                            </Border>
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
