<UserControl x:Class="IsolationLeakage.App.Views.TestRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <TabControl Margin="12">
        <!-- 结果导入 -->
        <TabItem Header="结果导入">
            <DockPanel Margin="12" LastChildFill="True">
                <controls:SectionPanel Width="360" Margin="0,0,12,0" Title="导入入口" StatusText="U 盘数据" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushPrimary}"
                                       Text="导入测试结果数据文件" />
                            <TextBlock Margin="0,10,0,0"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="现场测试完成后，将泄漏仪生成的数据包通过 U 盘拷贝到本机，再在这里导入并解析入库。"
                                       TextWrapping="Wrap" />
                            <Button Width="120"
                                    Margin="0,18,0,0"
                                    HorizontalAlignment="Left"
                                    Content="选择数据包" />
                            <Border Margin="0,18,0,0"
                                    Padding="10,8"
                                    Background="#F7F9FC">
                                <TextBlock Foreground="{StaticResource BrushMutedText}"
                                           Text="当前为界面与业务流程占位；后续接入文件解析后，导入成功会生成试验记录并绑定过程 CSV。"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Title="数据结构" StatusText="客户确认" StatusBrush="{StaticResource BrushOk}">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <controls:DetailRow Label="结果字段" Value="示例：约 5 个核心结果值字段" />
                            <controls:DetailRow Label="过程数据" Value="CSV 过程采集数据" />
                            <controls:DetailRow Label="过程通道" Value="示例：约 15 个采集通道" />
                            <controls:DetailRow Label="入库结果" Value="生成一条试验记录" />
                            <controls:DetailRow Label="后续查看" Value="结果详情 / 曲线回放 / 历史查询" />
                            <TextBlock Margin="0,14,0,0"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="字段名称、通道名称、单位和采样频率以客户实际数据包格式为准；未确认的枚举和值在界面上使用「待确认」提示。"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </DockPanel>
        </TabItem>

        <!-- 记录查询 -->
        <TabItem Header="记录查询">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <!-- 查询条件栏 -->
                <controls:SectionPanel Title="记录查询" StatusText="已导入数据包" StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource MutedTextBlock}" Text="判定结果" VerticalAlignment="Center" />
                            <ComboBox Width="160"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding ResultOptions}"
                                      SelectedItem="{Binding ResultFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="18,0,8,0" Style="{StaticResource MutedTextBlock}" Text="关键字" VerticalAlignment="Center" />
                            <TextBox Width="320"
                                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="记录编号、试验对象、测量装置或数据包名称" />

                            <Button Width="72"
                                    Margin="12,0,0,0"
                                    Click="QueryButton_Click"
                                    Content="查询" />
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <!-- 记录列表 + 选中详情 -->
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <controls:SectionPanel Title="试验记录" StatusText="历史结果" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left" Width="680">
                        <controls:SectionPanel.PanelContent>
                            <DataGrid ItemsSource="{Binding FilteredRecords}"
                                      SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="145" Binding="{Binding RecordCode}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="记录编号" />
                                    <DataGridTextColumn Width="105" Binding="{Binding ProjectName}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="项目" />
                                    <DataGridTextColumn Width="120" Binding="{Binding UnitName}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="机组" />
                                    <DataGridTextColumn Width="115" Binding="{Binding ObjectCode}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="对象编码" />
                                    <DataGridTextColumn Width="105" Binding="{Binding ObjectType}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="对象类型" />
                                    <DataGridTextColumn Width="90" Binding="{Binding DeviceCode}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="测量装置" />
                                    <DataGridTextColumn Width="120" Binding="{Binding TestTime}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="试验时间" />
                                    <DataGridTextColumn Width="70" Binding="{Binding Result}" ElementStyle="{StaticResource DataGridTextElementStyle}" Header="结果" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <controls:SectionPanel Margin="12,0,0,0" Title="当前选中" StatusText="记录摘要" StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimary}"
                                           Text="{Binding SelectedRecordTitle}" />
                                <Border Margin="0,12,0,12"
                                        BorderBrush="{StaticResource BrushPanelBorder}"
                                        BorderThickness="0,1,0,0" />
                                <controls:DetailRow Label="数据包" Value="{Binding SelectedRecord.DataPackageName}" />
                                <controls:DetailRow Label="导入时间" Value="{Binding SelectedRecord.ImportTime}" />
                                <controls:DetailRow Label="最终泄漏率" Value="{Binding SelectedRecord.FinalLeakageRate, StringFormat={}{0:0.###} L/min}" />
                                <controls:DetailRow Label="判定限值" Value="{Binding SelectedRecord.LeakageLimit, StringFormat={}{0:0.###} L/min}" />
                                <controls:DetailRow Label="判定结果" Value="{Binding SelectedRecord.Result}" />
                                <TextBlock Margin="0,12,0,0"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text="记录来自已导入的数据包；本页只做历史查询、结果查看和过程回放，不承担现场控制。"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </DockPanel>

                <!-- 过程曲线 -->
                <controls:SectionPanel Grid.Row="4" Title="过程曲线" StatusText="时序回放" StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>

                            <controls:MultiChannelLineChart Grid.Column="0"
                                    Margin="0,0,12,0"
                                    Background="#FAFBFD"
                                    ClipToBounds="True"
                                    PressurePoints="{Binding PressureCurvePoints}"
                                    FlowPoints="{Binding FlowCurvePoints}"
                                    TempPoints="{Binding TempCurvePoints}"
                                    PressureMin="{Binding PressureCurveMin}"
                                    PressureMax="{Binding PressureCurveMax}"
                                    FlowMin="{Binding FlowCurveMin}"
                                    FlowMax="{Binding FlowCurveMax}"
                                    TempMin="{Binding TempCurveMin}"
                                    TempMax="{Binding TempCurveMax}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                           Text="通道图例" Margin="0,0,0,10" />
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Rectangle Width="16" Height="3" Fill="#0758D8" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource MutedTextBlock}"
                                                   FontSize="11" Margin="8,0,0,0" Text="压力 MPa" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Rectangle Width="16" Height="3" Fill="#12A366" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource MutedTextBlock}"
                                                   FontSize="11" Margin="8,0,0,0" Text="泄漏率 L/min" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Rectangle Width="16" Height="3" Fill="#F97316" VerticalAlignment="Center" />
                                        <TextBlock Style="{StaticResource MutedTextBlock}"
                                                   FontSize="11" Margin="8,0,0,0" Text="温度 ℃" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Padding="8,6" Background="#F7F9FC" CornerRadius="4" Margin="0,10,0,0">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource MutedTextBlock}"
                                                   FontSize="10" Text="{Binding SelectedRecord.ObjectCode, TargetNullValue=未选择记录, FallbackValue=未选择记录}" />
                                        <TextBlock Style="{StaticResource MutedTextBlock}"
                                                   FontSize="10" Margin="0,2,0,0" Text="{Binding SelectedRecord.TestTime, TargetNullValue='--', FallbackValue='--'}" />
                                        <TextBlock Style="{StaticResource MutedTextBlock}"
                                                   FontSize="10" Margin="0,2,0,0"
                                                   Text="{Binding PressureCurvePoints.Count, Mode=OneWay, StringFormat='数据点 {0}'}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </Grid>
        </TabItem>

        <!-- 结果详情 -->
        <TabItem Header="结果详情">
            <DockPanel Margin="12" LastChildFill="True">
                <controls:SectionPanel Width="420" Margin="0,0,12,0" Title="基础信息" StatusText="试验对象" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <controls:DetailRow Label="记录编号" Value="{Binding SelectedRecord.RecordCode}" />
                            <controls:DetailRow Label="项目" Value="{Binding SelectedRecord.ProjectName}" />
                            <controls:DetailRow Label="机组" Value="{Binding SelectedRecord.UnitName}" />
                            <controls:DetailRow Label="对象编码" Value="{Binding SelectedRecord.ObjectCode}" />
                            <controls:DetailRow Label="对象名称" Value="{Binding SelectedRecord.ObjectName}" />
                            <controls:DetailRow Label="对象类型" Value="{Binding SelectedRecord.ObjectType}" />
                            <controls:DetailRow Label="测量装置" Value="{Binding SelectedRecord.DeviceCode}" />
                            <controls:DetailRow Label="操作人员" Value="{Binding SelectedRecord.Operator}" />
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Title="试验结果" StatusText="判定" StatusBrush="{StaticResource BrushOk}">
                    <controls:SectionPanel.PanelContent>
                        <StackPanel>
                            <controls:DetailRow Label="试验时间" Value="{Binding SelectedRecord.TestTime}" />
                            <controls:DetailRow Label="导入时间" Value="{Binding SelectedRecord.ImportTime}" />
                            <controls:DetailRow Label="数据包" Value="{Binding SelectedRecord.DataPackageName}" />
                            <controls:DetailRow Label="结果字段" Value="{Binding SelectedRecord.ResultFieldSummary}" />
                            <controls:DetailRow Label="试验压力" Value="{Binding SelectedRecord.TestPressure, StringFormat={}{0:0.###} MPa}" />
                            <controls:DetailRow Label="泄漏限值" Value="{Binding SelectedRecord.LeakageLimit, StringFormat={}{0:0.###} L/min}" />
                            <controls:DetailRow Label="最终泄漏率" Value="{Binding SelectedRecord.FinalLeakageRate, StringFormat={}{0:0.###} L/min}" />
                            <controls:DetailRow Label="判定结果" Value="{Binding SelectedRecord.Result}" />
                            <TextBlock Margin="0,12,0,0"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="{Binding SelectedRecord.Remark}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </DockPanel>
        </TabItem>

        <!-- 过程回放 -->
        <TabItem Header="过程回放">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:SectionPanel Title="回放说明" StatusText="数据包时序" StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <DockPanel LastChildFill="True">
                            <StackPanel Width="280" DockPanel.Dock="Right">
                                <controls:DetailRow Label="记录编号" Value="{Binding SelectedRecord.RecordCode}" />
                                <controls:DetailRow Label="数据包" Value="{Binding SelectedRecord.DataPackageName}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushPrimary}"
                                           Text="{Binding PlaybackTitle}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text="{Binding SelectedRecord.StepSummary}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text="{Binding SelectedRecord.ProcessChannelSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:SectionPanel Grid.Column="0" Title="压力过程" StatusText="曲线" StatusBrush="{StaticResource BrushPrimary}">
                        <controls:SectionPanel.PanelContent>
                            <Grid MinHeight="280">
                                <Border BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1" Background="#F8FAFD" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushPrimary}"
                                               Text="压力-时间曲线" />
                                    <TextBlock Margin="0,8,0,0"
                                               Width="320"
                                               Text="{Binding PressureCurveSummary}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushMutedText}" />
                                </StackPanel>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>

                    <controls:SectionPanel Grid.Column="2" Title="泄漏过程" StatusText="曲线" StatusBrush="{StaticResource BrushOk}">
                        <controls:SectionPanel.PanelContent>
                            <Grid MinHeight="280">
                                <Border BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1" Background="#F8FAFD" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushOk}"
                                               Text="泄漏率-时间曲线" />
                                    <TextBlock Margin="0,8,0,0"
                                               Width="320"
                                               Text="{Binding FlowCurveSummary}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource BrushMutedText}" />
                                </StackPanel>
                            </Grid>
                        </controls:SectionPanel.PanelContent>
                    </controls:SectionPanel>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
