<UserControl x:Class="IsolationLeakage.App.Views.TestRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:models="clr-namespace:IsolationLeakage.App.Models">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="4" />
            <RowDefinition Height="*" /> <!-- 列表区域自适应剩余空间 -->
            <RowDefinition Height="4" />
            <RowDefinition Height="Auto" MaxHeight="400" /> <!-- 曲线区域最大高度限制 -->
        </Grid.RowDefinitions>

        <!-- 顶部：查询条件栏 -->
        <Border Grid.Row="0" Padding="12" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
            <StackPanel>
                <!-- 第一行：项目/机组/结果 -->
                <DockPanel LastChildFill="False">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}" Text="项目"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding ProjectOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedProjectCode, Mode=TwoWay}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="机组"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding UnitOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedUnitCode, Mode=TwoWay}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="结果"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="100" Margin="0,0,0,0"
                              ItemsSource="{Binding ResultOptions}"
                              SelectedItem="{Binding ResultFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMutedText}"
                               Text="查询后显示结果" DockPanel.Dock="Left" />
                </DockPanel>
                <!-- 第二行：时间范围/关键字/按钮 -->
                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                    <controls:DateRangePicker FromDate="{Binding DateFrom, Mode=TwoWay}"
                                              ToDate="{Binding DateTo, Mode=TwoWay}"
                                              DockPanel.Dock="Left" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="关键字"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox Width="280"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="记录编号、试验对象、测量装置或数据包名称"
                             DockPanel.Dock="Left" />
                    <Button Margin="12,0,0,0" Command="{Binding QueryCommand}"
                            Content="查询" DockPanel.Dock="Left"
                            Height="28" Padding="12,0"
                            Background="{StaticResource BrushPrimary}" Foreground="White"
                            BorderThickness="0" />
                    <Button Margin="8,0,0,0" Command="{Binding ResetFiltersCommand}"
                            Content="重置" DockPanel.Dock="Left"
                            Height="28" Padding="12,0"
                            Background="{StaticResource BrushSecondary}" Foreground="White"
                            BorderThickness="0" />
                    <Border Width="1" Height="20" Background="{StaticResource BrushPanelBorder}" Margin="12,0" DockPanel.Dock="Left" />
                    <Button Margin="0,0,8,0" Command="{Binding BatchChangeRecipeCommand}"
                            Content="批量修改试验路径" DockPanel.Dock="Left"
                            Height="28" Padding="12,0" />
                    <Button Margin="0,0,0,0" Command="{Binding DeleteSelectedCommand}"
                            Content="批量删除" DockPanel.Dock="Left"
                            Height="28" Padding="12,0" Style="{StaticResource DangerButton}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 加载进度条 -->
        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Foreground="{StaticResource BrushPrimary}" Background="Transparent" />

        <!-- 中部：记录列表（铺满整行） -->
        <controls:SectionPanel Grid.Row="2" Title="试验记录列表" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 空数据提示 -->
                    <TextBlock Grid.Row="0" Text="暂无试验记录，请先在「数据上传」页面导入数据"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMutedText}" FontSize="14"
                               Padding="0,40"
                               Panel.ZIndex="999">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredRecords.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 列宽总和超过容器宽度时，由 DataGrid 自身的横向滚动条接管 -->
                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FilteredRecords}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="True"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              Style="{StaticResource IndustrialDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              Command="{Binding DataContext.ToggleAllSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  Checked="OnSelectionChanged" Unchecked="OnSelectionChanged" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="序号" Width="60" Binding="{Binding RowNumber}" ElementStyle="{StaticResource DataGridCenteredTextStyle}" />
                            <DataGridTextColumn Header="记录编号" Binding="{Binding RecordCode}" Width="180" />
                            <DataGridTextColumn Header="项目" Binding="{Binding Project.Name}" Width="140" />
                            <DataGridTextColumn Header="机组" Binding="{Binding Unit.Name}" Width="140" />
                            <DataGridTextColumn Header="对象编码" Binding="{Binding ObjectCode}" Width="200" />
                            <DataGridTextColumn Header="最终泄漏率" Binding="{Binding FinalLeakageRate, StringFormat={}{0:0.###}}" Width="120" />
                            <DataGridTextColumn Header="泄漏限值" Binding="{Binding LeakageLimit, StringFormat={}{0:0.###}, TargetNullValue='—'}" Width="120" />
                            <DataGridTemplateColumn Header="结果" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Result}" Value="{x:Static models:TestResult.Fail}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- 以下为次要信息，放在右侧可滚动查看 -->
                            <DataGridTextColumn Header="关联试验路径" Binding="{Binding RecipeName, TargetNullValue='未关联试验路径'}" Width="160" />
                            <DataGridTextColumn Header="测量装置" Binding="{Binding DeviceCode}" Width="200" />
                            <DataGridTextColumn Header="操作人员" Binding="{Binding Operator}" Width="150" />
                            <DataGridTextColumn Header="试验时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="200" />
                            <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="180" />
                            <!-- 备注列：给用户写备注用，同时强制列宽总和超过容器宽度 -->
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark, TargetNullValue='—'}" Width="800" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationControl Grid.Row="1"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                            TotalCount="{Binding TotalCount}"
                            PageSize="{Binding PageSize, Mode=TwoWay}"
                            GotoPageCommand="{Binding GoToPageCommand}" />
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 底部：过程曲线展示 + 试验路径参数 -->
        <controls:SectionPanel Grid.Row="4" Title="过程曲线回放">
            <controls:SectionPanel.HeaderExtraContent>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                    <TextBlock Text="从" VerticalAlignment="Center" FontSize="13"
                               Foreground="{StaticResource BrushMutedText}" />
                    <TextBox Width="60" Height="26" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"
                             Text="{Binding PlaybackStartTime, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" />
                    <TextBlock Text="s 到" VerticalAlignment="Center" FontSize="13" Margin="4,0,0,0"
                               Foreground="{StaticResource BrushMutedText}" />
                    <TextBox Width="60" Height="26" FontSize="13" VerticalAlignment="Center"
                             Text="{Binding PlaybackEndTime, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" />
                    <TextBlock Text="s (0=全部)" VerticalAlignment="Center" FontSize="13" Margin="4,0,0,0"
                               Foreground="{StaticResource BrushMutedText}" />
                    <Button Content="确认" Height="26" FontSize="12" Margin="10,0,0,0" Padding="12,0"
                            Command="{Binding ApplyDisplayDurationCommand}"
                            Background="{StaticResource BrushPrimary}" Foreground="White"
                            BorderThickness="0" />
                </StackPanel>
            </controls:SectionPanel.HeaderExtraContent>
            <controls:SectionPanel.PanelContent>
                <!-- MaxHeight = 外层 Row MaxHeight(400) - 标题栏(40) - ContentPadding 上下(10+4) = 346
                     在测量阶段即约束高度，确保 ScrollViewer 能正确出现滚动条 -->
                <Grid MaxHeight="346">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：三个趋势图（压力 / 温度 / 流量，横向排列，共享同一时间轴） -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 三个图表 -->
                        <Grid Grid.Row="0" Visibility="{Binding HasCurveData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 压力 -->
                            <Grid Grid.Column="0" Margin="0,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="压力 (MPa)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}" Margin="2,0,0,4" />
                                <controls:TrendChart Grid.Row="1"
                                        TimePoints="{Binding TimeAxisPoints}"
                                        Channels="{Binding PressureChannels}"
                                        YAxisTitle="压力 (MPa)" />
                            </Grid>

                            <!-- 温度 -->
                            <Grid Grid.Column="1" Margin="6,0,6,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="温度 (℃)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}" Margin="2,0,0,4" />
                                <controls:TrendChart Grid.Row="1"
                                        TimePoints="{Binding TimeAxisPoints}"
                                        Channels="{Binding TempChannels}"
                                        YAxisTitle="温度 (℃)" />
                            </Grid>

                            <!-- 流量 -->
                            <Grid Grid.Column="2" Margin="6,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="流量 (L/h)" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}" Margin="2,0,0,4" />
                                <controls:TrendChart Grid.Row="1"
                                        TimePoints="{Binding TimeAxisPoints}"
                                        Channels="{Binding FlowChannels}"
                                        YAxisTitle="流量 (L/h)" />
                            </Grid>
                        </Grid>

                        <!-- 图表加载覆盖层（数据量大时显示，禁止用户操作） -->
                        <Border Grid.Row="0"
                                Background="#80000000"
                                Visibility="{Binding IsLoadingCurve, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Panel.ZIndex="1000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📊 图表渲染中..."
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="由于数据量较大，正在加载图表，请稍候..."
                                           FontSize="13"
                                           Foreground="#E2E8F0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 空状态 -->
                        <TextBlock Text="该记录无过程曲线数据"
                                   Style="{StaticResource MutedTextBlock}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding NoCurveData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <!-- 右侧：分组图例 + 试验路径 -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="0,0,4,0">
                        <StackPanel VerticalAlignment="Top">
                            <!-- 压力图例 -->
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="压力通道" Margin="0,0,0,6" Foreground="{StaticResource BrushText}" />
                            <ItemsControl ItemsSource="{Binding PressureChannels}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="18" Height="3" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource BrushText}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1:F2}–{2:F2} {3}">
                                                        <Binding Path="Name" />
                                                        <Binding Path="Min" />
                                                        <Binding Path="Max" />
                                                        <Binding Path="Unit" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 温度图例 -->
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="温度通道" Margin="0,0,0,6" Foreground="{StaticResource BrushText}" />
                            <ItemsControl ItemsSource="{Binding TempChannels}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="18" Height="3" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource BrushText}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1:F2}–{2:F2} {3}">
                                                        <Binding Path="Name" />
                                                        <Binding Path="Min" />
                                                        <Binding Path="Max" />
                                                        <Binding Path="Unit" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 流量图例 -->
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="流量通道" Margin="0,0,0,6" Foreground="{StaticResource BrushText}" />
                            <ItemsControl ItemsSource="{Binding FlowChannels}" Margin="0,0,0,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                            <Rectangle Width="18" Height="3" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource BrushText}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0} {1:F2}–{2:F2} {3}">
                                                        <Binding Path="Name" />
                                                        <Binding Path="Min" />
                                                        <Binding Path="Max" />
                                                        <Binding Path="Unit" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 试验路径 -->
                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="试验路径" Margin="0,10,0,10" Foreground="{StaticResource BrushText}" />
                            <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Background="#F8FAFC">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="试验路径名称" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding SelectedRecord.RecipeName, TargetNullValue='未关联试验路径', FallbackValue='未关联试验路径'}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="系统" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipeSystem, TargetNullValue='—', FallbackValue='—'}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="贯穿件直径" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipePenetrationDiameter, TargetNullValue='—', StringFormat={}{0:F2} mm, FallbackValue='—'}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="试验阀门编号" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipeValveNo, TargetNullValue='—', FallbackValue='—'}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="阀门公称直径" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipeValveNominalDiameter, TargetNullValue='—', StringFormat={}{0:F2} mm, FallbackValue='—'}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="泄漏率限值" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipeLeakageLimit, TargetNullValue='—', StringFormat={}{0:F3}}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="预充压P2" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipePrechargeP2, TargetNullValue='—', StringFormat={}{0:F3} MPa}" />
                                    </Grid>
                                    <Grid Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12" Text="备注" Foreground="#64748B" />
                                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{StaticResource BrushText}" FontWeight="Medium" Text="{Binding RecipeRemark, TargetNullValue='—', FallbackValue='—'}" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
