<UserControl x:Class="IsolationLeakage.App.Views.TestRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <!-- 顶部：查询条件栏 -->
        <Border Grid.Row="0" Padding="12" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <Border Width="34" Height="32" Margin="0,0,8,0" Background="{StaticResource BrushPrimary}"
                        BorderBrush="{StaticResource BrushPrimaryDark}" BorderThickness="1"
                        DockPanel.Dock="Left">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE8A5;" />
                </Border>
                <TextBlock Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}" Text="判定结果"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <ComboBox Width="120" Margin="8,0,0,0"
                          ItemsSource="{Binding ResultOptions}"
                          SelectedItem="{Binding ResultFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                <TextBlock Margin="18,0,8,0" Style="{StaticResource MutedTextBlock}" Text="关键字"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <TextBox Width="320"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="记录编号、试验对象、测量装置或数据包名称"
                         DockPanel.Dock="Left" />
                <Button Width="80" Margin="12,0,0,0" Command="{Binding QueryCommand}"
                        Content="查询" DockPanel.Dock="Left"
                        Background="{StaticResource BrushPrimary}" Foreground="White"
                        BorderThickness="0" />
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}"
                           Text="{Binding StatusMessage}" DockPanel.Dock="Left" />
            </DockPanel>
        </Border>

        <!-- 中部：记录列表 + 选中详情 -->
        <DockPanel Grid.Row="2" LastChildFill="True">
            <!-- 左侧：记录列表 -->
            <controls:SectionPanel Width="720" Margin="0,0,12,0" Title="试验记录列表" StatusText="{Binding TotalCount, StringFormat='共 {0} 条'}" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left">
                <controls:SectionPanel.PanelContent>
                    <DataGrid ItemsSource="{Binding FilteredRecords}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="记录编号" Binding="{Binding RecordCode}" Width="120"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="项目" Binding="{Binding Project.Name}" Width="100"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="机组" Binding="{Binding Unit.Name}" Width="100"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="对象编码" Binding="{Binding ObjectCode}" Width="100"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="测量装置" Binding="{Binding DeviceCode}" Width="90"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="试验时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm}" Width="130"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="70"
                                                ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- 右侧：选中记录详情 -->
            <controls:SectionPanel Title="当前记录详情" StatusText="{Binding SelectedRecord.RecordCode, TargetNullValue='未选择', FallbackValue='未选择'}" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:DetailRow Label="记录编号" Value="{Binding SelectedRecord.RecordCode}" />
                            <controls:DetailRow Label="项目" Value="{Binding SelectedRecord.Project.Name}" />
                            <controls:DetailRow Label="机组" Value="{Binding SelectedRecord.Unit.Name}" />
                            <controls:DetailRow Label="对象编码" Value="{Binding SelectedRecord.ObjectCode}" />
                            <controls:DetailRow Label="对象名称" Value="{Binding SelectedRecord.ObjectName}" />
                            <controls:DetailRow Label="测量装置" Value="{Binding SelectedRecord.DeviceCode}" />
                            <controls:DetailRow Label="操作人员" Value="{Binding SelectedRecord.Operator}" />
                            <controls:DetailRow Label="试验时间" Value="{Binding SelectedRecord.TestTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                            <controls:DetailRow Label="导入时间" Value="{Binding SelectedRecord.ImportTime, StringFormat=yyyy-MM-dd HH:mm:ss}" />
                            <controls:DetailRow Label="数据包" Value="{Binding SelectedRecord.DataPackageName}" />
                            <controls:DetailRow Label="试验压力" Value="{Binding SelectedRecord.TestPressure, StringFormat={}{0:0.###} MPa}" />
                            <controls:DetailRow Label="泄漏限值" Value="{Binding SelectedRecord.LeakageLimit, StringFormat={}{0:0.###} L/min}" />
                            <controls:DetailRow Label="最终泄漏率" Value="{Binding SelectedRecord.FinalLeakageRate, StringFormat={}{0:0.###} L/min}" />
                            <controls:DetailRow Label="判定结果" Value="{Binding SelectedRecord.Result}" />
                            <TextBlock Margin="0,12,0,0" Foreground="{StaticResource BrushMutedText}"
                                       Text="{Binding SelectedRecord.Remark}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </DockPanel>

        <!-- 底部：过程曲线展示 -->
        <controls:SectionPanel Grid.Row="4" Title="过程曲线回放" StatusText="{Binding SelectedRecord.RecordCode, TargetNullValue='请选择记录', FallbackValue='请选择记录'}" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>

                    <controls:MultiChannelLineChart Grid.Column="0"
                            Margin="0,0,12,0"
                            Background="#FAFBFD"
                            ClipToBounds="True"
                            PressurePoints="{Binding PressureCurvePoints}"
                            FlowPoints="{Binding FlowCurvePoints}"
                            TempPoints="{Binding TempCurvePoints}"
                            PressureMin="{Binding PressureMin}"
                            PressureMax="{Binding PressureMax}"
                            FlowMin="{Binding FlowMin}"
                            FlowMax="{Binding FlowMax}"
                            TempMin="{Binding TempMin}"
                            TempMax="{Binding TempMax}" />

                    <!-- 图例 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="通道图例" Margin="0,0,0,10" />

                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#0758D8" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="压力 {0:F1}–{1:F1} MPa">
                                            <Binding Path="PressureMin" />
                                            <Binding Path="PressureMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#12A366" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="泄漏率 {0:F3}–{1:F3} L/min">
                                            <Binding Path="FlowMin" />
                                            <Binding Path="FlowMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#F97316" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="温度 {0:F1}–{1:F1} ℃">
                                            <Binding Path="TempMin" />
                                            <Binding Path="TempMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
