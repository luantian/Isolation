<UserControl x:Class="IsolationLeakage.App.Views.TestRecordsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:models="clr-namespace:IsolationLeakage.App.Models">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="5*" />
            <RowDefinition Height="8" />
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>

        <!-- 顶部：查询条件栏 -->
        <Border Grid.Row="0" Padding="12" Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
            <StackPanel>
                <!-- 第一行：项目/机组/结果 -->
                <DockPanel LastChildFill="False">
                    <TextBlock Margin="0,0,6,0" Style="{StaticResource MutedTextBlock}" Text="项目"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding ProjectOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedProjectCode, Mode=TwoWay}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="机组"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding UnitOptions}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedUnitCode, Mode=TwoWay}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="结果"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="100" Margin="0,0,0,0"
                              ItemsSource="{Binding ResultOptions}"
                              SelectedItem="{Binding ResultFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="16,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMutedText}"
                               Text="{Binding StatusMessage}" DockPanel.Dock="Left" />
                </DockPanel>
                <!-- 第二行：时间范围/关键字/按钮 -->
                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                    <controls:DateRangePicker FromDate="{Binding DateFrom, Mode=TwoWay}"
                                              ToDate="{Binding DateTo, Mode=TwoWay}"
                                              DockPanel.Dock="Left" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="导入时间"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <ComboBox Width="120"
                              ItemsSource="{Binding ImportTimeFilterOptions}"
                              SelectedItem="{Binding ImportTimeFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="14,0,6,0" Style="{StaticResource MutedTextBlock}" Text="关键字"
                               VerticalAlignment="Center" DockPanel.Dock="Left" />
                    <TextBox Width="280"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="记录编号、试验对象、测量装置或数据包名称"
                             DockPanel.Dock="Left" />
                    <Button Margin="12,0,0,0" Command="{Binding QueryCommand}"
                            Content="查询" DockPanel.Dock="Left"
                            Background="{StaticResource BrushPrimary}" Foreground="White"
                            BorderThickness="0" />
                    <Button Margin="8,0,0,0" Command="{Binding ResetFiltersCommand}"
                            Content="重置" DockPanel.Dock="Left"
                            Background="{StaticResource BrushSecondary}" Foreground="White"
                            BorderThickness="0" />
                    <Border Width="1" Height="20" Background="{StaticResource BrushPanelBorder}" Margin="12,0" DockPanel.Dock="Left" />
                    <Button Margin="0,0,0,0" Command="{Binding BatchChangeRecipeCommand}"
                            Content="批量修改配方" DockPanel.Dock="Left"
                            Background="{StaticResource BrushPrimary}" Foreground="White"
                            BorderThickness="0" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- 加载进度条 -->
        <ProgressBar Grid.Row="1" Height="3" IsIndeterminate="True"
                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Foreground="{StaticResource BrushPrimary}" Background="Transparent" />

        <!-- 中部：记录列表（铺满整行） -->
        <controls:SectionPanel Grid.Row="2" Title="试验记录列表" StatusText="{Binding PaginationStatus}" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 空数据提示 -->
                    <TextBlock Grid.Row="0" Text="暂无试验记录，请先在「数据上传」页面导入数据"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{StaticResource BrushMutedText}" FontSize="14"
                               Padding="0,40">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredRecords.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DataGrid Grid.Row="0"
                              ItemsSource="{Binding FilteredRecords}"
                              SelectedItem="{Binding SelectedRecord, Mode=TwoWay}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              SelectionMode="Extended"
                              MouseDoubleClick="DataGrid_MouseDoubleClick"
                              Style="{StaticResource IndustrialDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="40">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox IsChecked="{Binding DataContext.AllSelected, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                              Command="{Binding DataContext.ToggleAllSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="序号" Width="50" Binding="{Binding RowNumber}" />
                            <DataGridTextColumn Header="记录编号" Binding="{Binding RecordCode}" Width="180" />
                            <DataGridTextColumn Header="项目" Binding="{Binding Project.Name}" Width="140" />
                            <DataGridTextColumn Header="机组" Binding="{Binding Unit.Name}" Width="140" />
                            <DataGridTextColumn Header="对象编码" Binding="{Binding ObjectCode}" Width="*" />
                            <DataGridTextColumn Header="使用配方" Binding="{Binding RecipeName, TargetNullValue='—'}" Width="120" />
                            <DataGridTextColumn Header="测量装置" Binding="{Binding DeviceCode}" Width="160" />
                            <DataGridTextColumn Header="操作人员" Binding="{Binding Operator}" Width="120" />
                            <DataGridTextColumn Header="最终泄漏率" Binding="{Binding FinalLeakageRate, StringFormat={}{0:0.###}}" Width="130" />
                            <DataGridTextColumn Header="泄漏限值" Binding="{Binding LeakageLimit, StringFormat={}{0:0.###}, TargetNullValue='—'}" Width="120" />
                            <DataGridTextColumn Header="试验时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm}" Width="160" />
                            <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=MM-dd HH:mm}" Width="110" />
                            <DataGridTemplateColumn Header="结果" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ResultText}"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Result}" Value="{x:Static models:TestResult.Fail}">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationControl Grid.Row="1"
                            Margin="0,6,0,0"
                            HorizontalAlignment="Right"
                            CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                            TotalCount="{Binding TotalCount}"
                            PageSize="{Binding PageSize}"
                            GotoPageCommand="{Binding GoToPageCommand}" />
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 底部：过程曲线展示 + 配方参数 -->
        <controls:SectionPanel Grid.Row="4" Title="过程曲线回放 · 配方参数" StatusText="{Binding SelectedRecord.RecordCode, TargetNullValue='请选择记录', FallbackValue='请选择记录'}" StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：趋势图（5 通道 + 真实时间轴） -->
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <controls:TrendChart
                                Mode="FiveChannel"
                                TimePoints="{Binding TimeAxisPoints}"
                                PressurePoints="{Binding PressureCurvePoints}"
                                FlowPoints="{Binding FlowCurvePoints}"
                                TempPoints="{Binding TempCurvePoints}"
                                Flow2Points="{Binding Flow2CurvePoints}"
                                Pressure2Points="{Binding Pressure2CurvePoints}"
                                Visibility="{Binding HasCurveData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <!-- 空状态：无真实过程曲线时显示提示，不再伪造曲线 -->
                        <TextBlock Text="该记录无过程曲线数据"
                                   Style="{StaticResource MutedTextBlock}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding NoCurveData, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>

                    <!-- 右侧：图例 + 配方参数 -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,8,0,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="通道图例" Margin="0,0,0,10" />

                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#0758D8" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="压力P1 {0:F2}–{1:F2} MPa">
                                            <Binding Path="PressureMin" />
                                            <Binding Path="PressureMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#12A366" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="流量M1 {0:F3}–{1:F3} L/min">
                                            <Binding Path="FlowMin" />
                                            <Binding Path="FlowMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#F97316" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="温度T {0:F1}–{1:F1} ℃">
                                            <Binding Path="TempMin" />
                                            <Binding Path="TempMax" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#0EA5E9" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="流量M2 {0:F3}–{1:F3} L/min">
                                            <Binding Path="Flow2Min" />
                                            <Binding Path="Flow2Max" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Rectangle Width="16" Height="3" Fill="#8B5CF6" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Margin="8,0,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="压力P2 {0:F2}–{1:F2} MPa">
                                            <Binding Path="Pressure2Min" />
                                            <Binding Path="Pressure2Max" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- 配方参数 -->
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="配方参数" Margin="0,10,0,10" />
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="4" Padding="8,6" Background="#FAFAFA">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Text="配方名称" />
                                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding SelectedRecord.RecipeName, TargetNullValue='未关联', FallbackValue='未关联'}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Text="气密目标压" />
                                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding RecipePressure, TargetNullValue='—', StringFormat={}{0:F2} MPa}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Text="精吹目标压" />
                                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding RecipeFineBlowPressure, TargetNullValue='—', StringFormat={}{0:F2} MPa}" />
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource MutedTextBlock}" FontSize="11" Text="预期泄漏流量" />
                                    <TextBlock Grid.Column="1" FontSize="11" Text="{Binding RecipeExpectedFlow, TargetNullValue='—', StringFormat={}{0:F3} L/min}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
