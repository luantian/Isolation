<UserControl x:Class="IsolationLeakage.App.Views.Auth.UserManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:m="clr-namespace:IsolationLeakage.App.Models.Security">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：用户列表 -->
        <StackPanel Grid.Column="0">
            <controls:PanelHeader Title="用户管理" />
            <StackPanel Margin="12,8" Orientation="Horizontal">
                <TextBox Width="200" Height="30"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <Button Margin="8,0,0,0" Height="30"
                        Command="{Binding AddUserCommand}"
                        Style="{StaticResource SuccessButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="White"
                                   Text="&#xE710;"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0"
                                   Foreground="White"
                                   Text="新增" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Height="30"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Text="&#xE72C;"
                                   VerticalAlignment="Center" />
                        <TextBlock Margin="6,0,0,0" Text="刷新" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding Message}"
                           Margin="12,4,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Users}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      Margin="12,0,12,12"
                      BorderBrush="{StaticResource BrushPanelBorder}"
                      SelectionChanged="DataGrid_SelectionChanged"
                      GridLinesVisibility="Horizontal"
                      RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="100" />
                    <DataGridTextColumn Header="昵称" Binding="{Binding NickName}" Width="120" />
                    <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,2" CornerRadius="3" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushOkLight}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:UserStatus.Disabled}">
                                                    <Setter Property="Background" Value="{StaticResource BrushWarnLight}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="12" HorizontalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#065F46" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static m:UserStatus.Disabled}">
                                                        <Setter Property="Foreground" Value="#92400E" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Text>
                                            <Binding Path="StatusText" />
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- 右侧：编辑面板 -->
        <Border Grid.Column="1"
                Margin="12,0,0,0"
                Background="White"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel Margin="16">
                <TextBlock Text="用户编辑"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           Margin="0,0,0,16" />

                <TextBlock Text="用户名" FontSize="12" Foreground="{StaticResource BrushMutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" />

                <TextBlock Text="昵称" FontSize="12" Foreground="{StaticResource BrushMutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditNickName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" />

                <TextBlock Text="密码（留空不改）" FontSize="12" Foreground="{StaticResource BrushMutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" />

                <TextBlock Text="状态" FontSize="12" Foreground="{StaticResource BrushMutedText}" Margin="0,0,0,4" />
                <ComboBox SelectedValue="{Binding EditStatus}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="启用" Tag="{x:Static m:UserStatus.Enabled}" />
                    <ComboBoxItem Content="停用" Tag="{x:Static m:UserStatus.Disabled}" />
                </ComboBox>

                <TextBlock Text="角色（多选）" FontSize="12" Foreground="{StaticResource BrushMutedText}" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding RoleItems}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding RoleName}"
                                      Margin="0,2"
                                      FontSize="12"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="备注" FontSize="12" Foreground="{StaticResource BrushMutedText}" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditRemark, UpdateSourceTrigger=PropertyChanged}"
                         Height="60" Margin="0,0,0,12" AcceptsReturn="True" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存" Height="34"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource IndustrialButton}" />
                    <Button Content="取消" Height="34" Margin="12,0,0,0"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource SecondaryButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toast 通知 -->
        <controls:Toast x:Name="UserToast"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,20,0" />
    </Grid>
</UserControl>
