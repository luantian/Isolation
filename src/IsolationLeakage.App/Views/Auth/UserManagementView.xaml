<UserControl x:Class="IsolationLeakage.App.Views.Auth.UserManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        xmlns:m="clr-namespace:IsolationLeakage.App.Models.Security">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：用户列表 -->
        <StackPanel Grid.Column="0">
            <controls:PanelHeader Title="用户管理" />
            <StackPanel Margin="12,8" Orientation="Horizontal">
                <TextBox Width="200" Height="30" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,4" BorderBrush="#DDD" />
                <Button Content="刷新" Margin="8,0,0,0" Width="60" Height="30"
                        Command="{Binding RefreshCommand}" Background="#1890FF" Foreground="White" BorderThickness="0" />
                <TextBlock Text="{Binding Message}" Margin="12,4,0,0" Foreground="#666" />
            </StackPanel>
            <DataGrid ItemsSource="{Binding Users}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False"
                      SelectionMode="Single" IsReadOnly="True"
                      Margin="12,0,12,12" BorderBrush="#E0E0E0"
                      SelectionChanged="DataGrid_SelectionChanged"
                      GridLinesVisibility="Horizontal" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="用户名" Binding="{Binding UserName}" Width="100" />
                    <DataGridTextColumn Header="昵称" Binding="{Binding NickName}" Width="120" />
                    <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginTime, StringFormat=yyyy-MM-dd HH:mm}" Width="140" />
                    <DataGridTemplateColumn Header="状态" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding StatusText}"
                                        FontSize="12"
                                        Padding="8,2"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#E8F5E9" />
                                            <Setter Property="Foreground" Value="#2E7D32" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static m:UserStatus.Disabled}">
                                                    <Setter Property="Background" Value="#FFF3E0" />
                                                    <Setter Property="Foreground" Value="#E65100" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- 右侧：编辑面板 -->
        <Border Grid.Column="1" Margin="12,0,0,0"
                Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Margin="16">
                <TextBlock Text="用户编辑" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,16" />

                <TextBlock Text="用户名" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" Padding="8,4" />

                <TextBlock Text="昵称" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditNickName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" Padding="8,4" />

                <TextBlock Text="密码（留空不改）" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" Padding="8,4" />

                <TextBlock Text="状态" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <ComboBox SelectedValue="{Binding EditStatus}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="启用" Tag="{x:Static m:UserStatus.Enabled}" />
                    <ComboBoxItem Content="停用" Tag="{x:Static m:UserStatus.Disabled}" />
                </ComboBox>

                <TextBlock Text="备注" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditRemark, UpdateSourceTrigger=PropertyChanged}"
                         Height="60" Margin="0,0,0,12" Padding="8,4" AcceptsReturn="True" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存" Width="80" Height="34"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource IndustrialButton}" />
                    <Button Content="取消" Width="80" Height="34" Margin="12,0,0,0"
                            Command="{Binding CancelEditCommand}"
                            Background="{StaticResource BrushSecondary}" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Toast 通知 -->
        <controls:Toast x:Name="UserToast"
                        Grid.ColumnSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,20,20,0" />
    </Grid>
</UserControl>
