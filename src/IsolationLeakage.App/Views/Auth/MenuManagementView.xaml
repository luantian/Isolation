<UserControl x:Class="IsolationLeakage.App.Views.Auth.MenuManagementView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        xmlns:m="clr-namespace:IsolationLeakage.App.Models.Security">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：菜单树 -->
        <StackPanel Grid.Column="0">
            <controls:PanelHeader Title="菜单/权限管理" />
            <StackPanel Margin="12,8" Orientation="Horizontal">
                <Button Content="新增" Width="60" Height="30"
                        Command="{Binding AddMenuCommand}"
                        Style="{StaticResource IndustrialButton}" />
                <Button Content="刷新" Margin="8,0,0,0" Width="60" Height="30"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource IndustrialButton}" />
                <TextBlock Text="{Binding Message}" Margin="12,4,0,0" Foreground="#666" />
            </StackPanel>
            <TreeView ItemsSource="{Binding Menus}" Margin="12,0,12,12"
                      SelectedItemChanged="TreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MenuName}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding TypeText}" FontSize="11" Foreground="#999" />
                            <TextBlock Text="{Binding Perms}" FontSize="11" Foreground="#52C41A" Margin="4,0,0,0" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </StackPanel>

        <!-- 右侧：编辑面板 -->
        <Border Grid.Column="1" Margin="12,0,0,0"
                Background="White" BorderBrush="#E0E0E0" BorderThickness="1">
            <StackPanel Margin="16">
                <TextBlock Text="菜单编辑" FontSize="16" FontWeight="Bold" Foreground="#333" Margin="0,0,0,16" />

                <TextBlock Text="菜单名称" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditMenuName, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" Padding="8,4" />

                <TextBlock Text="上级菜单" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding ParentOptions}" DisplayMemberPath="MenuName"
                          SelectedValuePath="MenuId" SelectedValue="{Binding EditParentId}"
                          Height="32" Margin="0,0,0,12" />

                <TextBlock Text="类型" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <ComboBox SelectedValue="{Binding EditType}" SelectedValuePath="Tag" Height="32" Margin="0,0,0,12">
                    <ComboBoxItem Content="目录" Tag="{x:Static m:SysMenuType.Directory}" />
                    <ComboBoxItem Content="菜单" Tag="{x:Static m:SysMenuType.Menu}" />
                    <ComboBoxItem Content="按钮" Tag="{x:Static m:SysMenuType.Button}" />
                </ComboBox>

                <TextBlock Text="权限标识" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditPerms, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" Padding="8,4" />

                <TextBlock Text="路由路径" FontSize="12" Foreground="#666" Margin="0,0,0,4" />
                <TextBox Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}"
                         Height="32" Margin="0,0,0,12" Padding="8,4" />

                <CheckBox Content="可见" IsChecked="{Binding EditVisible}" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="保存" Width="80" Height="34"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource IndustrialButton}" />
                    <Button Content="取消" Width="80" Height="34" Margin="12,0,0,0"
                            Command="{Binding CancelEditCommand}"
                            Background="{StaticResource BrushSecondary}" Foreground="White" BorderThickness="0" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
