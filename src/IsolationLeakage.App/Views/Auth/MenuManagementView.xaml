<UserControl x:Class="IsolationLeakage.App.Views.Auth.MenuManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:m="clr-namespace:IsolationLeakage.App.Models.Security"
             xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels.Auth"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:MenuManagementViewModel}">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 左侧：菜单树 ==================== -->
        <controls:SectionPanel Grid.Column="0"
                               Margin="0,0,8,0"
                               Title="菜单结构"
                               StatusText="{Binding Menus.Count, StringFormat='共 {0} 项'}"
                               StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 说明文字 -->
                    <TextBlock Grid.Row="0"
                               Margin="12,12,12,8"
                               FontSize="13"
                               Foreground="{StaticResource BrushMutedText}"
                               Text="维护系统菜单树，包括目录、菜单项和按钮权限。点击节点后在右侧编辑属性。"
                               TextWrapping="Wrap" />

                    <!-- 工具栏 -->
                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="{StaticResource BrushPanelBorder}"
                            BorderThickness="0,0,0,1"
                            Padding="12,10">
                        <StackPanel Orientation="Horizontal">
                            <Button Height="30"
                                    Command="{Binding AddMenuCommand}"
                                    Style="{StaticResource IndustrialButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Foreground="White"
                                               Text="&#xE710;"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0"
                                               Foreground="White"
                                               Text="新增" />
                                </StackPanel>
                            </Button>
                            <Button Height="30"
                                    Margin="8,0,0,0"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource SecondaryButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="12"
                                               Text="&#xE72C;"
                                               VerticalAlignment="Center" />
                                    <TextBlock Margin="6,0,0,0" Text="刷新" />
                                </StackPanel>
                            </Button>
                            <Border Width="1"
                                    Height="18"
                                    Margin="12,0"
                                    Background="{StaticResource BrushPanelBorder}" />
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="{Binding Message}" />
                        </StackPanel>
                    </Border>

                    <!-- 菜单树 -->
                    <TreeView Grid.Row="2"
                              Margin="8,8,8,8"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemsSource="{Binding Menus}"
                              SelectedItemChanged="TreeView_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 类型图标 -->
                                    <Border Grid.Column="0"
                                            Width="24"
                                            Height="22"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BrushPrimaryLighter}"
                                            CornerRadius="4">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   Text="{Binding TypeText}" />
                                    </Border>

                                    <!-- 菜单名 -->
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource BrushText}"
                                               Text="{Binding MenuName}" />

                                    <!-- 权限标识（标签） -->
                                    <Border Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource BrushOkLight}"
                                            CornerRadius="3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Perms}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Perms}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="#065F46"
                                                   Text="{Binding Perms}" />
                                    </Border>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- ==================== 右侧：编辑面板 ==================== -->
        <controls:SectionPanel Grid.Column="1"
                               Margin="8,0,0,0"
                               Title="菜单属性"
                               StatusText="编辑"
                               StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <!-- 未选择状态（IsEditing=False 时显示） -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="72"
                                Height="72"
                                Margin="0,0,0,18"
                                Background="{StaticResource BrushPrimaryLighter}"
                                CornerRadius="36">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="32"
                                       Foreground="{StaticResource BrushPrimary}"
                                       Text="&#xE712;" />
                        </Border>
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{StaticResource BrushText}"
                                   Text="请在左侧菜单树中选择一个节点" />
                        <TextBlock Margin="0,6,0,0"
                                   HorizontalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="或点击上方「新增」按钮创建菜单" />
                    </StackPanel>

                    <!-- 编辑表单（IsEditing=True 时显示） -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel Margin="16,12,16,16">

                            <!-- ===== 基本信息 ===== -->
                            <TextBlock Margin="0,0,0,10"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="基本信息" />

                            <!-- 菜单名称 -->
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="菜单名称 *" />
                            <TextBox Height="32"
                                     Margin="0,0,0,10"
                                     Text="{Binding EditMenuName, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- 上级菜单 + 类型 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushMutedText}"
                                               Text="上级菜单" />
                                    <ComboBox Height="32"
                                              DisplayMemberPath="MenuName"
                                              ItemsSource="{Binding ParentOptions}"
                                              SelectedValue="{Binding EditParentId}"
                                              SelectedValuePath="MenuId" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushMutedText}"
                                               Text="类型" />
                                    <ComboBox Height="32"
                                              SelectedValue="{Binding EditType}"
                                              SelectedValuePath="Tag">
                                        <ComboBoxItem Content="📁 目录" Tag="{x:Static m:SysMenuType.Directory}" />
                                        <ComboBoxItem Content="📄 菜单" Tag="{x:Static m:SysMenuType.Menu}" />
                                        <ComboBoxItem Content="🔘 按钮" Tag="{x:Static m:SysMenuType.Button}" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- 排序 -->
                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="排序（数字越小越靠前）" />
                            <TextBox Width="120"
                                     Height="32"
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,12"
                                     Text="{Binding EditSort, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- 分隔线 -->
                            <Separator Margin="0,4,0,14" />

                            <!-- ===== 路径配置 ===== -->
                            <TextBlock Margin="0,0,0,10"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="路径配置" />

                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="路由路径" />
                            <TextBox Height="32"
                                     Margin="0,0,0,10"
                                     FontFamily="{StaticResource FontMono}"
                                     Text="{Binding EditPath, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- 组件路径 + 图标 -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushMutedText}"
                                               Text="组件路径" />
                                    <TextBox Height="32"
                                             FontFamily="{StaticResource FontMono}"
                                             Text="{Binding EditComponent, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4"
                                               FontSize="12"
                                               Foreground="{StaticResource BrushMutedText}"
                                               Text="图标" />
                                    <TextBox Height="32"
                                             Text="{Binding EditIcon, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </Grid>

                            <!-- 分隔线 -->
                            <Separator Margin="0,4,0,14" />

                            <!-- ===== 权限与其他 ===== -->
                            <TextBlock Margin="0,0,0,10"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushText}"
                                       Text="权限与其他" />

                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="权限标识（如 system:user:add）" />
                            <TextBox Height="32"
                                     Margin="0,0,0,10"
                                     FontFamily="{StaticResource FontMono}"
                                     Text="{Binding EditPerms, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Margin="0,4,0,12"
                                      Content="在菜单中可见"
                                      FontSize="13"
                                      IsChecked="{Binding EditVisible}" />

                            <TextBlock Margin="0,0,0,4"
                                       FontSize="12"
                                       Foreground="{StaticResource BrushMutedText}"
                                       Text="备注" />
                            <TextBox Height="60"
                                     Margin="0,0,0,14"
                                     AcceptsReturn="True"
                                     Text="{Binding EditRemark, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap" />

                            <!-- 分隔线 -->
                            <Separator Margin="0,0,0,14" />

                            <!-- 操作按钮 -->
                            <StackPanel Orientation="Horizontal">
                                <Button Height="32"
                                        Command="{Binding SaveCommand}"
                                        Style="{StaticResource IndustrialButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   Text="&#xE74E;"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Margin="6,0,0,0"
                                                   Foreground="White"
                                                   Text="保存" />
                                    </StackPanel>
                                </Button>
                                <Button Height="32"
                                        Margin="8,0,0,0"
                                        Command="{Binding CancelEditCommand}"
                                        Content="取消"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
