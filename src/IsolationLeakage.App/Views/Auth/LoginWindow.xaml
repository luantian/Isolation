<Window x:Class="IsolationLeakage.App.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels.Auth"
        Width="400"
        Height="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <!-- 主容器 -->
    <Border Background="White"
            CornerRadius="8"
            MouseDown="Border_MouseDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.15" ShadowDepth="0" Color="#000000" />
        </Border.Effect>

        <Grid>
            <!-- 顶部蓝色装饰条 -->
            <Border Height="4"
                    VerticalAlignment="Top"
                    CornerRadius="8,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Offset="0" Color="#0B63E5" />
                        <GradientStop Offset="1" Color="#2563EB" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <StackPanel>
                <!-- 关闭按钮 -->
                <Button Content="×"
                        FontSize="18"
                        Foreground="#94A3B8"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="36"
                        Height="36"
                        Cursor="Hand"
                        Padding="0"
                        Margin="0,12,12,0"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border x:Name="Root"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="4">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="#F1F5F9" />
                                                <Setter Property="Foreground" Value="#475569" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Logo + 标题 -->
                <StackPanel HorizontalAlignment="Center" Margin="0,20,0,32">
                    <!-- Logo -->
                    <Border Width="56"
                            Height="56"
                            CornerRadius="12"
                            Background="#F0F7FF"
                            HorizontalAlignment="Center">
                        <TextBlock Text="🏭"
                                   FontSize="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <!-- 标题 -->
                    <TextBlock Text="安全壳隔离阀泄漏率"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               HorizontalAlignment="Center"
                               Margin="0,16,0,4" />
                    <TextBlock Text="数据管理系统"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#1E293B"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 表单区域 -->
                <StackPanel Margin="40,0">
                    <!-- 用户名 -->
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="用户名"
                                   FontSize="13"
                                   Foreground="#475569"
                                   Margin="0,0,0,6" />
                        <TextBox Height="40"
                                 Padding="12,0"
                                 FontSize="14"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 Background="#F8FAFC"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="TextBox_KeyDown">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  VerticalAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#CBD5E1" />
                                                    </Trigger>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#0B63E5" />
                                                        <Setter TargetName="Root" Property="Background" Value="White" />
                                                        <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>

                    <!-- 密码 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="密码"
                                   FontSize="13"
                                   Foreground="#475569"
                                   Margin="0,0,0,6" />
                        <PasswordBox x:Name="PwdBox"
                                     Height="40"
                                     Padding="12,0"
                                     FontSize="14"
                                     BorderBrush="#E2E8F0"
                                     BorderThickness="1"
                                     Background="#F8FAFC">
                            <PasswordBox.Style>
                                <Style TargetType="{x:Type PasswordBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type PasswordBox}">
                                                <Border x:Name="Root"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  VerticalAlignment="Center"
                                                                  VerticalContentAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#CBD5E1" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter TargetName="Root" Property="BorderBrush" Value="#0B63E5" />
                                                        <Setter TargetName="Root" Property="Background" Value="White" />
                                                        <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                    </StackPanel>

                    <!-- 错误提示 -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"
                               LineHeight="18"
                               Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- 登录中提示 -->
                    <TextBlock Text="正在登录..."
                               Foreground="#0B63E5"
                               FontSize="12"
                               Margin="0,0,0,12"
                               Visibility="{Binding IsLoggingIn, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- 登录按钮 -->
                    <Button Content="登 录"
                            Height="40"
                            FontSize="14"
                            FontWeight="Medium"
                            Foreground="White"
                            Cursor="Hand"
                            Click="LoginButton_Click"
                            IsEnabled="{Binding !IsLoggingIn}"
                            Margin="0,0,0,20">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="#0B63E5" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border x:Name="Root"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#084CBA" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="#1E40AF" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Root" Property="Background" Value="#94A3B8" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
