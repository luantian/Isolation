<Window x:Class="IsolationLeakage.App.Views.Auth.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels.Auth"
        Width="420"
        Height="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <Window.DataContext>
        <vm:LoginViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="LoginShadowStyle" TargetType="Border">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect ShadowDepth="3" Direction="270" BlurRadius="15" Opacity="0.15" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#F5F6FA" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
        <Style x:Key="PwdBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#F5F6FA" />
            <Setter Property="BorderBrush" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#333" />
        </Style>
        <Style x:Key="LoginBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#1890FF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40A9FF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#999" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0" />
                    <Setter Property="Foreground" Value="#333" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 带阴影的圆角卡片 -->
    <Border Background="White" Style="{StaticResource LoginShadowStyle}" MouseDown="Border_MouseDown">
        <StackPanel>
            <!-- 关闭按钮 -->
            <Grid Height="40" Margin="12,0,0,0">
                <Button Content="×" FontSize="24" Foreground="#999" Background="Transparent"
                        BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="CloseButton_Click" Cursor="Hand" Padding="8,0" />
            </Grid>

            <!-- Logo + 标题 -->
            <StackPanel HorizontalAlignment="Center" Margin="0,10,0,20">
                <TextBlock Text="🏭" FontSize="36" HorizontalAlignment="Center" />
                <TextBlock Text="智能安全壳隔离阀泄漏率数据管理软件"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="#333"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0" />
                <TextBlock Text="用户登录"
                           FontSize="13"
                           Foreground="#999"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 表单 -->
            <StackPanel Margin="48,0,48,0">
                <!-- 用户名 -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="用户名" FontSize="13" Foreground="#666" Margin="0,0,0,6" />
                    <TextBox Style="{StaticResource InputBoxStyle}"
                             Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="TextBox_KeyDown" />
                </StackPanel>

                <!-- 密码 -->
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="密码" FontSize="13" Foreground="#666" Margin="0,0,0,6" />
                    <PasswordBox x:Name="PwdBox"
                                 Style="{StaticResource PwdBoxStyle}" />
                </StackPanel>

                <!-- 错误提示 -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#FF4D4F"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- 登录中提示 -->
                <TextBlock Text="正在登录..."
                           Foreground="#1890FF"
                           FontSize="13"
                           Margin="0,0,0,16"
                           Visibility="{Binding IsLoggingIn, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- 登录按钮 -->
                <Button Content="登 录"
                        Style="{StaticResource LoginBtnStyle}"
                        Click="LoginButton_Click"
                        IsEnabled="{Binding !IsLoggingIn}"
                        Margin="0,0,0,12" />

                <!-- 提示 -->
                <TextBlock Text="默认账号：admin / admin123"
                           FontSize="12"
                           Foreground="#BBB"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
