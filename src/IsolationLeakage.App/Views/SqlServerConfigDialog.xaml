<Window x:Class="IsolationLeakage.App.Views.SqlServerConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="数据库连接配置"
        Width="520"
        Height="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushWorkspace}">
    <Border Padding="24" Background="{StaticResource BrushWorkspace}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Padding="14,12"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushPrimary}"
                               Text="🔧 数据库连接配置" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource BrushMutedText}"
                               Text="请选择或输入 SQL Server 实例名，然后点击测试连接"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">

                <!-- 手动输入 -->
                <TextBlock Margin="0,0,0,6"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           Text="SQL Server 实例地址：" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstanceTextBox"
                             Grid.Column="0"
                             Height="30"
                             Padding="8,4"
                             VerticalContentAlignment="Center"
                             FontFamily="{StaticResource FontMono}"
                             FontSize="13"
                             TextChanged="InstanceTextBox_TextChanged" />
                    <Button x:Name="TestButton"
                            Grid.Column="1"
                            Width="88"
                            Height="30"
                            Margin="8,0,0,0"
                            Click="TestConnection_Click"
                            Content="测试连接"
                            IsEnabled="False"
                            Style="{StaticResource IndustrialButton}" />
                </Grid>

                <!-- 测试结果 -->
                <TextBlock x:Name="TestResultText"
                           Margin="0,8,0,0"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </StackPanel>

            <!-- 分割线 -->
            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="0,1,0,0" />

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="3"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="88"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"
                        Content="取消"
                        Style="{StaticResource IndustrialButton}"
                        Background="{StaticResource BrushSecondary}"
                        Foreground="White"
                        BorderThickness="0" />
                <Button x:Name="ConfirmButton"
                        Width="88"
                        Click="Confirm_Click"
                        Content="确定"
                        IsEnabled="False"
                        Style="{StaticResource IndustrialButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
