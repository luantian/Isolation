<Window x:Class="IsolationLeakage.App.Views.DevicePickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择测量装置"
        Width="460"
        Height="340"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushWorkspace}">
    <Border Padding="24" Background="{StaticResource BrushWorkspace}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Border Grid.Row="0"
                    Padding="14,12"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource BrushPrimary}"
                               Text="🔧 选择测量装置" />
                    <TextBlock x:Name="HintText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource BrushMutedText}"
                               Text="数据文件中未包含测量装置编号，请为本次导入选择一台装置。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 内容区 -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                <TextBlock Margin="0,0,0,6"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource BrushText}"
                           Text="测量装置：" />
                <ComboBox x:Name="DeviceComboBox"
                          Height="32"
                          Padding="8,4"
                          VerticalContentAlignment="Center"
                          SelectionChanged="DeviceComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DeviceCode}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontWeight="SemiBold" />
                                <TextBlock Text=" — " Foreground="{StaticResource BrushMutedText}" />
                                <TextBlock Text="{Binding DeviceName}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <!-- 分割线 -->
            <Border Grid.Row="2"
                    Margin="0,8,0,0"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="0,1,0,0" />

            <!-- 底部按钮 -->
            <StackPanel Grid.Row="3"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="88"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"
                        Content="取消"
                        Style="{StaticResource IndustrialButton}"
                        Background="{StaticResource BrushSecondary}"
                        Foreground="White"
                        BorderThickness="0" />
                <Button x:Name="ConfirmButton"
                        Width="88"
                        Click="Confirm_Click"
                        Content="确定"
                        IsEnabled="False"
                        Style="{StaticResource IndustrialButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
