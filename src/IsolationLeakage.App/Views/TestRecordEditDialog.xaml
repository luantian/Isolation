<Window x:Class="IsolationLeakage.App.Views.TestRecordEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑试验记录"
        Width="500"
        Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BrushWorkspace}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 编辑内容 -->
        <StackPanel Grid.Row="0">
            <!-- 试验路径选择 -->
            <TextBlock Text="试验路径："
                       Style="{StaticResource MutedTextBlock}"
                       Margin="0,0,0,8" />
            <ComboBox ItemsSource="{Binding AvailableRecipes}"
                      SelectedItem="{Binding SelectedRecipe}"
                      DisplayMemberPath="RecipeName"
                      Height="32"
                      FontSize="14"
                      Margin="0,0,0,20" />

            <!-- 备注输入 -->
            <TextBlock Text="备注："
                       Style="{StaticResource MutedTextBlock}"
                       Margin="0,0,0,8" />
            <TextBox Text="{Binding Remark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="120"
                     FontSize="13"
                     FontFamily="{StaticResource FontMain}"
                     Padding="6,3" />
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="取消"
                    Width="80"
                    Height="32"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,12,0" />
            <Button Content="确定"
                    Width="80"
                    Height="32"
                    Click="Confirm_Click"
                    Style="{StaticResource IndustrialButton}" />
        </StackPanel>
    </Grid>
</Window>
