<UserControl x:Class="IsolationLeakage.App.Views.TestObjectPathManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:models="clr-namespace:IsolationLeakage.App.Models">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部操作栏：用 DockPanel 替代嵌套 Grid -->
        <Border Grid.Row="0" Padding="10,7" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
            <DockPanel LastChildFill="False">
                <Border Width="34" Height="32" Margin="0,0,8,0" Background="{StaticResource BrushPrimary}" BorderBrush="{StaticResource BrushPrimaryDark}" BorderThickness="1" DockPanel.Dock="Left">
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE707;" />
                </Border>
                <TextBlock Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}" Text="项目" DockPanel.Dock="Left" />
                <ComboBox MinWidth="220" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject, Mode=TwoWay}" DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                <TextBlock Margin="18,0,8,0" Style="{StaticResource MutedTextBlock}" Text="机组" DockPanel.Dock="Left" />
                <ComboBox MinWidth="220" ItemsSource="{Binding Units}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}" DockPanel.Dock="Left" Style="{StaticResource ScopeComboBox}" />
                <TextBlock Margin="18,0,8,0" Style="{StaticResource MutedTextBlock}" Text="搜索" DockPanel.Dock="Left" />
                <StackPanel Margin="0,0,0,0" Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBox Width="260" Style="{StaticResource ScopeTextBox}" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Width="80" Margin="10,0,0,0" Click="Locate_Click" Content="定位" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 主内容区：左侧树 + 右侧详情 -->
        <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="True">
            <!-- 左侧路径树 -->
            <controls:SectionPanel Width="360" Margin="0,0,10,0" Title="试验对象路径树" StatusText="路径" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left">
                <controls:SectionPanel.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" Text="{Binding CurrentScopeText}" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushMutedText}" Text="下方树仅维护系统、贯穿件、阀门、其他密封性部件路径。" />
                        </StackPanel>
                        <TreeView Grid.Row="1"
                                  ItemContainerStyle="{StaticResource IndustrialTreeViewItem}"
                                  ItemsSource="{Binding PathTree}"
                                  SelectedItemChanged="PathTree_SelectedItemChanged"
                                  Style="{StaticResource IndustrialTreeView}">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type models:TestObjectPathNode}" ItemsSource="{Binding Children}">
                                    <StackPanel Height="28" Orientation="Horizontal">
                                        <Border Width="20" Height="20" Margin="0,0,6,0" VerticalAlignment="Center" Background="#EEF4FF" BorderBrush="#D8E6FF" BorderThickness="1">
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="{StaticResource BrushPrimary}" Text="&#xE8B7;" />
                                        </Border>
                                        <TextBlock VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                        <TextBlock Grid.Row="2" Margin="0,8,0,0" Foreground="{StaticResource BrushMutedText}" Text="{Binding LocateMessage}" TextWrapping="Wrap" />
                        <UniformGrid Grid.Row="3" Columns="2" Margin="0,10,0,0">
                            <Button Margin="0,0,6,6" Click="CreateSystem_Click" Content="新建系统" IsEnabled="{Binding CanCreateSystem}" />
                            <Button Margin="0,0,0,6" Click="CreatePenetration_Click" Content="新建贯穿件" IsEnabled="{Binding CanCreatePenetration}" />
                            <Button Margin="0,0,6,0" Click="CreateValve_Click" Content="新建阀门" IsEnabled="{Binding CanCreateValve}" />
                            <Button Click="CreateOtherComponent_Click" Content="新建其他部件" IsEnabled="{Binding CanCreateOtherComponent}" />
                        </UniformGrid>
                    </Grid>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- 右侧：详情 + 数据概况（用 StackPanel 替代嵌套 Grid） -->
            <StackPanel DockPanel.Dock="Right">
                <controls:SectionPanel Title="{Binding DetailTitle, Mode=OneWay}" StatusText="{Binding NodeTypeText, Mode=OneWay}" StatusBrush="{StaticResource BrushPrimary}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.15*" />
                                <ColumnDefinition Width="0.85*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="36" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource MutedTextBlock}" Text="节点编号" />
                                <TextBlock Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding SelectedNode.Code, Mode=OneWay}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlock}" Text="节点名称" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding SelectedNode.Name, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource MutedTextBlock}" Text="{Binding TypeLabel, Mode=OneWay}" Visibility="{Binding ValveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding TypeValue, Mode=OneWay}" Visibility="{Binding ValveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Style="{StaticResource MutedTextBlock}" Text="{Binding TypeLabel, Mode=OneWay}" Visibility="{Binding OtherComponentVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding TypeValue, Mode=OneWay}" Visibility="{Binding OtherComponentVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource MutedTextBlock}" Text="{Binding LimitLabel, Mode=OneWay}" Visibility="{Binding PenetrationVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding LeakageLimitText, Mode=OneWay}" Visibility="{Binding PenetrationVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource MutedTextBlock}" Text="{Binding LimitLabel, Mode=OneWay}" Visibility="{Binding ValveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding LeakageLimitText, Mode=OneWay}" Visibility="{Binding ValveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Style="{StaticResource MutedTextBlock}" Text="{Binding LimitLabel, Mode=OneWay}" Visibility="{Binding OtherComponentVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding LeakageLimitText, Mode=OneWay}" Visibility="{Binding OtherComponentVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource MutedTextBlock}" Text="{Binding PressureLabel, Mode=OneWay}" Visibility="{Binding ValveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding TestPressureText, Mode=OneWay}" Visibility="{Binding ValveVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" Style="{StaticResource MutedTextBlock}" Text="{Binding PressureLabel, Mode=OneWay}" Visibility="{Binding OtherComponentVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource IndustrialTextBlock}" Text="{Binding TestPressureText, Mode=OneWay}" Visibility="{Binding OtherComponentVisibility, Mode=OneWay}" />
                                <TextBlock Grid.Row="5" Margin="0,7,0,0" VerticalAlignment="Top" Style="{StaticResource MutedTextBlock}" Text="备注" />
                                <Border Grid.Row="5" Grid.Column="1" MinHeight="78" Padding="8,6" Background="#F7F9FC" BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
                                    <TextBlock Text="{Binding SelectedNode.Remark, Mode=OneWay}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>
                            <Border Grid.Column="1" Margin="16,0,0,0" Padding="12" Background="#F7F9FC">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="当前节点操作" />
                                    <Separator Margin="0,12,0,12" />
                                    <controls:DetailRow Label="节点类型" LabelWidth="76" Value="{Binding NodeTypeText}" />
                                    <controls:DetailRow Label="可新建" LabelWidth="76" Value="{Binding AvailableCreateText}" />
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource BrushMutedText}" Text="{Binding NodeOperationDescription}" TextWrapping="Wrap" />
                                    <Separator Margin="0,12,0,12" />
                                    <controls:StatusDot Text="已有历史数据的节点不直接删除" DotBrush="{StaticResource BrushWarn}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>

                <controls:SectionPanel Margin="0,10,0,0" Title="当前路径数据概况" StatusText="轻量概览" StatusBrush="{StaticResource BrushOk}">
                    <controls:SectionPanel.PanelContent>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <controls:DetailRow Label="最近试验时间" LabelWidth="120" Value="{Binding SelectedNode.LatestTestTime, Mode=OneWay}" />
                                <controls:DetailRow Label="最近泄漏率" LabelWidth="120" Value="{Binding SelectedNode.LatestLeakageRate, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <controls:DetailRow Label="最近判定结果" LabelWidth="120" Value="{Binding SelectedNode.LatestResult, Mode=OneWay}" />
                                <controls:DetailRow Label="累计试验次数" LabelWidth="120" Value="{Binding SelectedNode.TotalTests, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <controls:DetailRow Label="不合格次数" LabelWidth="120" Value="{Binding SelectedNode.FailedTests, Mode=OneWay}" />
                                <controls:DetailRow Label="最近导入装置" LabelWidth="120" Value="{Binding SelectedNode.LatestDevice, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </controls:SectionPanel.PanelContent>
                </controls:SectionPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>
