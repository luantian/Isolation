<UserControl x:Class="IsolationLeakage.App.Views.TestObjectPathManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:models="clr-namespace:IsolationLeakage.App.Models.Database"
             xmlns:local="clr-namespace:IsolationLeakage.App.Views">
    <UserControl.Resources>
        <!-- 节点类型图标转换器 -->
        <local:NodeTypeToGlyphConverter x:Key="NodeTypeToGlyphConverter" />
        <local:NodeTypeToIconBrushConverter x:Key="NodeTypeToIconBrushConverter" />
        <local:NodeTypeToBadgeBrushConverter x:Key="NodeTypeToBadgeBrushConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <!-- Tab 标题样式（图标+文字） - 与系统设置页面统一 -->
        <Style x:Key="TabHeaderStyle" TargetType="{x:Type StackPanel}">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="TabHeaderIconStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TabHeaderTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 顶部操作栏 ===== -->
        <Border Grid.Row="0"
                Padding="14,10"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="1">
            <DockPanel LastChildFill="False">
                <!-- 范围选择区 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Margin="0,0,0,0"
                               Style="{StaticResource MutedTextBlock}"
                               Text="项目" />
                    <ComboBox MinWidth="200"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              Style="{StaticResource ScopeComboBox}" />
                    <TextBlock Margin="16,0,0,0"
                               Style="{StaticResource MutedTextBlock}"
                               Text="机组" />
                    <ComboBox MinWidth="200"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding Units}"
                              SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                              Style="{StaticResource ScopeComboBox}" />
                    <!-- 按文档导入：紧邻机组选择（xlsx 会按文档标题自动归属机组，页面选择仅作新建机组时的项目归属） -->
                    <Button MinWidth="110"
                            Margin="12,0,0,0"
                            Padding="10,0"
                            Command="{Binding ImportDocumentCommand}"
                            Content="📄 按文档导入"
                            ToolTip="选择实验报表 CSV 或实验记录表 xlsx，逐行生成试验记录，并按&quot;系统→阀门&quot;自动创建缺失的路径节点（xlsx 自动识别机组归属；限值 Ncm³/h→Nml/min、试验压力 KPa→MPa）"
                            IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBooleanConverter}}" />
                </StackPanel>
                <!-- 搜索区 -->
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right"
                            HorizontalAlignment="Right">
                    <TextBox Width="240"
                             Style="{StaticResource ScopeTextBox}"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Width="72"
                            Margin="8,0,0,0"
                            Command="{Binding LocateCommand}"
                            Content="搜索" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== 主内容区：左侧树 + 右侧详情 + 统计概览 ===== -->
        <DockPanel Grid.Row="1"
                   Margin="0,12,0,0"
                   LastChildFill="True">

            <!-- ===== 左侧试验对象树 ===== -->
            <controls:SectionPanel Width="380"
                                   Margin="0,0,14,0"
                                   Title="试验对象树"
                                   StatusText="{Binding CurrentScopeText}"
                                   StatusBrush="{StaticResource BrushPrimary}"
                                   DockPanel.Dock="Left">
                <controls:SectionPanel.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 路径树 -->
                            <TreeView Grid.Row="0"
                                  ItemsSource="{Binding PathTree}"
                                  SelectedItemChanged="PathTree_SelectedItemChanged"
                                  Style="{StaticResource IndustrialTreeView}"
                                  ItemContainerStyle="{StaticResource IndustrialTreeViewItem}">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type models:TestObjectPathNode}"
                                                          ItemsSource="{Binding Children}">
                                    <StackPanel Height="30" Orientation="Horizontal">
                                        <!-- 节点类型图标 -->
                                        <Border Width="22"
                                                Height="22"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Background="{Binding NodeType, Converter={StaticResource NodeTypeToIconBrushConverter}}"
                                                BorderBrush="{Binding NodeType, Converter={StaticResource NodeTypeToIconBrushConverter}}"
                                                BorderThickness="1">
                                        <ContentControl HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Content="{Binding NodeType, Converter={StaticResource NodeTypeToGlyphConverter}}" />
                                        </Border>
                                        <!-- 节点名称 -->
                                        <TextBlock VerticalAlignment="Center"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>

                        <!-- 新建按钮组 -->
                        <Border Grid.Row="1"
                                Margin="0,10,0,0"
                                Padding="8"
                                Background="#F7F9FC"
                                BorderBrush="{StaticResource BrushPanelBorder}"
                                BorderThickness="1">
                                    <StackPanel>
                                <TextBlock Margin="0,0,0,8"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text="快速新建" />
                                <UniformGrid Columns="2" Margin="0,0,0,-4">
                                    <Button Margin="0,0,4,8"
                                            Command="{Binding CreateSystemCommand}"
                                            Content="🏗 新建系统"
                                            Style="{StaticResource QuickCreateButton}" />
                                    <Button Margin="4,0,0,8"
                                            Command="{Binding CreatePenetrationCommand}"
                                            Content="🔩 新建贯穿件"
                                            Style="{StaticResource QuickCreateButton}" />
                                    <Button Margin="0,0,4,4"
                                            Command="{Binding CreateValveCommand}"
                                            Content="🔧 新建阀门"
                                            Style="{StaticResource QuickCreateButton}" />
                                    <Button Margin="4,0,0,4"
                                            Command="{Binding CreateOtherComponentCommand}"
                                            Content="⚙ 新建其他部件"
                                            Style="{StaticResource QuickCreateButton}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <!-- ===== 右侧：节点详情 ===== -->
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                            <!-- 1. 节点详情面板 -->
                            <controls:SectionPanel Title="{Binding DetailTitle, Mode=OneWay}"
                                                   StatusText="{Binding NodeTypeText, Mode=OneWay}"
                                                   StatusBrush="{StaticResource BrushPrimary}">
                                <controls:SectionPanel.PanelContent>
                                    <Grid>
                                        <!-- 空状态 -->
                                        <Border Padding="40,30"
                                                Background="#F7F9FC"
                                                Visibility="{Binding HasNoSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="48"
                                                           Foreground="{StaticResource BrushMutedText}"
                                                           Text="&#xE8B7;" />
                                                <TextBlock Margin="0,12,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource BrushText}"
                                                           Text="请选择节点" />
                                                <TextBlock Margin="0,6,0,0"
                                                           HorizontalAlignment="Center"
                                                           FontSize="12"
                                                           Foreground="{StaticResource BrushMutedText}"
                                                           Text="从左侧树中选择一个节点以查看详情" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 节点详情内容 -->
                                        <Grid Visibility="{Binding HasSelectedNode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Padding="20,16"
                                                    Background="#FAFBFD"
                                                    BorderBrush="{StaticResource BrushPanelBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="32" />
                                                        <RowDefinition Height="32" />
                                                        <RowDefinition Height="32" />
                                                        <RowDefinition Height="32" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!-- 第1行：节点编号 + 节点名称 -->
                                                    <TextBlock Style="{StaticResource MutedTextBlock}" Text="节点编号" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontMono}" FontSize="14"
                                                               FontWeight="SemiBold" Foreground="{StaticResource BrushText}"
                                                               Text="{Binding SelectedNode.Code, Mode=OneWay}" />
                                                    <TextBlock Grid.Column="3" Style="{StaticResource MutedTextBlock}" Text="节点名称" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="4" VerticalAlignment="Center"
                                                               FontSize="14" Foreground="{StaticResource BrushText}"
                                                               Text="{Binding SelectedNode.Name, Mode=OneWay}" />

                                                    <!-- 第2行：节点类型 + 类型字段 -->
                                                    <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlock}" Text="节点类型" VerticalAlignment="Center" />
                                                    <Border Grid.Row="1" Grid.Column="1" Width="70" Height="20"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                                            Background="{Binding SelectedNode.NodeType, Converter={StaticResource NodeTypeToBadgeBrushConverter}}"
                                                            CornerRadius="3">
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                                   Text="{Binding NodeTypeText}" />
                                                    </Border>
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Style="{StaticResource MutedTextBlock}"
                                                               Text="{Binding TypeFieldLabel}" VerticalAlignment="Center"
                                                               Visibility="{Binding HasTypeField, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Grid.Row="1" Grid.Column="4" VerticalAlignment="Center"
                                                               FontSize="14" Foreground="{StaticResource BrushText}"
                                                               Text="{Binding SelectedNodeTypeValue}"
                                                               Visibility="{Binding HasTypeField, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <!-- 第3行：泄漏率限值 + 试验压力 -->
                                                    <TextBlock Grid.Row="2" Style="{StaticResource MutedTextBlock}" Text="泄漏率限值" VerticalAlignment="Center"
                                                               Visibility="{Binding HasLeakageLimit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="1" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontMono}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"
                                                               Text="{Binding LeakageLimitText}"
                                                               Visibility="{Binding HasLeakageLimit, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="3" Style="{StaticResource MutedTextBlock}" Text="试验压力" VerticalAlignment="Center"
                                                               Visibility="{Binding HasTestPressure, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                                                               FontFamily="{StaticResource FontMono}" FontSize="13"
                                                               FontWeight="SemiBold" Foreground="{StaticResource BrushWarn}"
                                                               Text="{Binding TestPressureText}"
                                                               Visibility="{Binding HasTestPressure, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                                    <!-- 第4行：父节点 + 可新建 -->
                                                    <TextBlock Grid.Row="3" Style="{StaticResource MutedTextBlock}" Text="父节点" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="3" Grid.Column="1" VerticalAlignment="Center"
                                                               FontSize="14" Foreground="{StaticResource BrushText}"
                                                               Text="{Binding ParentNodeDisplay}" />
                                                    <TextBlock Grid.Row="3" Grid.Column="3" Style="{StaticResource MutedTextBlock}" Text="可新建" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="3" Grid.Column="4" VerticalAlignment="Center"
                                                               FontSize="14" Foreground="{StaticResource BrushText}"
                                                               Text="{Binding CreatableNodeTypesText}" />

                                                    <!-- 第5行：备注（跨全列） -->
                                                    <TextBlock Grid.Row="4" Grid.ColumnSpan="5" Margin="0,12,0,0" VerticalAlignment="Top"
                                                               Style="{StaticResource MutedTextBlock}" Text="备注" />
                                                    <Border Grid.Row="5" Grid.ColumnSpan="5" MinHeight="36" Margin="0,6,0,0"
                                                            Padding="8,6" Background="White"
                                                            BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1"
                                                            CornerRadius="4">
                                                        <TextBlock FontSize="14" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource BrushMutedText}"
                                                                   Text="{Binding SelectedNode.Remark, Mode=OneWay}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>

                                                    <!-- 第6行：消息提示（跨全列） -->
                                                    <Border Grid.Row="6" Grid.ColumnSpan="5" Margin="0,12,0,0" Padding="10,8"
                                                            Background="{StaticResource BrushSurface}"
                                                            BorderThickness="0" CornerRadius="4"
                                                            Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <StackPanel>
                                                            <!-- 导入进度条 -->
                                                            <ProgressBar Height="4" Margin="0,0,0,8"
                                                                         IsIndeterminate="True"
                                                                         Foreground="{StaticResource BrushPrimary}"
                                                                         Background="Transparent"
                                                                         Visibility="{Binding IsImporting, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                            <TextBlock FontSize="13" TextWrapping="Wrap">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding MessageType}" Value="1">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding MessageType}" Value="2">
                                                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                                <TextBlock.Text>
                                                                    <Binding Path="Message" />
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- 第7行：操作按钮（跨全列） -->
                                                    <StackPanel Grid.Row="7" Grid.ColumnSpan="5" Margin="0,16,0,0"
                                                                Orientation="Horizontal" HorizontalAlignment="Left">
                                                        <Button MinWidth="100" Height="32" Margin="0,0,8,0" Padding="10,0"
                                                                Command="{Binding EditNodeCommand}" Content="✏ 修改节点"
                                                                FontSize="13" ToolTip="{Binding DeleteButtonToolTip}" />
                                                        <Button MinWidth="100" Height="32" Margin="0,0,8,0" Padding="10,0"
                                                                Command="{Binding ImportDataCommand}" Content="📥 导入数据"
                                                                FontSize="13"
                                                                IsEnabled="{Binding IsImporting, Converter={StaticResource InverseBooleanConverter}}" />
                                                        <Button MinWidth="100" Height="32" Margin="0,0,8,0" Padding="10,0"
                                                                Command="{Binding ExportDataCommand}" Content="📤 导出数据"
                                                                FontSize="13" />
                                                        <Button MinWidth="100" Height="32" Padding="10,0"
                                                                Command="{Binding DeleteNodeCommand}" Content="🗑 删除节点"
                                                                FontSize="12" Style="{StaticResource DangerButton}"
                                                                ToolTip="{Binding DeleteButtonToolTip}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <!-- 2. 统计概览面板 -->
                            <controls:SectionPanel Margin="0,12,0,0" Title="该对象试验统计"
                                                   StatusText="{Binding PassRate}"
                                                   StatusBrush="{StaticResource BrushOk}">
                                <controls:SectionPanel.PanelContent>
                                    <Grid>
                                        <Border Padding="30,20" Background="#F7F9FC"
                                                Visibility="{Binding HasNoTestData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="32" Foreground="#CBD5E1" Text="&#xE8A5;" />
                                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="12"
                                                           Foreground="{StaticResource BrushMutedText}" Text="暂无试验数据" />
                                            </StackPanel>
                                        </Border>
                                        <Grid Visibility="{Binding HasTestData, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:MetricCard Margin="0,0,6,0" Title="累计试验"
                                                                     Value="{Binding TotalTestCount}" Unit="次"
                                                                     AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                                <controls:MetricCard Grid.Column="1" Margin="3,0,3,0" Title="合格"
                                                                     Value="{Binding PassedTestCount}" Unit="次"
                                                                     AccentBrush="{StaticResource BrushOk}" CardBackground="#F0FFFB" />
                                                <controls:MetricCard Grid.Column="2" Margin="3,0,3,0" Title="不合格"
                                                                     Value="{Binding FailedTestCount}" Unit="次"
                                                                     AccentBrush="{StaticResource BrushDanger}" CardBackground="#FFF5F5" />
                                                <controls:MetricCard Grid.Column="3" Margin="3,0,3,0" Title="未判定"
                                                                     Value="{Binding UnknownTestCount}" Unit="次"
                                                                     AccentBrush="{StaticResource BrushMutedText}" CardBackground="#F5F5F5" />
                                                <controls:MetricCard Grid.Column="4" Margin="6,0,0,0" Title="最近结果"
                                                                     Value="{Binding LatestResult}" Unit=""
                                                                     AccentBrush="{Binding LatestResultBrush}" CardBackground="#F7FAFF" />
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <controls:MetricCard Grid.Column="0" Title="最近试验"
                                                                     Value="{Binding LatestTestTime}" Unit=""
                                                                     AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                                <controls:MetricCard Grid.Column="2" Title="最近泄漏率"
                                                                     Value="{Binding LatestLeakageRate}" Unit=""
                                                                     AccentBrush="#0891B2" CardBackground="#F7F9FC" />
                                                <controls:MetricCard Grid.Column="4" Title="来源装置"
                                                                     Value="{Binding LatestDevice}" Unit=""
                                                                     AccentBrush="{StaticResource BrushWarn}" CardBackground="#FFF8E1" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <!-- 3. 关联试验路径信息面板 -->
                            <controls:SectionPanel Margin="0,12,0,0" Title="关联试验路径信息"
                                                   StatusText="{Binding RecipeNameText}"
                                                   StatusBrush="{StaticResource BrushPrimary}">
                                <controls:SectionPanel.PanelContent>
                                    <Grid>
                                        <!-- 未关联试验路径：空状态（HasRecipe=false 时显示；内置 Converter 会忽略 ConverterParameter，故用 DataTrigger 取反） -->
                                        <Border Padding="28,22" Background="#F7F9FC" CornerRadius="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasRecipe}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock HorizontalAlignment="Center" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="30" Foreground="#CBD5E1" Text="&#xE8D7;" />
                                                <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="13"
                                                           Foreground="{StaticResource BrushMutedText}" Text="未关联试验路径" />
                                                <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" FontSize="12"
                                                           Foreground="#94A3B8" Text="可在编辑该节点时设置默认关联试验路径" />
                                            </StackPanel>
                                        </Border>

                                        <!-- 已关联试验路径信息 -->
                                        <StackPanel Visibility="{Binding HasRecipe, Converter={StaticResource BooleanToVisibilityConverter}}">

                                            <!-- 试验路径名称 + 所属系统 头部条 -->
                                            <Border Background="{StaticResource BrushPrimaryLighter}"
                                                    BorderBrush="{StaticResource BrushPrimaryLight}" BorderThickness="1"
                                                    CornerRadius="8" Padding="14,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="34" Height="34" CornerRadius="8"
                                                                Background="{StaticResource BrushPrimary}">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE8D7;" />
                                                        </Border>
                                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="11" Foreground="{StaticResource BrushMutedText}" Text="试验路径名称" />
                                                            <TextBlock Margin="0,2,0,0" FontSize="16" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushPrimary}" Text="{Binding RecipeNameText}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="14"
                                                            Background="White" BorderBrush="{StaticResource BrushPanelBorder}"
                                                            BorderThickness="1" Padding="12,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}" Text="所属系统" />
                                                            <TextBlock Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                                       Foreground="{StaticResource BrushText}" Text="{Binding RecipeSystemText}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <!-- 试验路径参数 -->
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Margin="0,0,5,0" Background="White" CornerRadius="8" Padding="14,10"
                                                        BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                     Fill="{StaticResource BrushPrimary}" />
                                                            <TextBlock Margin="6,0,0,0" FontSize="12"
                                                                       Foreground="{StaticResource BrushMutedText}" Text="泄漏率限值" />
                                                        </StackPanel>
                                                        <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource FontMono}" FontSize="18"
                                                                   Foreground="{StaticResource BrushText}" Text="{Binding RecipeLeakageLimitText}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1" Margin="5,0,0,0" Background="White" CornerRadius="8" Padding="14,10"
                                                        BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                                     Fill="{StaticResource BrushOk}" />
                                                            <TextBlock Margin="6,0,0,0" FontSize="12"
                                                                       Foreground="{StaticResource BrushMutedText}" Text="预充压" />
                                                        </StackPanel>
                                                        <TextBlock Margin="0,6,0,0" FontFamily="{StaticResource FontMono}" FontSize="18"
                                                                   Foreground="{StaticResource BrushText}" Text="{Binding RecipePrechargeP2Text}" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <!-- 备注说明：整行显示，长文本可换行 -->
                                            <Border Margin="0,10,0,0" Background="#F7F9FC" CornerRadius="8" Padding="14,10">
                                                <StackPanel>
                                                    <TextBlock FontSize="12" Foreground="{StaticResource BrushMutedText}" Text="备注说明" />
                                                    <TextBlock Margin="0,4,0,0" FontSize="14" TextWrapping="Wrap"
                                                               Foreground="{StaticResource BrushText}" Text="{Binding RecipeRemarkText}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <!-- 3. 任务下载面板：暂不启用（现场未使用），隐藏保留实现，需要时去掉 Collapsed 即可 -->
                            <controls:SectionPanel Margin="0,12,0,0"
                                                   Title="任务下载"
                                                   StatusText="下发试验任务到装置"
                                                   StatusBrush="{StaticResource BrushPrimary}"
                                                   Visibility="Collapsed">
                                <controls:SectionPanel.PanelContent>
                                    <ContentControl Content="{Binding TaskDownloadPage}" />
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
