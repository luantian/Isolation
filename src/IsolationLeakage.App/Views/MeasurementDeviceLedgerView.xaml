<UserControl x:Class="IsolationLeakage.App.Views.MeasurementDeviceLedgerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             xmlns:views="clr-namespace:IsolationLeakage.App.Views">
    <UserControl.Resources>
        <views:CommunicationTypeConverter x:Key="CommunicationTypeConverter" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="10,7" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource MutedTextBlock}" Text="主通信方式" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding CommunicationFilterOptions}" SelectedItem="{Binding CommunicationFilter, Mode=TwoWay}" Style="{StaticResource ScopeComboBox}" />
                <TextBlock Grid.Column="2" Margin="18,0,8,0" Style="{StaticResource MutedTextBlock}" Text="启用状态" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding EnabledFilterOptions}" SelectedItem="{Binding EnabledFilter, Mode=TwoWay}" Style="{StaticResource ScopeComboBox}" />
                <TextBlock Grid.Column="4" Margin="18,0,8,0" Style="{StaticResource MutedTextBlock}" Text="搜索" />
                <TextBox Grid.Column="5" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ScopeTextBox}" />
                <Button Grid.Column="6" Margin="10,0,0,0" HorizontalAlignment="Left" Command="{Binding QueryCommand}" Content="查询" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Height="30" Command="{Binding AddDeviceCommand}" Content="新增装置" />
                <Button Height="30" Margin="8,0,0,0" Command="{Binding EditDeviceCommand}" Content="编辑装置" />
                <Button Height="30" Margin="8,0,0,0" Command="{Binding DeleteCommand}" Content="删除" Style="{StaticResource DangerButton}" />
            </StackPanel>

            <!-- 装置列表 -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredDevices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}" IsReadOnly="True" AutoGenerateColumns="False" Style="{StaticResource IndustrialDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="装置编号" Binding="{Binding DeviceCode}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="装置名称" Binding="{Binding DeviceName}" Width="1.35*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="IP" Binding="{Binding Ip}" Width="130" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="序列号" Binding="{Binding SerialNumber}" Width="120" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="主通信方式" Binding="{Binding PrimaryCommunicationText}" Width="115" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="启用状态" Binding="{Binding EnabledStatusText}" Width="90" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="有效期" Binding="{Binding ValidUntilText}" Width="130" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="最近连接状态" Binding="{Binding ConnectionStatusText}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="最近同步时间" Binding="{Binding LastSyncTime}" Width="145" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                    <DataGridTextColumn Header="最近导入时间" Binding="{Binding LastUploadTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Width="145" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- 操作消息 -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,7" Background="{StaticResource BrushSurface}" BorderThickness="0" CornerRadius="4" Visibility="{Binding HasMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource BrushMutedText}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageType}" Value="1">
                                    <Setter Property="Foreground" Value="{StaticResource BrushOk}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MessageType}" Value="2">
                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <TextBlock.Text>
                        <Binding Path="Message" />
                    </TextBlock.Text>
                </TextBlock>
            </Border>
        </Grid>
    </Grid>
</UserControl>
