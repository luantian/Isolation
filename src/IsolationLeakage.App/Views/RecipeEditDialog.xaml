<Window x:Class="IsolationLeakage.App.Views.RecipeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="680"
        Height="560"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrushWorkspace}">
    <Window.Resources>
        <!-- 数字输入框（基于统一 IndustrialTextBox） -->
        <Style x:Key="NumberTextBox" TargetType="TextBox" BasedOn="{StaticResource IndustrialTextBox}">
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>

        <!-- 备注多行文本框（基于统一 IndustrialTextBox） -->
        <Style x:Key="RemarkTextBox" TargetType="TextBox" BasedOn="{StaticResource IndustrialTextBox}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <!-- 统一标签样式 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 单位后缀样式 -->
        <Style x:Key="UnitSuffix" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMutedText}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="32"/>
        </Style>

        <!-- 分区标题样式 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 分区编号徽章 -->
        <Style x:Key="SectionBadge" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SectionBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ① 基础信息（配方名称、序号、系统、状态）              -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <!-- 标题行 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="1" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="基础信息" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <!-- 配方名称 + 序号 -->
                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="配方名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="3" Text="组内序号" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="4" Style="{StaticResource NumberTextBox}"
                                     Text="{Binding SequenceNo}"/>
                        </Grid>

                        <!-- 系统 + 状态 -->
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="所属系统" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding System, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="3" Text="启用状态" Style="{StaticResource FieldLabel}"/>
                            <CheckBox Grid.Column="4" IsChecked="{Binding IsEnabled}"
                                      Content="启用" VerticalAlignment="Center" FontSize="13"
                                      Margin="0,0,10,0"/>
                        </Grid>

                        <!-- 备注 -->
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="备注说明" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource RemarkTextBox}"
                                     Text="{Binding Remark, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ② 阀门参数（贯穿件直径、阀门编号、公称直径）         -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="2" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="阀门参数" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <!-- 贯穿件直径 + 阀门编号 -->
                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="贯穿件直径" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumberTextBox}"
                                     Text="{Binding PenetrationDiameter, StringFormat={}{0:0.##}}"/>
                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitSuffix}"/>

                            <TextBlock Grid.Column="4" Text="试验阀门编号" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="5"
                                     Text="{Binding ValveNo, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- 阀门公称直径 -->
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="阀门公称直径" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumberTextBox}"
                                     Text="{Binding ValveNominalDiameter, StringFormat={}{0:0.##}}"/>
                            <TextBlock Grid.Column="2" Text="mm" Style="{StaticResource UnitSuffix}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ③ 试验参数（泄漏率限值、预充压压力P2）               -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="3" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="试验参数" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <!-- 泄漏率设计最大值 + 预充压压力P2 -->
                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="泄漏率设计最大值" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource NumberTextBox}"
                                     Text="{Binding LeakageLimit, StringFormat={}{0:0.####}}"/>

                            <TextBlock Grid.Column="4" Text="预充压压力 P2" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="5" Style="{StaticResource NumberTextBox}"
                                     Text="{Binding PrechargePressureP2, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="6" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 底部分隔线 + 按钮栏                                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10">
                <Button Content="取 消" Width="90" Height="34" Click="Cancel_Click" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}" FontSize="13"/>
                <Button Content="保 存" Width="90" Height="34" Click="Save_Click"
                        Style="{StaticResource IndustrialButton}" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
