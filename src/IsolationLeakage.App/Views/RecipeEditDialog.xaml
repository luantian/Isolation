<Window x:Class="IsolationLeakage.App.Views.RecipeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="700"
        Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrushWorkspace}">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 基础信息 -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="基础信息" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="配方编码" VerticalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBox Grid.Column="1" Text="{Binding RecipeCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                            <TextBlock Text="配方名称" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,10"/>
                            <TextBox Grid.Column="3" Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}" Margin="10,0,0,10"/>

                            <TextBlock Text="描述说明" Grid.Row="1" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60"
                                     VerticalContentAlignment="Top" AcceptsReturn="True" TextWrapping="Wrap"/>

                            <CheckBox Grid.Row="2" Grid.Column="1"
                                      IsChecked="{Binding IsEnabled}"
                                      Content="启用此配方"
                                      Margin="0,10,0,0"/>

                            <TextBlock Text="排序优先级" Grid.Row="2" Grid.Column="2"
                                       VerticalAlignment="Center" Margin="10,10,0,0"/>
                            <TextBox Grid.Row="2" Grid.Column="3"
                                     Text="{Binding SortOrder}"
                                     Margin="10,10,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 气密参数 -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="气密阶段参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="气密目标压力 P1 (MPa)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding AirtightTargetPressureP1}" Margin="10,0,0,10"/>

                            <TextBlock Text="气密允许下降值 (MPa)" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Column="3" Text="{Binding AirtightAllowDropValue}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 精吹参数 -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="精吹阶段参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="精吹目标压力 P1 (MPa)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding FineBlowTargetPressureP1}" Margin="10,0,0,10"/>

                            <TextBlock Text="吹扫泄压压力 (MPa)" Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <TextBox Grid.Column="3" Text="{Binding PurgeReleasePressure}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 预期泄漏流量 -->
                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="预期泄漏流量" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="常规预期泄漏流量 (L/min)" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding NormalExpectedLeakFlow}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 预充压参数 -->
                <Border Background="White" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="分阶段预充压参数" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{StaticResource BrushPrimaryLighter}" Padding="8,5" CornerRadius="4">
                                <TextBlock Text=""/>
                            </Border>
                            <Border Background="{StaticResource BrushPrimaryLighter}" Padding="8,5" CornerRadius="4" Grid.Column="1">
                                <TextBlock Text="目标压力 P1 (MPa)" HorizontalAlignment="Center"/>
                            </Border>
                            <Border Background="{StaticResource BrushPrimaryLighter}" Padding="8,5" CornerRadius="4" Grid.Column="2">
                                <TextBlock Text="目标压力 P2 (MPa)" HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="小预充压" Grid.Row="1" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SmallPrechargeTargetP1}" Margin="0,8"/>
                            <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding SmallPrechargeTargetP2}" Margin="0,8"/>

                            <TextBlock Text="中预充压" Grid.Row="2" VerticalAlignment="Center" Margin="0,8"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MediumPrechargeTargetP1}" Margin="0,8"/>
                            <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding MediumPrechargeTargetP2}" Margin="0,8"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="取消" Width="90" Height="32" Click="Cancel_Click" Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButton}" />
            <Button Content="保存" Width="90" Height="32" Click="Save_Click"
                    Style="{StaticResource IndustrialButton}" />
        </StackPanel>
    </Grid>
</Window>
