<Window x:Class="IsolationLeakage.App.Views.RecipeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="720"
        Height="640"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="{StaticResource BrushWorkspace}">
    <Window.Resources>
        <!-- 统一输入框样式 -->
        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 描述多行文本框 -->
        <Style x:Key="DescTextBox" TargetType="TextBox" BasedOn="{StaticResource FieldTextBox}">
            <Setter Property="Height" Value="56"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        </Style>

        <!-- 统一标签样式 -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <!-- 单位后缀样式 -->
        <Style x:Key="UnitSuffix" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMutedText}"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="MinWidth" Value="42"/>
        </Style>

        <!-- 分区标题样式 -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 分区编号徽章 -->
        <Style x:Key="SectionBadge" TargetType="Border">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SectionBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
            <StackPanel>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ① 基础信息                                         -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <!-- 标题行 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="1" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="基础信息" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <!-- 编码 + 名称 -->
                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="配方编码" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding RecipeCode, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="3" Text="配方名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="4" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- 描述 -->
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="描述说明" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource DescTextBox}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- 启用 -->
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="状态" Style="{StaticResource FieldLabel}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding IsEnabled}"
                                      Content="启用此配方" VerticalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ② 气密阶段参数                                      -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="2" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="气密阶段参数" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="气密目标压力 P1" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding AirtightTargetPressureP1, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="2" Text="MPa" Style="{StaticResource UnitSuffix}"/>

                            <TextBlock Grid.Column="4" Text="气密允许下降值" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="5" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding AirtightAllowDropValue, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="6" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ③ 精吹阶段参数                                      -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="3" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="精吹阶段参数" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="精吹目标压力 P1" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding FineBlowTargetPressureP1, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="2" Text="MPa" Style="{StaticResource UnitSuffix}"/>

                            <TextBlock Grid.Column="4" Text="吹扫泄压压力" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="5" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding PurgeReleasePressure, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="6" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ④ 预期泄漏流量                                      -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="4" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="预期泄漏流量" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="常规预期泄漏流量" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding NormalExpectedLeakFlow, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="2" Text="L/min" Style="{StaticResource UnitSuffix}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ⑤ 分阶段预充压参数                                   -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Background="White" CornerRadius="6" Padding="16,14" Margin="0,0,0,10"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Style="{StaticResource SectionBadge}">
                                <TextBlock Text="5" Style="{StaticResource SectionBadgeText}"/>
                            </Border>
                            <TextBlock Text="分阶段预充压参数" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <Grid Margin="30,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 表头 -->
                            <Border Grid.Column="1" Background="{StaticResource BrushPrimaryLighter}" CornerRadius="3" Padding="6,5">
                                <TextBlock Text="目标压力 P1" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource BrushPrimaryLighter}" CornerRadius="3" Padding="6,5" Margin="0,0,0,0">
                                <TextBlock Text="MPa" FontSize="11" Foreground="{StaticResource BrushMutedText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border Grid.Column="4" Background="{StaticResource BrushPrimaryLighter}" CornerRadius="3" Padding="6,5">
                                <TextBlock Text="目标压力 P2" HorizontalAlignment="Center" FontSize="12"
                                           Foreground="{StaticResource BrushPrimary}" FontWeight="SemiBold"/>
                            </Border>
                            <Border Grid.Column="5" Background="{StaticResource BrushPrimaryLighter}" CornerRadius="3" Padding="6,5">
                                <TextBlock Text="MPa" FontSize="11" Foreground="{StaticResource BrushMutedText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 小预充压 -->
                            <TextBlock Grid.Row="2" Text="小预充压" Style="{StaticResource FieldLabel}" FontSize="13"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding SmallPrechargeTargetP1, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                            <TextBox Grid.Row="2" Grid.Column="4" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding SmallPrechargeTargetP2, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="5" Text="MPa" Style="{StaticResource UnitSuffix}"/>

                            <!-- 中预充压 -->
                            <TextBlock Grid.Row="4" Text="中预充压" Style="{StaticResource FieldLabel}" FontSize="13"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding MediumPrechargeTargetP1, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                            <TextBox Grid.Row="4" Grid.Column="4" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding MediumPrechargeTargetP2, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Row="4" Grid.Column="5" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                        </Grid>

                        <!-- 大预充压（之前缺失！） -->
                        <Grid Margin="30,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="大预充压" Style="{StaticResource FieldLabel}" FontSize="13"/>
                            <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding LargePrechargeTargetP1, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="2" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                            <TextBox Grid.Column="4" Style="{StaticResource FieldTextBox}"
                                     Text="{Binding LargePrechargeTargetP2, StringFormat={}{0:0.####}}"/>
                            <TextBlock Grid.Column="5" Text="MPa" Style="{StaticResource UnitSuffix}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════ -->
        <!-- 底部分隔线 + 按钮栏                                   -->
        <!-- ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,10">
                <Button Content="取 消" Width="90" Height="34" Click="Cancel_Click" Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButton}" FontSize="13"/>
                <Button Content="保 存" Width="90" Height="34" Click="Save_Click"
                        Style="{StaticResource IndustrialButton}" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
