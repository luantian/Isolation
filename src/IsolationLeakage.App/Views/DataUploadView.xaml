<UserControl x:Class="IsolationLeakage.App.Views.DataUploadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <DockPanel Margin="8" LastChildFill="True">
        <!-- 左侧：文件选择和表单 -->
        <controls:SectionPanel Width="400" Margin="0,0,8,0" Title="数据上传" StatusText="选择数据包" StatusBrush="{StaticResource BrushPrimary}" DockPanel.Dock="Left">
            <controls:SectionPanel.PanelContent>
                <StackPanel>
                    <Border Width="34" Height="32" Margin="0,0,0,12" Background="{StaticResource BrushPrimary}"
                            BorderBrush="{StaticResource BrushPrimaryDark}" BorderThickness="1">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets" Foreground="White" Text="&#xE89A;" />
                    </Border>

                    <TextBlock FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource BrushText}"
                               Text="上传试验结果数据包" />
                    <TextBlock Margin="0,8,0,0" Foreground="{StaticResource BrushMutedText}"
                               Text="现场测试完成后，将泄漏仪生成的数据包通过U盘拷贝到本机，再在这里导入并解析入库。"
                               TextWrapping="Wrap" />

                    <Button Margin="0,18,0,0" Height="36"
                            Command="{Binding SelectPackageCommand}"
                            Content="选择数据包文件" />

                    <Border Margin="0,12,0,0" Padding="10,8" Background="#F7F9FC">
                        <TextBlock Foreground="{StaticResource BrushMutedText}"
                                   Text="支持格式：.json, .txt 等数据包文件" TextWrapping="Wrap" />
                    </Border>

                    <Separator Margin="0,18,0,18" />

                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushText}" Text="上传信息" />

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource MutedTextBlock}" Text="记录编号" />
                        <TextBox Margin="0,4,0,0" Text="{Binding RecordCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource MutedTextBlock}" Text="项目编码" />
                        <TextBox Margin="0,4,0,0" Text="{Binding ProjectCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource MutedTextBlock}" Text="机组编码" />
                        <TextBox Margin="0,4,0,0" Text="{Binding UnitCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Style="{StaticResource MutedTextBlock}" Text="操作人员" />
                        <TextBox Margin="0,4,0,0" Text="{Binding OperatorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <!-- 配方选择区域 -->
                    <Border Margin="0,16,0,0" Padding="12" Background="#F0F7FF"
                            BorderBrush="#B3D7FF" BorderThickness="1"
                            Visibility="{Binding ShowRecipePanel, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}" Text="试验配方" />
                                <Button Margin="8,0,0,0" Padding="8,2" HorizontalAlignment="Right"
                                        Command="{Binding ClearRecipeSelectionCommand}"
                                        Content="重置"
                                        FontSize="11"
                                        Visibility="{Binding IsRecipeSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </DockPanel>

                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding AvailableRecipes}"
                                      SelectedItem="{Binding SelectedRecipe}"
                                      DisplayMemberPath="RecipeName"
                                      SelectedValuePath="Id">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="ToolTip">
                                            <Setter.Value>
                                                <MultiBinding StringFormat="气密目标: {0} MPa, 精吹目标: {1} MPa, 预期泄漏: {2} L/min">
                                                    <Binding Path="AirtightTargetPressureP1" />
                                                    <Binding Path="FineBlowTargetPressureP1" />
                                                    <Binding Path="NormalExpectedLeakFlow" />
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>

                            <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="{StaticResource BrushMutedText}"
                                       Text="{Binding SelectedRecipeDisplay}" TextWrapping="Wrap" />

                            <Border Margin="0,6,0,0" Padding="6,3" Background="#E6F7FF" CornerRadius="2"
                                    Visibility="{Binding IsRecipeFromDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock FontSize="11" Foreground="#1890FF" Text="{Binding DefaultRecipeSource}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Button Margin="0,18,0,0" Height="36"
                            Command="{Binding UploadCommand}"
                            Content="开始上传"
                            Style="{StaticResource SuccessButton}" />

                    <Border Margin="0,12,0,0" Padding="10,8" Background="#F7F9FC">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Foreground="{StaticResource BrushPrimary}"
                                       Text="状态：" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushMutedText}"
                                       Text="{Binding UploadStatus}" TextWrapping="Wrap" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource BrushMutedText}"
                                       Text="{Binding UploadMessage}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <!-- 右侧：上传说明 + 最近上传历史 -->
        <StackPanel>
            <controls:SectionPanel Title="数据结构说明" StatusText="客户确认" StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <StackPanel>
                        <controls:DetailRow Label="结果字段" Value="约 5 个核心结果值字段" />
                        <controls:DetailRow Label="过程数据" Value="CSV 过程采集数据" />
                        <controls:DetailRow Label="过程通道" Value="约 15 个采集通道" />
                        <controls:DetailRow Label="入库结果" Value="生成一条试验记录" />
                        <controls:DetailRow Label="后续查看" Value="结果详情 / 曲线回放 / 历史查询" />
                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{StaticResource BrushMutedText}"
                                   Text="字段名称、通道名称、单位和采样频率以客户实际数据包格式为准。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <controls:SectionPanel Margin="0,10,0,0" Title="最近上传记录" StatusText="{Binding RecentUploads.Count, StringFormat='共 {0} 条'}" StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <DataGrid ItemsSource="{Binding RecentUploads}"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="None"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="记录编号" Binding="{Binding RecordCode}" Width="120" />
                            <DataGridTextColumn Header="对象编码" Binding="{Binding ObjectCode}" Width="100" />
                            <DataGridTextColumn Header="项目" Binding="{Binding ProjectCode}" Width="80" />
                            <DataGridTextColumn Header="机组" Binding="{Binding UnitCode}" Width="80" />
                            <DataGridTextColumn Header="试验时间" Binding="{Binding TestTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                            <DataGridTextColumn Header="导入时间" Binding="{Binding ImportTime, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="60" />
                            <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
