<UserControl x:Class="IsolationLeakage.App.Views.ProjectUnitManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1.1*" />
        </Grid.ColumnDefinitions>

        <controls:SectionPanel Grid.Column="0"
                               Margin="0,0,10,0"
                               Title="项目管理"
                               StatusText="基础台账"
                               StatusBrush="{StaticResource BrushPrimary}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="128" />
                    </Grid.RowDefinitions>

                    <!-- 批量导入按钮 -->
                    <Button Grid.Row="0"
                            Margin="0,0,0,8"
                            Height="34"
                            Command="{Binding ImportBatchDataCommand}"
                            Content="📥 批量导入数据（选择项目/机组文件夹）"
                            FontSize="13" />

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Projects}"
                              SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="项目编号" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="项目名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="1.2*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,8" Background="#F7F9FC" BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource MutedTextBlock}" Text="编号" />
                            <TextBox Grid.Column="1" Text="{Binding NewProjectCode, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource MutedTextBlock}" Text="名称" />
                            <TextBox Grid.Column="3" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4" Margin="10,0,0,0" Command="{Binding AddProjectCommand}" Content="新增" />
                            <Button Grid.Column="5" Margin="8,0,0,0" Command="{Binding DeleteProjectCommand}" Content="删除" Style="{StaticResource DangerButton}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlock}" Text="备注" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding NewProjectRemark, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Foreground="{StaticResource BrushDanger}" Text="{Binding ProjectError}" />
                        </Grid>
                    </Border>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>

        <controls:SectionPanel Grid.Column="1"
                               Title="机组管理"
                               StatusText="{Binding SelectedProject.Name}"
                               StatusBrush="{StaticResource BrushOk}">
            <controls:SectionPanel.PanelContent>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="128" />
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" ItemsSource="{Binding CurrentUnits}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="所属项目" Binding="{Binding Project.Name}" Width="130" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="机组编号" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="机组名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="1.1*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Margin="0,10,0,0" Padding="10,8" Background="#F7F9FC" BorderBrush="{StaticResource BrushPanelBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="86" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource MutedTextBlock}" Text="编号" />
                            <TextBox Grid.Column="1" Text="{Binding NewUnitCode, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Margin="10,0,0,0" Style="{StaticResource MutedTextBlock}" Text="名称" />
                            <TextBox Grid.Column="3" Text="{Binding NewUnitName, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="4" Margin="10,0,0,0" Command="{Binding AddUnitCommand}" Content="新增" />
                            <Button Grid.Column="5" Margin="8,0,0,0" Command="{Binding DeleteUnitCommand}" Content="删除" Style="{StaticResource DangerButton}" />

                            <TextBlock Grid.Row="1" Style="{StaticResource MutedTextBlock}" Text="备注" />
                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Text="{Binding NewUnitRemark, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="6" Foreground="{StaticResource BrushDanger}" Text="{Binding UnitError}" />
                        </Grid>
                    </Border>
                </Grid>
            </controls:SectionPanel.PanelContent>
        </controls:SectionPanel>
    </Grid>
</UserControl>
