<UserControl x:Class="IsolationLeakage.App.Views.ProjectUnitManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：批量导入按钮 + 进度条 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 批量导入按钮 -->
            <Button Grid.Column="0"
                    Height="34"
                    Command="{Binding ImportBatchDataCommand}"
                    Content=" 批量导入数据（选择项目/机组文件夹）"
                    FontSize="13" />

            <!-- 批量导入进度条 -->
            <StackPanel Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsBatchImporting, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ProgressBar Height="20"
                             Value="{Binding BatchImportProgress, Mode=OneWay}"
                             Minimum="0" Maximum="100"
                             Foreground="{StaticResource BrushPrimary}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="12"
                           Foreground="{StaticResource BrushMutedText}"
                           Text="{Binding BatchImportStatus}" />
            </StackPanel>
        </Grid>

        <!-- 主内容区：项目管理 + 机组管理 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.1*" />
            </Grid.ColumnDefinitions>

            <controls:SectionPanel Grid.Column="0"
                                   Margin="0,0,10,0"
                                   Title="项目管理"
                                   StatusText="试验对象"
                                   StatusBrush="{StaticResource BrushPrimary}">
                <controls:SectionPanel.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Height="30"
                                    Command="{Binding AddProjectCommand}"
                                    Content="➕ 新增" />
                            <Button Height="30"
                                    Margin="8,0,0,0"
                                    Command="{Binding EditProjectCommand}"
                                    Content="✏️ 编辑" />
                            <Button Height="30"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteProjectCommand}"
                                    Content="🗑️ 删除"
                                    Style="{StaticResource DangerButton}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Projects}"
                                  SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="项目编号" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="项目名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="1.2*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>

            <controls:SectionPanel Grid.Column="1"
                                   Title="机组管理"
                                   StatusText="{Binding SelectedProject.Name}"
                                   StatusBrush="{StaticResource BrushOk}">
                <controls:SectionPanel.PanelContent>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Height="30"
                                    Command="{Binding AddUnitCommand}"
                                    Content="➕ 新增" />
                            <Button Height="30"
                                    Margin="8,0,0,0"
                                    Command="{Binding EditUnitCommand}"
                                    Content="✏️ 编辑" />
                            <Button Height="30"
                                    Margin="8,0,0,0"
                                    Command="{Binding DeleteUnitCommand}"
                                    Content="🗑️ 删除"
                                    Style="{StaticResource DangerButton}" />
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentUnits}" SelectedItem="{Binding SelectedUnit, Mode=TwoWay}" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="所属项目" Binding="{Binding Project.Name}" Width="130" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="机组编号" Binding="{Binding Code}" Width="110" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="机组名称" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="80" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="1.1*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </controls:SectionPanel.PanelContent>
            </controls:SectionPanel>
        </Grid>
    </Grid>
</UserControl>
