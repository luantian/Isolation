<UserControl x:Class="IsolationLeakage.App.Controls.SectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             x:Name="Root">
    <Grid>
        <!-- 下层：只负责阴影，不包含文字（避免 Effect 导致文字发虚） -->
        <Border Background="{StaticResource BrushSurface}"
                CornerRadius="6"
                Effect="{StaticResource ShadowSubtle}" />
        <!-- 上层：只负责内容渲染，不带 Effect，保证文字清晰 -->
        <Border Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:PanelHeader Grid.Row="0"
                                      Title="{Binding Title, ElementName=Root}"
                                      StatusText="{Binding StatusText, ElementName=Root}"
                                      StatusBrush="{Binding StatusBrush, ElementName=Root}" />
                <ContentPresenter Grid.Row="0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Margin="150,0,0,0"
                                  Content="{Binding HeaderExtraContent, ElementName=Root}" />

                <ContentPresenter Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="{Binding ContentPadding, ElementName=Root}"
                                  Content="{Binding PanelContent, ElementName=Root}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
