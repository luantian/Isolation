<UserControl x:Class="IsolationLeakage.App.Controls.SectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             x:Name="Root">
    <Border Background="{StaticResource BrushSurface}"
            BorderBrush="{StaticResource BrushPanelBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Effect="{StaticResource ShadowSubtle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:PanelHeader Grid.Row="0"
                                  Title="{Binding Title, ElementName=Root}"
                                  StatusText="{Binding StatusText, ElementName=Root}"
                                  StatusBrush="{Binding StatusBrush, ElementName=Root}" />

            <ContentPresenter Grid.Row="1"
                              Margin="{Binding ContentPadding, ElementName=Root}"
                              Content="{Binding PanelContent, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
