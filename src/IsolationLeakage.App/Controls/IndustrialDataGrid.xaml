<UserControl x:Class="IsolationLeakage.App.Controls.IndustrialDataGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 核心 DataGrid -->
        <DataGrid x:Name="PART_DataGrid"
                  Grid.Row="0"
                  Style="{StaticResource IndustrialDataGrid}"
                  IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  VerticalScrollBarVisibility="{Binding VerticalScrollBarVisibility, ElementName=Root}">
        </DataGrid>

        <!-- 错误信息显示（可选） -->
        <Border Grid.Row="1"
                Margin="0,10,0,0"
                Padding="10,8"
                Background="#FFF5F5"
                BorderBrush="#FECACA"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="{Binding ErrorVisibility, ElementName=Root}">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Command="{Binding CopyErrorCommand, ElementName=Root}"
                        Content="复制"
                        Padding="8,3"
                        Margin="10,0,0,0"
                        Background="{StaticResource BrushDanger}"
                        Foreground="White"
                        BorderThickness="0" />
                <TextBlock Text="{Binding ErrorDetail, ElementName=Root}"
                           TextWrapping="Wrap"
                           Foreground="#CC0000"
                           FontSize="11" />
            </DockPanel>
        </Border>

        <!-- 分页控制栏（可选） -->
        <controls:PaginationControl Grid.Row="2"
                Margin="0,6,0,0"
                HorizontalAlignment="Right"
                CurrentPage="{Binding CurrentPage, ElementName=Root, Mode=TwoWay}"
                TotalCount="{Binding TotalCount, ElementName=Root}"
                PageSize="{Binding PageSize, ElementName=Root}"
                GotoPageCommand="{Binding GotoPageCommand, ElementName=Root}">
            <controls:PaginationControl.Style>
                <Style TargetType="controls:PaginationControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPagination, ElementName=Root}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </controls:PaginationControl.Style>
        </controls:PaginationControl>
    </Grid>
</UserControl>
