<UserControl x:Class="IsolationLeakage.App.Controls.DateRangePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal">
        <!-- 从 -->
        <TextBlock Text="从"
                   VerticalAlignment="Center"
                   Margin="0,0,6,0"
                   Foreground="{StaticResource BrushMutedText}" />
        <DatePicker x:Name="FromDatePicker"
                    Width="140"
                    SelectedDateChanged="OnFromDateChanged" />

        <!-- 至 -->
        <TextBlock Text="至"
                   VerticalAlignment="Center"
                   Margin="10,0,6,0"
                   Foreground="{StaticResource BrushMutedText}" />
        <DatePicker x:Name="ToDatePicker"
                    Width="140"
                    SelectedDateChanged="OnToDateChanged" />

        <!-- 快捷选择按钮 -->
        <Button x:Name="TodayBtn"
                Content="今天"
                Height="30"
                Padding="10,0"
                Margin="8,0,0,0"
                Click="OnTodayClick"
                Style="{StaticResource SecondaryButton}" />
        <Button x:Name="WeekBtn"
                Content="本周"
                Height="30"
                Padding="10,0"
                Margin="4,0,0,0"
                Click="OnWeekClick"
                Style="{StaticResource SecondaryButton}" />
        <Button x:Name="MonthBtn"
                Content="本月"
                Height="30"
                Padding="10,0"
                Margin="4,0,0,0"
                Click="OnMonthClick"
                Style="{StaticResource SecondaryButton}" />
    </StackPanel>
</UserControl>