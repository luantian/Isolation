<UserControl x:Class="IsolationLeakage.App.Controls.PanelHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Height="40">
    <Border Background="#F8FAFC"
            BorderBrush="{StaticResource BrushPanelBorder}"
            BorderThickness="0,0,0,1"
            CornerRadius="6,6,0,0">
        <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource BrushText}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="{Binding Title, ElementName=Root}" />

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="{Binding StatusVisibility, ElementName=Root}">
                <Ellipse Width="8"
                         Height="8"
                         VerticalAlignment="Center"
                         Fill="{Binding StatusBrush, ElementName=Root}" />
                <TextBlock Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource BrushMutedText}"
                           FontSize="14"
                           Text="{Binding StatusText, ElementName=Root}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
