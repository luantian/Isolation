<UserControl x:Class="IsolationLeakage.App.Controls.NavItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Height="46"
            Background="{Binding ItemBackground, ElementName=Root}"
            Cursor="Hand"
            Padding="14,0"
            CornerRadius="6"
            Margin="8,2"
            MouseEnter="OnMouseEnter"
            MouseLeave="OnMouseLeave"
            MouseLeftButtonUp="OnMouseLeftButtonUp">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{Binding IconBackground, ElementName=Root}"
                    CornerRadius="5">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           Foreground="{Binding IconForeground, ElementName=Root}"
                           Text="{Binding IconGlyph, ElementName=Root}" />
            </Border>
            <TextBlock Grid.Column="1"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       FontSize="15"
                       FontWeight="{Binding LabelWeight, ElementName=Root}"
                       Foreground="{Binding LabelBrush, ElementName=Root}"
                       Text="{Binding Text, ElementName=Root}" />
        </Grid>
    </Border>
</UserControl>
