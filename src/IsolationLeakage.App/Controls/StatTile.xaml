<UserControl x:Class="IsolationLeakage.App.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
             x:Name="Root">
    <Grid>
        <!-- 下层：只负责阴影，不包含文字（避免 Effect 导致文字发虚） -->
        <Border Background="{StaticResource BrushSurface}"
                CornerRadius="6"
                Effect="{StaticResource ShadowSubtle}" />
        <!-- 上层：只负责内容渲染，不带 Effect，保证文字清晰 -->
        <Border Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <controls:PanelHeader Title="{Binding Title, ElementName=Root}"
                                      StatusText="{Binding StatusText, ElementName=Root}"
                                      StatusBrush="{Binding StatusBrush, ElementName=Root}" />

                <Grid Grid.Row="1" Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource ValueTextBlock}"
                                   FontSize="32"
                                   Text="{Binding Value, ElementName=Root}" />
                        <TextBlock Margin="10,10,0,0"
                                   Foreground="{StaticResource BrushMutedText}"
                                   FontSize="15"
                                   Text="{Binding Unit, ElementName=Root}" />
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Margin="0,10,0,0"
                               Foreground="{StaticResource BrushMutedText}"
                               FontSize="15"
                               Text="{Binding Description, ElementName=Root}" />

                    <Border Grid.Row="2"
                            Height="1"
                            Margin="0,14,0,0"
                            VerticalAlignment="Bottom"
                            Background="{StaticResource BrushPanelBorder}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
