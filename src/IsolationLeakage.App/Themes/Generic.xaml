<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">

    <!-- 分页控件内部按钮共用样式（白底、灰边、悬停加深） -->
    <Style x:Key="PaginationNavButton" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrushPanelBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F1F5F9" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#CBD5E1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E2E8F0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Background" Value="#F8FAFC" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#E2E8F0" />
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:PaginationControl">
        <Setter Property="Height" Value="34" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PaginationControl">
                    <Border Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4,3">
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- 首页 -->
                            <Button Command="{Binding GoToFirstCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="首页"
                                    Margin="0,0,3,0"
                                    Style="{StaticResource PaginationNavButton}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushMutedText}"
                                           Text="&#xE892;" />
                            </Button>
                            <!-- 上一页 -->
                            <Button Command="{Binding GoToPreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="上一页"
                                    Margin="0,0,3,0"
                                    Style="{StaticResource PaginationNavButton}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushMutedText}"
                                           Text="&#xE76B;" />
                            </Button>
                            <!-- 页码状态 -->
                            <Border Margin="2,0"
                                    Padding="10,3"
                                    Background="{DynamicResource BrushPrimaryLighter}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontFamily="{DynamicResource FontMono}"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           VerticalAlignment="Center"
                                           Text="{Binding PageStatusText, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <!-- 下一页 -->
                            <Button Command="{Binding GoToNextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="下一页"
                                    Margin="3,0,3,0"
                                    Style="{StaticResource PaginationNavButton}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushMutedText}"
                                           Text="&#xE76C;" />
                            </Button>
                            <!-- 末页 -->
                            <Button Command="{Binding GoToLastCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="末页"
                                    Margin="0"
                                    Style="{StaticResource PaginationNavButton}">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushMutedText}"
                                           Text="&#xE893;" />
                            </Button>

                            <!-- 每页条数 -->
                            <ComboBox Width="60" Height="26" FontSize="12"
                                      VerticalAlignment="Center"
                                      Margin="8,0,0,0"
                                      ItemsSource="{Binding PageSizeOptions, RelativeSource={RelativeSource TemplatedParent}}"
                                      SelectedValue="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <TextBlock Text="条/页" FontSize="12" Foreground="{DynamicResource BrushMutedText}"
                                       VerticalAlignment="Center" Margin="4,0,8,0" />

                            <!-- 跳转到页 -->
                            <TextBlock Text="跳至" FontSize="12" Foreground="{DynamicResource BrushMutedText}"
                                       VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="55" Height="26" FontSize="12"
                                     VerticalAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     Text="{Binding JumpToPage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding JumpToPageCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    Content="确定"
                                    Width="45" Height="26" FontSize="11" FontWeight="SemiBold"
                                    Margin="4,0,0,0"
                                    Background="{DynamicResource BrushPrimary}"
                                    Foreground="White"
                                    BorderThickness="0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
