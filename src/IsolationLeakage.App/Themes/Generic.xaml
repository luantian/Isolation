<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">

    <Style TargetType="controls:PaginationControl">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PaginationControl">
                    <Border Height="{TemplateBinding Height}"
                            MinWidth="{TemplateBinding MinWidth}"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4,2">
                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <!-- 首页 -->
                            <Button Command="{Binding GoToFirstCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="首页"
                                    Width="28" Height="26"
                                    Padding="0" Margin="0,0,2,0"
                                    Style="{DynamicResource SecondaryButton}"
                                    FontSize="11">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="&#xE892;" />
                            </Button>
                            <!-- 上一页 -->
                            <Button Command="{Binding GoToPreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="上一页"
                                    Width="28" Height="26"
                                    Padding="0" Margin="0,0,2,0"
                                    Style="{DynamicResource SecondaryButton}"
                                    FontSize="11">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="&#xE76B;" />
                            </Button>
                            <!-- 页码状态 -->
                            <Border Margin="4,0"
                                    Padding="8,2"
                                    Background="{DynamicResource BrushPrimaryLighter}"
                                    CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock FontSize="12"
                                           FontFamily="{DynamicResource FontMono}"
                                           Foreground="{DynamicResource BrushPrimary}"
                                           VerticalAlignment="Center"
                                           Text="{Binding PageStatusText, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <!-- 下一页 -->
                            <Button Command="{Binding GoToNextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="下一页"
                                    Width="28" Height="26"
                                    Padding="0" Margin="2,0,2,0"
                                    Style="{DynamicResource SecondaryButton}"
                                    FontSize="11">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="&#xE76C;" />
                            </Button>
                            <!-- 末页 -->
                            <Button Command="{Binding GoToLastCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="末页"
                                    Width="28" Height="26"
                                    Padding="0"
                                    Style="{DynamicResource SecondaryButton}"
                                    FontSize="11">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="&#xE893;" />
                            </Button>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
