<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:IsolationLeakage.App.Controls">

    <Style TargetType="controls:PaginationControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:PaginationControl">
                    <Border Padding="6,3"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushPanelBorder}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <DockPanel LastChildFill="True">
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Command="{Binding GoToFirstCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,0,2,0"
                                        Padding="2,1"
                                        Width="26"
                                        Height="22"
                                        FontSize="10"
                                        ToolTip="首页">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE892;" />
                                </Button>
                                <Button Command="{Binding GoToPreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,0,2,0"
                                        Padding="2,1"
                                        Width="26"
                                        Height="22"
                                        FontSize="10"
                                        ToolTip="上一页">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76B;" />
                                </Button>
                                <TextBlock Margin="4,0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushMutedText}"
                                           Text="{Binding PageStatusText, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Button Command="{Binding GoToNextCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Margin="0,0,2,0"
                                        Padding="2,1"
                                        Width="26"
                                        Height="22"
                                        FontSize="10"
                                        ToolTip="下一页">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE76C;" />
                                </Button>
                                <Button Command="{Binding GoToLastCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                        Padding="2,1"
                                        Width="26"
                                        Height="22"
                                        FontSize="10"
                                        ToolTip="末页">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE893;" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
