<Window x:Class="IsolationLeakage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        xmlns:views="clr-namespace:IsolationLeakage.App.Views"
        xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels"
        x:Name="RootWindow"
        Title="智能安全壳隔离阀泄漏率数据管理软件"
        Icon="icon.png"
        Width="1600"
        Height="900"
        MinWidth="800"
        MinHeight="500"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <!-- 缩放宿主：给出真实客户区尺寸，据此把整套界面按比例缩放到刚好装下（高分屏/小屏自适应） -->
    <Grid x:Name="ScaleHost" Background="{StaticResource BrushWorkspace}" SizeChanged="ScaleHost_SizeChanged">
    <Grid x:Name="RootContent" Background="{StaticResource BrushWorkspace}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏（顶部菜单项 + 底部状态信息） -->
        <Border Grid.Column="0"
                Background="{StaticResource BrushSurface}"
                BorderBrush="{StaticResource BrushPanelBorder}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 导航菜单项 -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding NavItems}" Margin="8,10,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:NavItem Text="{Binding Text}"
                                              IconGlyph="{Binding IconGlyph}"
                                              IsActive="{Binding IsActive}"
                                              Command="{Binding Command}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 底部状态信息 -->
                <Border Grid.Row="2"
                        Margin="8,0,8,12"
                        Background="#F8FAFC"
                        BorderBrush="{StaticResource BrushPanelBorder}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>

                        <!-- 数据库状态指示器 -->
                        <Border x:Name="DbStatusIndicator"
                                Margin="10,10,10,0"
                                Padding="10,8"
                                Background="{StaticResource BrushSurface}"
                                BorderBrush="{StaticResource BrushPanelBorder}"
                                BorderThickness="1"
                                CornerRadius="6">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Foreground="{StaticResource BrushPrimary}"
                                               VerticalAlignment="Center"
                                               Text="&#xEE94;" />
                                    <TextBlock Margin="6,0,0,0"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Text="数据库" />
                                </StackPanel>

                                <!-- 主库行 -->
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Text="主库" />
                                    <Ellipse x:Name="DbPrimaryDot"
                                             Width="7" Height="7"
                                             Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="#16A34A" />
                                    <TextBlock x:Name="DbPrimaryStatusText"
                                               Margin="4,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushMutedText}"
                                               VerticalAlignment="Center"
                                               Text="检测中" />
                                    <TextBlock x:Name="DbPrimaryCurrentTag"
                                               Margin="6,0,0,0"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushPrimary}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"
                                               Text="(当前)" />
                                </StackPanel>
                                <TextBlock x:Name="DbPrimaryServerText"
                                           Margin="16,1,0,0"
                                           FontSize="10"
                                           FontFamily="{StaticResource FontMono}"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text=".\SQLEXPRESS"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- 从库行 -->
                                <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                    <TextBlock FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushText}"
                                               VerticalAlignment="Center"
                                               Text="从库" />
                                    <Ellipse x:Name="DbSecondaryDot"
                                             Width="7" Height="7"
                                             Margin="6,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="#64748B" />
                                    <TextBlock x:Name="DbSecondaryStatusText"
                                               Margin="4,0,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource BrushMutedText}"
                                               VerticalAlignment="Center"
                                               Text="未配置" />
                                    <TextBlock x:Name="DbSecondaryCurrentTag"
                                               Margin="6,0,0,0"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushPrimary}"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"
                                               Text="(当前)" />
                                </StackPanel>
                                <TextBlock x:Name="DbSecondaryServerText"
                                           Margin="16,1,0,0"
                                           FontSize="10"
                                           FontFamily="{StaticResource FontMono}"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text=""
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <!-- 用户信息区 -->
                        <Grid Margin="14,14,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- 头像圆 -->
                            <Border Width="38"
                                    Height="38"
                                    Background="{StaticResource BrushPrimary}"
                                    CornerRadius="19"
                                    VerticalAlignment="Center">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="17"
                                           Foreground="White"
                                           Text="&#xE77B;" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushText}"
                                           Text="{Binding CurrentUserName}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Margin="0,1,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource BrushMutedText}"
                                           Text="{Binding CurrentRoleName}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <!-- 注销按钮已按需求移除（会话超时自动回登录窗的逻辑保留） -->
                        </Grid>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧内容区 -->
        <ContentControl Grid.Column="1" Content="{Binding ActivePage}" />
    </Grid>
    </Grid>
</Window>
