<Window x:Class="IsolationLeakage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        xmlns:views="clr-namespace:IsolationLeakage.App.Views"
        xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels"
        x:Name="RootWindow"
        Title="智能安全壳隔离阀泄漏率数据管理软件"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <!-- ViewModel 类型 → View 自动匹配（App.xaml 中已定义的部分） -->
        <!-- 占位页面（无独立 ViewModel）：创建包装 ViewModel -->
        <DataTemplate DataType="{x:Type vm:MasterDataViewModel}">
            <views:MasterDataView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SystemManagementViewModel}">
            <views:SystemManagementView />
        </DataTemplate>
    </Window.Resources>
    <DockPanel Background="{StaticResource BrushWorkspace}">
        <!-- 顶部菜单 -->
        <Menu DockPanel.Dock="Top" Height="28" Background="{StaticResource BrushSurface}">
            <MenuItem Header="文件" />
            <MenuItem Header="帮助" />
        </Menu>

        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Height="26" Background="{StaticResource BrushSurface}">
            <StatusBarItem>
                <controls:StatusDot Text="数据库连接正常" DotBrush="{StaticResource BrushOk}" TextBrush="{StaticResource BrushMutedText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="当前用户：admin" />
            <StatusBarItem HorizontalAlignment="Right" Content="{Binding CurrentPageTitle}" />
        </StatusBar>

        <!-- 主体布局：左侧导航 + 右侧内容 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <Border Grid.Column="0"
                    Padding="0,10"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <controls:NavItem Text="首页概览" IconGlyph="&#xE80F;" IsActive="{Binding IsOverviewActive}" Command="{Binding NavigateOverview}" />
                    <controls:NavItem Text="基础台账" IconGlyph="&#xE8B7;" IsActive="{Binding IsMasterDataActive}" Command="{Binding NavigateMasterData}" />
                    <controls:NavItem Text="实时监视" IconGlyph="&#xE9D9;" IsActive="{Binding IsRealtimeMonitorActive}" Command="{Binding NavigateRealtimeMonitor}" />
                    <controls:NavItem Text="试验记录" IconGlyph="&#xE8A5;" IsActive="{Binding IsRecordsActive}" Command="{Binding NavigateRecords}" />
                    <controls:NavItem Text="统计分析" IconGlyph="&#xE9D2;" IsActive="{Binding IsAnalysisActive}" Command="{Binding NavigateAnalysis}" />
                    <controls:NavItem Text="系统管理" IconGlyph="&#xE713;" IsActive="{Binding IsSystemManagementActive}" Command="{Binding NavigateSystemManagement}" />
                </StackPanel>
            </Border>

            <!-- 右侧内容区：ContentControl 根据 ActivePage ViewModel 类型自动渲染对应 View -->
            <ContentControl Grid.Column="1" Content="{Binding ActivePage}" />
        </Grid>
    </DockPanel>
</Window>
