<Window x:Class="IsolationLeakage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        xmlns:views="clr-namespace:IsolationLeakage.App.Views"
        xmlns:vm="clr-namespace:IsolationLeakage.App.ViewModels"
        x:Name="RootWindow"
        Title="智能安全壳隔离阀泄漏率数据管理软件"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <DockPanel Background="{StaticResource BrushWorkspace}">
        <!-- 底部状态栏 -->
        <StatusBar DockPanel.Dock="Bottom" Height="26" Background="{StaticResource BrushSurface}">
            <StatusBarItem Content="{Binding CurrentUserName}" />
            <Separator />
            <StatusBarItem Content="{Binding CurrentRoleName}" Foreground="#888" />
            <Separator />
            <StatusBarItem Content="{Binding ConnectionStatusText}" />
            <Separator />
            <StatusBarItem Content="{Binding LastSyncTimeText}" Foreground="#888" />
            <StatusBarItem HorizontalAlignment="Right" Content="{Binding CurrentPageTitle}" />
        </StatusBar>

        <!-- 主体布局：左侧导航 + 右侧内容 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航（按权限动态显示） -->
            <Border Grid.Column="0"
                    Padding="8,10"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="0,0,1,0">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:NavItem Text="{Binding Text}"
                                              IconGlyph="{Binding IconGlyph}"
                                              IsActive="{Binding IsActive}"
                                              Command="{Binding Command}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- 右侧内容区：ContentControl 根据 ActivePage ViewModel 类型自动渲染对应 View -->
            <ContentControl Grid.Column="1" Content="{Binding ActivePage}" />
        </Grid>
    </DockPanel>
</Window>
