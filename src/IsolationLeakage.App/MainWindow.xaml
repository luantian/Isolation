<Window x:Class="IsolationLeakage.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:IsolationLeakage.App.Controls"
        xmlns:views="clr-namespace:IsolationLeakage.App.Views"
        x:Name="RootWindow"
        Title="智能安全壳隔离阀泄漏率数据管理软件"
        Width="1920"
        Height="1080"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{StaticResource BrushWorkspace}">
        <Menu DockPanel.Dock="Top" Height="28" Background="{StaticResource BrushSurface}">
            <MenuItem Header="文件" />
            <MenuItem Header="帮助" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Height="26" Background="{StaticResource BrushSurface}">
            <StatusBarItem>
                <controls:StatusDot Text="数据库连接正常" DotBrush="{StaticResource BrushOk}" TextBrush="{StaticResource BrushMutedText}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Content="当前用户：admin" />
            <StatusBarItem HorizontalAlignment="Right" Content="{Binding CurrentPageTitle}" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="0,10"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushPanelBorder}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <controls:NavItem Text="首页概览" IconGlyph="&#xE80F;" IsActive="{Binding IsOverviewActive}" Click="OverviewNav_Click" />
                    <controls:NavItem Text="基础台账" IconGlyph="&#xE8B7;" IsActive="{Binding IsMasterDataActive}" Click="MasterDataNav_Click" />
                    <controls:NavItem Text="实时监视" IconGlyph="&#xE9D9;" IsActive="{Binding IsRealtimeMonitorActive}" Click="RealtimeMonitorNav_Click" />
                    <controls:NavItem Text="试验记录" IconGlyph="&#xE8A5;" IsActive="{Binding IsRecordsActive}" Click="RecordsNav_Click" />
                    <controls:NavItem Text="统计分析" IconGlyph="&#xE9D2;" IsActive="{Binding IsAnalysisActive}" Click="AnalysisNav_Click" />
                    <controls:NavItem Text="系统管理" IconGlyph="&#xE713;" IsActive="{Binding IsSystemManagementActive}" Click="SystemManagementNav_Click" />
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding OverviewVisibility, ElementName=RootWindow}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="128" />
                            <RowDefinition Height="320" />
                            <RowDefinition Height="320" />
                        </Grid.RowDefinitions>

                        <UniformGrid Grid.Row="0" Columns="6" Rows="1">
                            <controls:StatTile Margin="0,0,10,0" Title="试验对象" Value="126" Unit="个" Description="阀门 / 贯穿件 / 部件" StatusText="台账" StatusBrush="{StaticResource BrushPrimary}" />
                            <controls:StatTile Margin="0,0,10,0" Title="测量装置" Value="4" Unit="台" Description="3 台在线，1 台离线" StatusText="装置" StatusBrush="{StaticResource BrushWarn}" />
                            <controls:StatTile Margin="0,0,10,0" Title="历史记录" Value="1850" Unit="条" Description="按时间顺序保存" StatusText="记录" StatusBrush="{StaticResource BrushPrimary}" />
                            <controls:StatTile Margin="0,0,10,0" Title="本月合格率" Value="96.8" Unit="%" Description="按导入记录统计" StatusText="统计" StatusBrush="{StaticResource BrushOk}" />
                            <controls:StatTile Margin="0,0,10,0" Title="待处理异常" Value="3" Unit="项" Description="不合格 / 导入异常" StatusText="异常" StatusBrush="{StaticResource BrushWarn}" />
                            <controls:StatTile Title="最近备份" Value="02:00" Unit="" Description="2026-05-26 自动备份" StatusText="完整" StatusBrush="{StaticResource BrushOk}" />
                        </UniformGrid>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.35*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="0.9*" />
                            </Grid.ColumnDefinitions>

                            <controls:SectionPanel Grid.Column="0" Margin="0,0,10,0" Title="试验记录" StatusText="最近导入" StatusBrush="{StaticResource BrushPrimary}">
                                <controls:SectionPanel.PanelContent>
                                    <DataGrid ItemsSource="{Binding PreviewRecords}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="试验对象" Binding="{Binding ObjectCode}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="机组" Binding="{Binding Unit}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="最终泄漏率" Binding="{Binding LeakageRate}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                            <DataGridTextColumn Header="导入时间" Binding="{Binding UploadedAt}" Width="1.5*" ElementStyle="{StaticResource DataGridTextElementStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <controls:SectionPanel Grid.Column="1" Margin="0,0,10,0" Title="最近导入详情" StatusText="已入库" StatusBrush="{StaticResource BrushOk}">
                                <controls:SectionPanel.PanelContent>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Style="{StaticResource MutedTextBlock}" Text="1RHR040VP / 最终泄漏率" />
                                        <TextBlock Grid.Row="1" Margin="0,6,0,12" Style="{StaticResource ValueTextBlock}" Text="0.012 L/min" />
                                        <StackPanel Grid.Row="2">
                                            <controls:DetailRow Label="判定结果" Value="合格" ValueBrush="{StaticResource BrushOk}" />
                                            <controls:DetailRow Label="导入时间" Value="2026-05-26 12:18" />
                                            <controls:DetailRow Label="测量装置" Value="DEV-001" />
                                            <controls:DetailRow Label="数据状态" Value="已解析入库 / 未覆盖历史" ValueBrush="{StaticResource BrushOk}" />
                                            <controls:DetailRow Label="操作人员" Value="admin" />
                                        </StackPanel>
                                    </Grid>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <controls:SectionPanel Grid.Column="2" Title="快捷操作" StatusText="待命" StatusBrush="{StaticResource BrushPrimary}">
                                <controls:SectionPanel.PanelContent>
                                    <StackPanel>
                                        <Button Width="148" Margin="0,0,0,8" HorizontalAlignment="Left" Content="维护基础台账" />
                                        <Button Width="148" Margin="0,0,0,8" HorizontalAlignment="Left" Content="查看实时监视" />
                                        <Button Width="148" Margin="0,0,0,8" HorizontalAlignment="Left" Content="查看试验记录" />
                                        <Button Width="148" Margin="0,0,0,8" HorizontalAlignment="Left" Content="过程回放" />
                                        <Button Width="148" Margin="0,0,0,8" HorizontalAlignment="Left" Content="导出记录" />
                                        <Border Padding="10,8" Background="#F7F9FC">
                                            <StackPanel>
                                                <controls:DetailRow Label="目标路径" Value="1RHR" />
                                                <controls:DetailRow Label="时间范围" Value="近 30 天" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <controls:SectionPanel Grid.Column="0" Margin="0,0,10,0" Title="台账概况" StatusText="正常" StatusBrush="{StaticResource BrushOk}">
                                <controls:SectionPanel.PanelContent>
                                    <UniformGrid Columns="2" Rows="2">
                                        <controls:MetricCard Margin="0,0,8,8" Title="试验对象" Value="126" Unit="个" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                        <controls:MetricCard Margin="0,0,0,8" Title="测量装置" Value="4" Unit="台" AccentBrush="{StaticResource BrushOk}" CardBackground="#F7FFFB" />
                                        <controls:MetricCard Margin="0,0,8,0" Title="历史记录" Value="1850" Unit="条" AccentBrush="{StaticResource BrushPrimary}" CardBackground="#F7FAFF" />
                                        <controls:MetricCard Title="不合格" Value="9" Unit="条" AccentBrush="{StaticResource BrushDanger}" CardBackground="#FFF8F7" />
                                    </UniformGrid>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <controls:SectionPanel Grid.Column="1" Margin="0,0,10,0" Title="装置状态" StatusText="最近连接" StatusBrush="{StaticResource BrushWarn}">
                                <controls:SectionPanel.PanelContent>
                                    <StackPanel>
                                        <controls:DetailRow Label="DEV-001" Value="在线 12:18" ValueBrush="{StaticResource BrushOk}" />
                                        <controls:DetailRow Label="DEV-002" Value="在线 11:42" ValueBrush="{StaticResource BrushOk}" />
                                        <controls:DetailRow Label="DEV-003" Value="离线 昨日" ValueBrush="{StaticResource BrushDanger}" />
                                        <controls:DetailRow Label="DEV-004" Value="停用" ValueBrush="{StaticResource BrushWarn}" />
                                        <Separator Margin="0,8,0,8" />
                                        <controls:DetailRow Label="通信方式" Value="USB / RJ45 / RS232/485" />
                                    </StackPanel>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>

                            <controls:SectionPanel Grid.Column="2" Title="系统维护" StatusText="完整" StatusBrush="{StaticResource BrushOk}">
                                <controls:SectionPanel.PanelContent>
                                    <StackPanel>
                                        <controls:DetailRow Label="最近备份" Value="2026-05-26 02:00" />
                                        <controls:DetailRow Label="备份状态" Value="完整" ValueBrush="{StaticResource BrushOk}" />
                                        <controls:DetailRow Label="数据库" Value="SQL Server" />
                                        <controls:DetailRow Label="同步状态" Value="待配置" ValueBrush="{StaticResource BrushWarn}" />
                                        <Border Margin="0,12,0,0" Padding="10,7" Background="#F7F9FC">
                                            <controls:StatusDot Text="备份、迁移和日志在系统管理中维护" DotBrush="{StaticResource BrushPrimary}" />
                                        </Border>
                                    </StackPanel>
                                </controls:SectionPanel.PanelContent>
                            </controls:SectionPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <views:MasterDataView Visibility="{Binding MasterDataVisibility, ElementName=RootWindow}" />
                <views:RealtimeMonitorView Visibility="{Binding RealtimeMonitorVisibility, ElementName=RootWindow}" />
                <views:TestRecordsView Visibility="{Binding RecordsVisibility, ElementName=RootWindow}" />
                <views:StatisticsAnalysisView Visibility="{Binding AnalysisVisibility, ElementName=RootWindow}" />
                <views:SystemManagementView Visibility="{Binding SystemManagementVisibility, ElementName=RootWindow}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
